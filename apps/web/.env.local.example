# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local � it contains secrets.

# -- Authentication (required) --------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# -- AI � Groq (required for AI Copilot) ---------------------
# Get key at: https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# -- Kubernetes (last-resort fallback) ------------------------
# Primary source is data/clusters.json (isDefault cluster).
# Fallback order: request header ? clusters.json ? env var below
K8S_API_URL=http://127.0.0.1:8001
K8S_TIMEOUT_MS=15000

# -- Prometheus -----------------------------------------------
PROMETHEUS_URL=http://127.0.0.1:9090

# -- Alertmanager (via kubectl proxy) -------------------------
ALERTMANAGER_URL=http://127.0.0.1:8001/api/v1/namespaces/monitoring/services/monitoring-kube-prometheus-alertmanager:9093/proxy

# -- Loki (via kubectl proxy) ---------------------------------
LOKI_URL=http://127.0.0.1:8001/api/v1/namespaces/monitoring/services/loki:3100/proxy

# -- Jaeger ---------------------------------------------------
JAEGER_QUERY_URL=http://127.0.0.1:16686

# -- Grafana (via kubectl proxy) ------------------------------
GRAFANA_URL=http://127.0.0.1:8001/api/v1/namespaces/monitoring/services/monitoring-grafana:80/proxy

# -- Slack notifications (optional) ---------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# -- PagerDuty (optional) -------------------------------------
# PAGERDUTY_ROUTING_KEY=

# -- SMTP email alerts (optional) -----------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=VynOps <you@gmail.com>

# -- Dev server remote access (optional) ---------------------
# Set this when running npm run dev on a remote/cloud machine accessed by IP.
# Comma-separated IPs or hostnames. Leave unset for local development.
# ALLOWED_DEV_ORIGINS=your.server.ip

# -- Own public IP(s) for kubectl exec WebSocket rewrite ------
# When running on a cloud VM, set this to the server's public IP.
# Cluster URLs pointing at these IPs are rewritten to 127.0.0.1 so the
# exec WebSocket reaches kubectl proxy on loopback (avoids hairpin NAT).
# OWN_IPS=80.225.224.1
