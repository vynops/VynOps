          <h4 className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-2 flex items-center gap-1.5"><Cpu className="w-3 h-3" />Resource Requests / Limits</h4>
          <div className="grid grid-cols-2 gap-2">
