function ContainerDrawer({ container, pod, namespace, onClose, onExec, onLog }: {
  container: K8sContainer; pod: string; namespace: string; onClose: () => void; onExec: () => void; onLog: () => void
}) {
  const [showEnv, setShowEnv] = useState(false)
  const [metrics, setMetrics] = useState<K8sContainerMetrics | null>(null)
  const stateColor = container.state === 'running' ? 'text-success' : container.state === 'terminated' ? 'text-danger' : 'text-warning'

  useEffect(() => {
    fetch(`/api/k8s/pods/${encodeURIComponent(namespace)}/${encodeURIComponent(pod)}/metrics`, { headers: getClusterHeaders() })
      .then(r => r.json())
      .then(j => {
        const m = (j.metrics ?? []).find((m: K8sContainerMetrics) => m.container === container.name)
        if (m) setMetrics(m)
      })
      .catch(() => null)
  }, [namespace, pod, container.name])

  return (
    <div className="fixed inset-y-0 right-0 w-[500px] bg-surface-900 border-l border-surface-700 z-50 flex flex-col shadow-2xl">
