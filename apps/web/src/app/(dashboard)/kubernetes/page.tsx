                                  <div className="bg-surface-800/60 rounded-lg px-3 py-2 mt-1">
                                    <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-1">Live Usage</p>
                                    <div className="flex gap-4 text-2xs">
                                      {dsCpu !== '?' && <span className="text-surface-500">CPU <span className="font-mono text-amber-300">{dsCpu}</span></span>}
                                      {dsMem !== '?' && <span className="text-surface-500">Mem <span className="font-mono text-amber-300">{dsMem}</span></span>}
                                    </div>
                                  </div>
                                )}
                                {(ds.conditions ?? []).length > 0 && (
                                  <div className="space-y-1 pt-1">
                                    {(ds.conditions ?? []).map((c, i) => (
                                      <div key={i} className="flex items-center gap-2 text-2xs">
                                        <span className={cn('w-1.5 h-1.5 rounded-full', c.status === 'True' ? 'bg-success' : 'bg-warning')} />
                                        <span className="text-surface-300 font-semibold">{c.type}</span>
                                        {c.reason && <span className="text-surface-500">{c.reason}</span>}
                                      </div>
                                    ))}
                                  </div>
                                )}
                                {(loadingWEvents === dsEvKey || wloadEvents[dsEvKey] !== undefined) && (
                                  <div className="pt-1">
                                    <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-1">Warning Events</p>
                                    {loadingWEvents === dsEvKey
                                      ? <div className="text-2xs text-surface-500 animate-pulse">Loading?</div>
                                      : (dsEvts ?? []).length === 0
                                      ? <p className="text-2xs text-surface-600 italic">No warning events</p>
                                      : <div className="space-y-1">
                                          {(dsEvts ?? []).map((ev: any, ei: number) => (
                                            <div key={ei} className="bg-warning/5 border border-warning/15 rounded px-2 py-1.5 text-2xs space-y-0.5">
                                              <div className="flex items-center justify-between">
                                                <span className="font-semibold text-warning">{ev.reason}</span>
                                                <span className="text-surface-600">?{ev.count}</span>
                                              </div>
                                              <div className="text-surface-400 leading-relaxed line-clamp-2">{ev.message}</div>
                                            </div>
                                          ))}
                                        </div>
                                    }
                                  </div>
                                )}
                              </td>
                            </tr>
                          )}
                        </Fragment>
                      )
                    })}
                    {filteredDS.length === 0 && <tr><td colSpan={5} className="px-4 py-6 text-center text-surface-600 text-sm">None</td></tr>}
                  </tbody>
                </table>
                </div>
              </div>
            </div>

            {/* Jobs */}
            {workloadsData.jobs.length > 0 && (() => {
              const filteredJobs = (workloadsData.jobs as K8sJob[]).filter(j =>
                (!wNsFilter || j.namespace === wNsFilter) &&
                (!wSearch   || j.name.toLowerCase().includes(wSearch.toLowerCase()))
              )
              if (filteredJobs.length === 0) return null
              return (
              <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
                <div className="px-4 py-3 border-b border-surface-800">
                  <span className="text-sm font-semibold text-white">Jobs <span className="text-surface-500 font-normal text-2xs">({filteredJobs.length}{filteredJobs.length !== workloadsData.jobs.length ? `/${workloadsData.jobs.length}` : ''})</span></span>
                </div>
                <div className="overflow-x-auto">
                <table className="w-full text-sm">
                  <thead>
                    <tr className="border-b border-surface-800 bg-surface-950">
                      {['Name', 'Namespace', 'Status', 'Succeeded/Failed', 'Duration', ''].map(h => (
                        <th key={h} className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {filteredJobs.map((j: K8sJob) => {
                      const statusColor: Record<string, string> = {
                        Complete: 'bg-success/10 text-success border-success/20',
                        Failed:   'bg-danger/10 text-danger border-danger/20',
                        Running:  'bg-amber-500/10 text-amber-400 border-amber-500/20',
                      }
                      const durStr = j.durationSec != null
                        ? j.durationSec < 60 ? `${j.durationSec}s` : j.durationSec < 3600 ? `${Math.round(j.durationSec/60)}m` : `${Math.round(j.durationSec/3600)}h`
                        : '?'
                      const jKey = `${j.namespace}/${j.name}`
                      return (
                        <tr key={jKey} className="border-b border-surface-800/50 hover:bg-surface-800/40">
                          <td className="px-4 py-2.5 font-mono text-white text-xs">
                            {j.name}
                            {j.ownerName && <div className="text-2xs text-surface-500">from {j.ownerName}</div>}
                          </td>
                          <td className="px-4 py-2.5 text-surface-400 text-xs">{j.namespace}</td>
                          <td className="px-4 py-2.5">
                            <span className={cn('text-2xs px-2 py-0.5 rounded-full border font-semibold', statusColor[j.status] ?? statusColor.Running)}>{j.status}</span>
                          </td>
                          <td className="px-4 py-2.5 text-xs font-mono tabular-nums">
                            <span className="text-success">{j.succeeded}</span><span className="text-surface-600"> / </span><span className="text-danger">{j.failed}</span>
                            <span className="text-surface-500 ml-1">of {j.completions}</span>
                          </td>
                          <td className="px-4 py-2.5 text-xs text-surface-400 tabular-nums">{durStr}</td>
                          <td className="px-4 py-2.5" onClick={e => e.stopPropagation()}>
                            <div className="flex items-center gap-1">
                              <button onClick={() => {
                                const jobPod = allPods.find(p => p.name.startsWith(j.name + '-') && p.namespace === j.namespace)
                                setLogTarget({ pod: jobPod?.name ?? j.name, namespace: j.namespace })
                              }}
                                className="p-1.5 rounded-lg text-surface-600 hover:text-brand-400 hover:bg-brand-400/10 transition-all" title="Logs">
                                <ScrollText className="w-3.5 h-3.5" />
                              </button>
                              {(j.status === 'Complete' || j.status === 'Failed') && (
                                <button onClick={() => handleDeleteJob(j)} disabled={deletingJob === jKey}
                                  className="p-1.5 rounded-lg text-surface-600 hover:text-danger hover:bg-danger/10 transition-all disabled:opacity-40" title="Delete">
                                  <Trash2 className="w-3.5 h-3.5" />
                                </button>
                              )}
                            </div>
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
                </div>
              </div>
              )
            })()}

            {/* CronJobs */}
            {workloadsData.cronJobs.length > 0 && (() => {
              const filteredCronJobs = (workloadsData.cronJobs as K8sCronJob[]).filter(c =>
                (!wNsFilter || c.namespace === wNsFilter) &&
                (!wSearch   || c.name.toLowerCase().includes(wSearch.toLowerCase()))
              )
              if (filteredCronJobs.length === 0) return null
              return (
              <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
                <div className="px-4 py-3 border-b border-surface-800">
                  <span className="text-sm font-semibold text-white">CronJobs <span className="text-surface-500 font-normal text-2xs">({filteredCronJobs.length}{filteredCronJobs.length !== workloadsData.cronJobs.length ? `/${workloadsData.cronJobs.length}` : ''})</span></span>
                </div>
                <div className="overflow-x-auto">
                <table className="w-full text-sm">
                  <thead>
                    <tr className="border-b border-surface-800 bg-surface-950">
                      {['Name', 'Namespace', 'Schedule', 'Last Run', 'Active', 'Status', ''].map(h => (
                        <th key={h} className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {filteredCronJobs.map((c: K8sCronJob) => {
                      const lastRun = c.lastSchedule ? (() => {
                        const ago = Math.round((Date.now() - new Date(c.lastSchedule!).getTime()) / 60000)
                        return ago < 60 ? `${ago}m ago` : ago < 1440 ? `${Math.round(ago/60)}h ago` : `${Math.round(ago/1440)}d ago`
                      })() : 'Never'
                      const cronKey  = `${c.namespace}/${c.name}`
                      const isExpCron = expandedCron === cronKey
                      const createdAgo = (() => {
                        const ago = Math.round((Date.now() - new Date(c.createdAt).getTime()) / 86400000)
                        return ago === 0 ? 'today' : `${ago}d ago`
                      })()
                      return (
                        <Fragment key={cronKey}>
                          <tr onClick={() => setExpandedCron(isExpCron ? null : cronKey)} className="border-b border-surface-800/50 hover:bg-surface-800/40 cursor-pointer">
                            <td className="px-4 py-2.5 font-mono text-white text-xs">
                              <div className="flex items-center gap-1.5">
                                {isExpCron ? <ChevronDown className="w-3 h-3 text-surface-400 flex-shrink-0" /> : <ChevronRight className="w-3 h-3 text-surface-500 flex-shrink-0" />}
                                {c.name}
                              </div>
                            </td>
                            <td className="px-4 py-2.5 text-surface-400 text-xs">{c.namespace}</td>
                            <td className="px-4 py-2.5 font-mono text-surface-400 text-xs">{c.schedule}</td>
                            <td className="px-4 py-2.5 text-surface-500 text-xs">{lastRun}</td>
                            <td className="px-4 py-2.5 text-xs tabular-nums">
                              {c.active > 0
                                ? <span className="text-amber-400 font-semibold">{c.active}</span>
                                : <span className="text-surface-600">0</span>}
                            </td>
                            <td className="px-4 py-2.5">
                              <span className={cn('text-2xs px-2 py-0.5 rounded-full border font-semibold', c.suspended ? 'bg-surface-700/50 text-surface-500 border-surface-700' : 'bg-success/10 text-success border-success/20')}>
                                {c.suspended ? 'Suspended' : 'Active'}
                              </span>
                            </td>
                            <td className="px-4 py-2.5" onClick={e => e.stopPropagation()}>
                              <div className="flex items-center gap-1">
                                <button onClick={() => handleTriggerCron(c)} disabled={triggeringCron === cronKey || c.suspended}
                                  className="flex items-center gap-1 px-2 py-1 rounded-lg text-2xs font-semibold text-green-400 bg-green-500/10 hover:bg-green-500/20 border border-green-500/20 transition-all disabled:opacity-40" title="Trigger now">
                                  <Plus className="w-3 h-3" />{triggeringCron === cronKey ? 'Triggering?' : 'Run'}
                                </button>
                                <button onClick={() => handleSuspendCron(c, !c.suspended)} disabled={suspendingCron === cronKey}
                                  className={cn('flex items-center gap-1 px-2 py-1 rounded-lg text-2xs font-semibold border transition-all disabled:opacity-40',
                                    c.suspended ? 'text-success bg-success/10 hover:bg-success/20 border-success/20' : 'text-warning bg-warning/10 hover:bg-warning/20 border-warning/20')}
                                  title={c.suspended ? 'Resume' : 'Suspend'}>
                                  {c.suspended ? <>{'?'} Resume</> : <>{'?'} Suspend</>}
                                </button>
                              </div>
                            </td>
                          </tr>
                          {isExpCron && (
                            <tr className="bg-surface-950">
                              <td colSpan={7} className="px-6 py-3 border-b border-surface-700">
                                <div className="flex items-start gap-8 text-2xs">
                                  <div className="space-y-1.5">
                                    <div className="text-surface-500 uppercase tracking-wider font-semibold mb-1">Schedule</div>
                                    <div className="font-mono text-white bg-surface-800 px-2 py-1 rounded">{c.schedule}</div>
                                  </div>
                                  <div className="space-y-1.5">
                                    <div className="text-surface-500 uppercase tracking-wider font-semibold mb-1">Job Template</div>
                                    <div className="font-mono text-surface-300 truncate max-w-[200px]" title={c.image}>{c.image.split('/').pop()}</div>
                                  </div>
                                  <div className="space-y-1.5">
                                    <div className="text-surface-500 uppercase tracking-wider font-semibold mb-1">Concurrency</div>
                                    <span className={cn('px-2 py-0.5 rounded font-mono font-semibold',
                                      c.concurrencyPolicy === 'Forbid'  ? 'bg-warning/10 text-warning' :
                                      c.concurrencyPolicy === 'Replace' ? 'bg-danger/10 text-danger' :
                                      'bg-surface-800 text-surface-300')}>
                                      {c.concurrencyPolicy ?? 'Allow'}
                                    </span>
                                  </div>
                                  <div className="space-y-1.5">
                                    <div className="text-surface-500 uppercase tracking-wider font-semibold mb-1">Created</div>
                                    <div className="text-surface-400">{createdAgo}</div>
                                  </div>
                                  {c.active > 0 && (
                                    <div className="space-y-1.5">
                                      <div className="text-surface-500 uppercase tracking-wider font-semibold mb-1">Active Jobs</div>
                                      <span className="text-amber-400 font-semibold">{c.active} running</span>
                                    </div>
                                  )}
                                  <div className="ml-auto flex items-center gap-2">
                                    <button onClick={e => { e.stopPropagation(); setYamlTarget({ kind: 'CronJob', namespace: c.namespace, name: c.name }) }}
                                      className="flex items-center gap-1.5 px-3 py-1.5 text-2xs font-semibold text-surface-400 bg-surface-800 hover:bg-surface-700 rounded-lg border border-surface-700 transition-all">
                                      <FileCode2 className="w-3 h-3" /> YAML
                                    </button>
                                    <button onClick={e => { e.stopPropagation(); setDescribeTarget({ kind: 'CronJob', namespace: c.namespace, name: c.name }) }}
                                      className="flex items-center gap-1.5 px-3 py-1.5 text-2xs font-semibold text-amber-400 bg-amber-500/10 hover:bg-amber-500/20 rounded-lg border border-amber-500/20 transition-all">
                                      <FileSearch className="w-3 h-3" /> Describe
                                    </button>
                                  </div>
                                </div>
                              </td>
                            </tr>
                          )}
                        </Fragment>
                      )
                    })}
                  </tbody>
                </table>
                </div>
              </div>
              )
            })()}

            {/* PodDisruptionBudgets */}
            {workloadsData.pdbs.length > 0 && (() => {
              const filteredPDBs = (workloadsData.pdbs as K8sPDB[]).filter(p =>
                (!wNsFilter || p.namespace === wNsFilter) &&
                (!wSearch   || p.name.toLowerCase().includes(wSearch.toLowerCase()))
              )
              if (filteredPDBs.length === 0) return null
              return (
              <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
                <div className="px-4 py-3 border-b border-surface-800">
                  <span className="text-sm font-semibold text-white">Pod Disruption Budgets <span className="text-surface-500 font-normal text-2xs">({filteredPDBs.length}{filteredPDBs.length !== workloadsData.pdbs.length ? `/${workloadsData.pdbs.length}` : ''})</span></span>
                </div>
                <div className="overflow-x-auto">
                <table className="w-full text-sm">
                  <thead>
                    <tr className="border-b border-surface-800 bg-surface-950">
                      {['Name', 'Namespace', 'Min Avail / Max Unavail', 'Healthy / Expected', 'Disruptions Allowed'].map(h => (
                        <th key={h} className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {filteredPDBs.map((p: K8sPDB) => {
                      const ok = p.disruptionsAllowed > 0
                      return (
                        <tr key={`${p.namespace}/${p.name}`} className="border-b border-surface-800/50 hover:bg-surface-800/40">
                          <td className="px-4 py-2.5 font-mono text-white text-xs">{p.name}</td>
                          <td className="px-4 py-2.5 text-surface-400 text-xs">{p.namespace}</td>
                          <td className="px-4 py-2.5 text-xs font-mono text-surface-300">
                            {p.minAvailable != null ? <span>min: {p.minAvailable}</span> : null}
                            {p.maxUnavailable != null ? <span>max-unavail: {p.maxUnavailable}</span> : null}
                          </td>
                          <td className="px-4 py-2.5 text-xs tabular-nums">
                            <span className={p.currentHealthy >= p.desiredHealthy ? 'text-success font-semibold' : 'text-warning font-semibold'}>
                              {p.currentHealthy}
                            </span>
                            <span className="text-surface-600"> / {p.expectedPods}</span>
                          </td>
                          <td className="px-4 py-2.5">
                            <span className={cn('text-sm font-bold tabular-nums', ok ? 'text-success' : 'text-danger')}>{p.disruptionsAllowed}</span>
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
                </div>
              </div>
              )
            })()}

            {/* ConfigMaps */}
            {(() => {
              const filteredCMs = (workloadsData.configmaps as K8sConfigMap[]).filter(cm =>
                (!wNsFilter || cm.namespace === wNsFilter) &&
                (!wSearch   || cm.name.toLowerCase().includes(wSearch.toLowerCase()))
              )
              if (filteredCMs.length === 0) return null
              return (
            <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
              <div className="px-4 py-3 border-b border-surface-800">
                <span className="text-sm font-semibold text-white">ConfigMaps <span className="text-surface-500 font-normal text-2xs">({filteredCMs.length}{filteredCMs.length !== workloadsData.configmaps.length ? `/${workloadsData.configmaps.length}` : ''})</span></span>
              </div>
              <div className="overflow-x-auto overflow-y-auto max-h-[320px]">
                <table className="w-full text-sm">
                  <thead className="sticky top-0 z-10">
                    <tr className="border-b border-surface-800 bg-surface-950">
                      {['Name', 'Namespace', 'Keys', 'Age', ''].map(h => (
                        <th key={h} className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {filteredCMs.map((cm: K8sConfigMap) => {
                      const ago = Math.round((Date.now() - new Date(cm.createdAt).getTime()) / 60000)
                      const ageStr = ago < 60 ? `${ago}m` : ago < 1440 ? `${Math.round(ago/60)}h` : `${Math.round(ago/1440)}d`
                      return (
                        <tr key={`${cm.namespace}/${cm.name}`} className="border-b border-surface-800/50 hover:bg-surface-800/40">
                          <td className="px-4 py-2.5 font-mono text-white text-xs">{cm.name}</td>
                          <td className="px-4 py-2.5 text-surface-400 text-xs">{cm.namespace}</td>
                          <td className="px-4 py-2.5 text-surface-400 text-xs tabular-nums">{cm.keys}</td>
                          <td className="px-4 py-2.5 text-surface-600 text-xs">{ageStr}</td>
                          <td className="px-4 py-2.5" onClick={e => e.stopPropagation()}>
                            <div className="flex items-center gap-1">
                              <button onClick={() => setDescribeTarget({ kind: 'ConfigMap', namespace: cm.namespace, name: cm.name })} className="p-1.5 rounded-lg text-surface-600 hover:text-amber-400 hover:bg-amber-400/10 transition-all" title="Describe"><FileSearch className="w-3.5 h-3.5" /></button>
                              <button onClick={() => setYamlTarget({ kind: 'ConfigMap', namespace: cm.namespace, name: cm.name })} className="p-1.5 rounded-lg text-surface-600 hover:text-brand-400 hover:bg-brand-400/10 transition-all" title="YAML"><FileCode2 className="w-3.5 h-3.5" /></button>
                            </div>
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
              </div>
            </div>
              )
            })()}

          </div>
        )}

        {/* -- SERVICES TAB -- */}
        {tab === 'Services' && (() => {
          const svcNamespaces = Array.from(new Set((networkData.services as K8sService[]).map(s => s.namespace))).sort()
          const lbCount     = (networkData.services as K8sService[]).filter(s => s.type === 'LoadBalancer').length
          const zeroEpCount = (networkData.services as K8sService[]).filter(s => s.readyEndpoints === 0 && s.type !== 'ExternalName').length
          const expiredCerts  = (tlsCertsData.certs as TlsCert[]).filter(c => c.isExpired).length
          const expiringSoon  = (tlsCertsData.certs as TlsCert[]).filter(c => c.isExpiringSoon && !c.isExpired).length
          return (
          <div className="space-y-4">
          {/* KPI strip */}
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {[
              { label: 'Services', value: (networkData.services as K8sService[]).length, sub: `${lbCount} LoadBalancer${lbCount !== 1 ? 's' : ''}`, color: 'text-brand-400', ok: true },
              { label: 'Ingresses', value: (ingressData.ingresses as K8sIngress[]).length, sub: `${(ingressData.ingresses as K8sIngress[]).filter(i => (i.tls ?? []).length > 0).length} with TLS`, color: 'text-purple-400', ok: true },
              { label: '0-Endpoint Svcs', value: zeroEpCount, sub: zeroEpCount === 0 ? 'all healthy' : 'no ready pods', color: zeroEpCount > 0 ? 'text-warning' : 'text-success', ok: zeroEpCount === 0 },
              { label: 'TLS Certs', value: (tlsCertsData.certs as TlsCert[]).length, sub: expiredCerts > 0 ? `${expiredCerts} expired` : expiringSoon > 0 ? `${expiringSoon} expiring soon` : 'all valid', color: expiredCerts > 0 ? 'text-danger' : expiringSoon > 0 ? 'text-warning' : 'text-success', ok: expiredCerts === 0 && expiringSoon === 0 },
            ].map(k => (
              <div key={k.label} className="rounded-xl bg-surface-900 border border-surface-800 px-4 py-3">
                <div className="text-2xs text-surface-500 font-semibold uppercase tracking-wider mb-1">{k.label}</div>
                <div className={`text-2xl font-bold tabular-nums ${k.color}`}>{k.value}</div>
                <div className="text-2xs text-surface-500 mt-0.5">{k.sub}</div>
              </div>
            ))}
          </div>
          <div className="rounded-xl border border-surface-800 bg-surface-900 overflow-hidden">
            <div className="px-4 py-3 border-b border-surface-800 space-y-2">
              <div className="flex items-center justify-between">
                <span className="text-sm font-semibold text-white flex items-center gap-2">
                  <Network className="w-4 h-4 text-brand-400" /> Services
                  <span className="text-2xs text-surface-500 font-normal">({filteredSvcs.length}{svcSearch || svcTypeFilter || svcNsFilter ? `/${(networkData.services as K8sService[]).length}` : ''})</span>
                </span>
                <button onClick={() => exportCSV(filteredSvcs.map(s => ({ name: s.name, namespace: s.namespace, type: s.type, clusterIP: s.clusterIP, externalIP: s.externalIP ?? '', ports: s.ports, endpoints: s.readyEndpoints, age: s.createdAt })), 'services.csv')}
                  className="flex items-center gap-1 px-2 py-0.5 rounded-md text-2xs font-semibold border bg-surface-800 text-surface-500 border-surface-700 hover:border-surface-600">
                  <Download className="w-3 h-3" /> CSV
                </button>
              </div>
              <div className="flex flex-wrap items-center gap-2">
                <div className="relative flex-1 min-w-[160px] max-w-xs">
                  <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-surface-500" />
                  <input value={svcSearch} onChange={e => setSvcSearch(e.target.value)} placeholder="Search name?"
                    className="w-full bg-surface-800 border border-surface-700 rounded-lg pl-8 pr-3 py-1.5 text-2xs text-white placeholder-surface-500 focus:outline-none focus:border-brand-500" />
                </div>
                <select value={svcNsFilter ?? ''} onChange={e => setSvcNsFilter(e.target.value || null)}
                  className="bg-surface-800 border border-surface-700 rounded-lg px-2 py-1.5 text-2xs text-surface-300 focus:outline-none focus:border-brand-500">
                  <option value="">All namespaces</option>
                  {svcNamespaces.map(ns => <option key={ns} value={ns}>{ns}</option>)}
                </select>
                {(['LoadBalancer','NodePort','ClusterIP','ExternalName'] as const).map(t => (
                  <button key={t} onClick={() => setSvcTypeFilter(svcTypeFilter === t ? null : t)}
                    className={cn('text-2xs px-2.5 py-1 rounded-lg border font-semibold transition-colors',
                      svcTypeFilter === t ? 'bg-brand-500/20 text-brand-400 border-brand-500/30' : 'text-surface-500 border-surface-700 hover:border-surface-600'
                    )}>{t}</button>
                ))}
              </div>
            </div>
            <div className="overflow-x-auto">
              <table className="w-full text-sm">
                <thead>
                  <tr className="border-b border-surface-800 bg-surface-950">
                    {([  
                      ['name',      'Name'],
                      ['namespace', 'Namespace'],
                      ['type',      'Type'],
                      [null,        'Cluster IP'],
                      [null,        'External IP'],
                      [null,        'Ports'],
                      ['endpoints', 'Endpoints'],
                      ['age',       'Age'],
                      [null,        'Selector'],
                      [null,        ''],
                    ] as [string|null, string][]).map(([col, label]) => (
                      <th key={label} onClick={col ? () => { setSvcSortCol(col as typeof svcSortCol); setSvcSortDir(d => svcSortCol === col ? (d === 'asc' ? 'desc' : 'asc') : 'asc') } : undefined}
                        className={cn('px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider select-none',
                          col ? 'cursor-pointer hover:text-surface-300' : ''
                        )}>
                        <span className="flex items-center gap-1">
                          {label}
                          {col && svcSortCol === col && (
                            <span className="opacity-60">{svcSortDir === 'asc' ? '?' : '?'}</span>
                          )}
                        </span>
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {filteredSvcs.map((svc: K8sService) => {
                    const svcKey = `${svc.namespace}/${svc.name}`
                    const isExpanded = expandedSvc === svcKey
                    const ep = svcEndpoints[svcKey]
                    const typeColor: Record<string, string> = {
                      LoadBalancer: 'bg-brand-500/10 text-brand-400 border-brand-500/20',
                      NodePort: 'bg-purple-500/10 text-purple-400 border-purple-500/20',
                      ClusterIP: 'bg-surface-700/50 text-surface-400 border-surface-700',
                      ExternalName: 'bg-warning/10 text-warning border-warning/20',
                    }
                    return (
                      <Fragment key={svcKey}>
                        <tr className="border-b border-surface-800/50 hover:bg-surface-800/40 cursor-pointer" onClick={() => setExpandedSvc(isExpanded ? null : svcKey)}>
                          <td className="px-4 py-2.5 font-mono text-white text-xs">{svc.name}</td>
                          <td className="px-4 py-2.5 text-surface-400 text-xs">{svc.namespace}</td>
                          <td className="px-4 py-2.5">
                            <span className={cn('text-2xs px-2 py-0.5 rounded-full border font-semibold', typeColor[svc.type] ?? typeColor.ClusterIP)}>
                              {svc.type}
                            </span>
                          </td>
                          <td className="px-4 py-2.5 font-mono text-xs">
                            {svc.clusterIP === 'None'
                              ? <span className="text-2xs px-1.5 py-0.5 rounded border bg-surface-700/40 text-surface-400 border-surface-600 font-semibold">Headless</span>
                              : <span className="text-surface-300">{svc.clusterIP}</span>}
                          </td>
                          <td className="px-4 py-2.5 font-mono text-brand-400 text-xs">
                            {(svc as any).externalIPs?.length > 0
                              ? <div className="flex flex-col gap-0.5">{((svc as any).externalIPs as string[]).map((ip, i) => <span key={i}>{ip}</span>)}</div>
                              : svc.externalIP
                              ? <span>{svc.externalIP}</span>
                              : <span className="text-surface-600">-</span>}
                          </td>
                          <td className="px-4 py-2.5 font-mono text-surface-300 text-xs max-w-[180px] truncate" title={svc.ports}>{svc.ports || <span className="text-surface-600">-</span>}</td>
                          <td className="px-4 py-2.5 text-center">
                            <button
                              onClick={e => { e.stopPropagation(); setExpandedSvc(isExpanded ? null : svcKey) }}
                              className={cn('text-xs font-semibold tabular-nums px-2 py-0.5 rounded-full border transition-colors',
                                svc.readyEndpoints > 0
                                  ? 'text-success bg-success/5 border-success/20 hover:bg-success/15'
                                  : 'text-surface-600 bg-surface-800 border-surface-700 hover:bg-surface-700'
                              )}
                              title="View endpoint IPs"
                            >{svc.readyEndpoints}</button>
                          </td>
                          <td className="px-4 py-2.5 text-surface-500 text-2xs font-mono max-w-[180px] truncate" title={svc.selector ?? ''}>{svc.selector ?? <span className="text-surface-600">-</span>}</td>
                          <td className="px-4 py-2.5 text-surface-500 text-xs tabular-nums">{(() => { const ago = Math.round((Date.now() - new Date(svc.createdAt).getTime()) / 86400000); return ago === 0 ? '<1d' : `${ago}d` })()}</td>
                          <td className="px-4 py-2.5" onClick={e => e.stopPropagation()}>
                            <div className="flex items-center gap-1">
                              <button onClick={() => setDescribeTarget({ kind: 'Service', namespace: svc.namespace, name: svc.name })} className="p-1.5 rounded-lg text-surface-600 hover:text-amber-400 hover:bg-amber-400/10 transition-all" title="Describe"><FileSearch className="w-3.5 h-3.5" /></button>
                              <button onClick={() => setYamlTarget({ kind: 'Service', namespace: svc.namespace, name: svc.name })} className="p-1.5 rounded-lg text-surface-600 hover:text-brand-400 hover:bg-brand-400/10 transition-all" title="YAML"><FileCode2 className="w-3.5 h-3.5" /></button>
                            </div>
                          </td>
                        </tr>
                        {isExpanded && (
                          <tr className="bg-surface-950/60">
                            <td colSpan={10} className="px-6 py-3 border-b border-surface-800/50">
                              {/* Service metadata strip */}
                              <div className="flex flex-wrap gap-x-5 gap-y-1 mb-3 pb-2.5 border-b border-surface-800/50 text-2xs">
                                <span className="text-surface-500">DNS <span className="font-mono text-surface-300">{svc.name}.{svc.namespace}.svc.cluster.local</span></span>
                                {svc.sessionAffinity && svc.sessionAffinity !== 'None' && (
                                  <span className="text-surface-500">Session Affinity <span className="font-mono text-amber-300">{svc.sessionAffinity}</span></span>
                                )}
                                {svc.externalTrafficPolicy && svc.type !== 'ClusterIP' && (
                                  <span className="text-surface-500">Traffic Policy <span className={cn('font-mono', svc.externalTrafficPolicy === 'Local' ? 'text-success' : 'text-surface-300')}>{svc.externalTrafficPolicy}</span></span>
                                )}
                                {(svc.portDetails ?? []).length > 0 && (
                                  <span className="text-surface-500">Port Map{' '}
                                    {svc.portDetails.map((p, i) => (
                                      <span key={i} className="font-mono text-surface-300 ml-1">{p.name ? `${p.name}:` : ''}{p.port}?{p.targetPort}{p.protocol !== 'TCP' ? `/${p.protocol}` : ''}{p.nodePort ? ` (NodePort:${p.nodePort})` : ''}</span>
                                    ))}
                                  </span>
                                )}
                              </div>
                              {loadingSvcEp === svcKey
                                ? <div className="text-2xs text-surface-500 animate-pulse py-1">Loading endpoints?</div>
                                : ep
                                  ? (
                                    <div className="space-y-2">
                                      <div className="flex items-center gap-3 mb-2">
                                        <span className="text-2xs font-semibold text-surface-400 uppercase tracking-wider">Endpoint Addresses</span>
                                        {ep.ports.length > 0 && <span className="text-2xs font-mono text-surface-600">ports: {ep.ports.join(' ? ')}</span>}
                                        <span className={cn('text-2xs font-semibold px-2 py-0.5 rounded-full border ml-auto',
                                          ep.notReady.length > 0 ? 'text-warning bg-warning/5 border-warning/20' : 'text-success bg-success/5 border-success/20'
                                        )}>{ep.ready.length} ready{ep.notReady.length > 0 ? ` ? ${ep.notReady.length} not ready` : ''}</span>
                                      </div>
                                      <div className="grid grid-cols-2 gap-4">
                                        <div>
                                          <div className="text-2xs font-semibold text-success mb-1.5 flex items-center gap-1">
                                            <span className="w-1.5 h-1.5 rounded-full bg-success inline-block" /> Ready ({ep.ready.length})
                                          </div>
                                          {ep.ready.length === 0
                                            ? <div className="text-2xs text-surface-600 italic">none</div>
                                            : <div className="space-y-1 max-h-[120px] overflow-y-auto">
                                                {ep.ready.map((a: any, i: number) => (
                                                  <div key={i} className="flex items-center gap-2 text-2xs font-mono bg-surface-900 rounded px-2 py-1">
                                                    <span className="text-surface-200">{a.ip}</span>
                                                    {a.pod && <span className="text-brand-400 truncate max-w-[150px]">{a.pod}</span>}
                                                    {a.node && <span className="text-surface-600 ml-auto flex-shrink-0">{a.node}</span>}
                                                  </div>
                                                ))}
                                              </div>
                                          }
                                        </div>
                                        <div>
                                          <div className="text-2xs font-semibold text-danger mb-1.5 flex items-center gap-1">
                                            <span className="w-1.5 h-1.5 rounded-full bg-danger inline-block" /> Not Ready ({ep.notReady.length})
                                          </div>
                                          {ep.notReady.length === 0
                                            ? <div className="text-2xs text-surface-600 italic">none</div>
                                            : <div className="space-y-1 max-h-[120px] overflow-y-auto">
                                                {ep.notReady.map((a: any, i: number) => (
                                                  <div key={i} className="flex items-center gap-2 text-2xs font-mono bg-surface-900 rounded px-2 py-1">
                                                    <span className="text-surface-200">{a.ip}</span>
                                                    {a.pod && <span className="text-danger/80 truncate max-w-[150px]">{a.pod}</span>}
                                                    {a.node && <span className="text-surface-600 ml-auto flex-shrink-0">{a.node}</span>}
                                                  </div>
                                                ))}
                                              </div>
                                          }
                                        </div>
                                      </div>
                                    </div>
                                  )
                                  : <div className="text-2xs text-surface-600 py-1">No endpoint data</div>
                              }
                            </td>
                          </tr>
                        )}
                      </Fragment>
                    )
                  })}
                  {filteredSvcs.length === 0 && (
                    <tr><td colSpan={10} className="px-4 py-8 text-center text-surface-600 text-sm">{svcSearch || svcTypeFilter || svcNsFilter ? 'No services match the filter' : 'No services found'}</td></tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>

          {/* Ingress */}
          <div className="rounded-xl border border-surface-800 bg-surface-900 overflow-hidden">
            <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2">
              <Globe className="w-4 h-4 text-brand-400" />
              <span className="text-sm font-semibold text-white">Ingress</span>
              <span className="text-2xs text-surface-500 ml-1">({filteredIngresses.length}{ingSearch ? `/${(ingressData.ingresses as K8sIngress[]).length}` : ''})</span>
              <div className="ml-auto flex items-center gap-2">
                <button onClick={() => exportCSV((filteredIngresses as K8sIngress[]).map(i => ({ name: i.name, namespace: i.namespace, class: i.className ?? '', hosts: i.rules?.map((r: any) => r.host).filter(Boolean).join(';') ?? '', tls: (i.tls ?? []).length > 0 ? 'yes' : 'no', rules: (i.rules ?? []).length, lbIP: (i.loadBalancerIPs ?? []).join(';') })), 'ingresses.csv')}
                  className="flex items-center gap-1 px-2 py-0.5 rounded-md text-2xs font-semibold border bg-surface-800 text-surface-500 border-surface-700 hover:border-surface-600">
                  <Download className="w-3 h-3" /> CSV
                </button>
                <div className="relative w-48">
                  <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-surface-500" />
                  <input value={ingSearch} onChange={e => setIngSearch(e.target.value)} placeholder="Search host / name?"
                    className="w-full bg-surface-800 border border-surface-700 rounded-lg pl-8 pr-3 py-1.5 text-2xs text-white placeholder-surface-500 focus:outline-none focus:border-brand-500" />
                </div>
              </div>
            </div>
            <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="border-b border-surface-800 bg-surface-950">
                  {['Name', 'Namespace', 'Class', 'Hosts', 'TLS', 'Rules', 'Load Balancer IP', ''].map(h => (
                    <th key={h} className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {filteredIngresses.map((ing: K8sIngress) => {
                  const ingKey = `${ing.namespace}/${ing.name}`
                  const isExpanded = expandedIng === ingKey
                  const im = ingMetrics[ingKey]
                  // Find matching TLS cert expiry from tlsCertsData
                  const tlsSecretNames = (ing.tls ?? []).map((t: any) => t.secretName)
                  const tlsCertExpiry = tlsCertsData.certs.find((c: TlsCert) =>
                    tlsSecretNames.includes(c.name) && c.namespace === ing.namespace
                  )
                  return (
                    <Fragment key={ingKey}>
                      <tr
                        className="border-b border-surface-800/50 hover:bg-surface-800/40 cursor-pointer"
                        onClick={() => setExpandedIng(isExpanded ? null : ingKey)}
                      >
                        <td className="px-4 py-2.5 font-mono text-white text-xs">{ing.name}</td>
                        <td className="px-4 py-2.5 text-surface-400 text-xs">{ing.namespace}</td>
                        <td className="px-4 py-2.5 font-mono text-surface-400 text-xs">{ing.className ?? <span className="text-surface-600">-</span>}</td>
                        <td className="px-4 py-2.5 text-surface-300 text-xs max-w-[160px]">
                          <div className="flex flex-wrap gap-1">
                            {(ing.rules?.map((r: any) => r.host).filter(Boolean) ?? []).slice(0, 3).map((h: string, i: number) => (
                              <a key={i} href={`https://${h}`} target="_blank" rel="noopener noreferrer"
                                onClick={e => e.stopPropagation()}
                                className="bg-surface-800 font-mono text-2xs px-1.5 py-0.5 rounded hover:bg-brand-500/10 hover:text-brand-300 transition-colors">{h}</a>
                            ))}
                            {(ing.rules?.map((r: any) => r.host).filter(Boolean) ?? []).length > 3 && (
                              <span className="text-2xs text-surface-600">+{(ing.rules?.map((r: any) => r.host).filter(Boolean) ?? []).length - 3}</span>
                            )}
                          </div>
                        </td>
                        <td className="px-4 py-2.5">
                          {(ing.tls ?? []).length > 0 ? (
                            <div className="flex items-center gap-1.5">
                              <Lock className="w-3 h-3 text-success" />
                              {tlsCertExpiry ? (
                                <span className={cn('text-2xs font-semibold',
                                  tlsCertExpiry.isExpired ? 'text-danger' :
                                  tlsCertExpiry.isExpiringSoon ? 'text-warning' : 'text-success'
                                )}>
                                  {tlsCertExpiry.isExpired ? 'Expired' : `${tlsCertExpiry.daysRemaining}d`}
                                </span>
                              ) : (
                                <span className="text-2xs text-success font-semibold">TLS</span>
                              )}
                            </div>
                          ) : (
                            <span className="text-surface-600 text-2xs">none</span>
                          )}
                        </td>
                        <td className="px-4 py-2.5 text-surface-400 text-xs tabular-nums">{(ing.rules ?? []).length}</td>
                        <td className="px-4 py-2.5 font-mono text-brand-400 text-xs">{(ing.loadBalancerIPs ?? []).join(', ') || <span className="text-surface-600">pending</span>}</td>
                        <td className="px-4 py-2.5" onClick={e => e.stopPropagation()}>
                          <div className="flex items-center gap-1">
                            <button onClick={() => setDescribeTarget({ kind: 'Ingress', namespace: ing.namespace, name: ing.name })} className="p-1.5 rounded-lg text-surface-600 hover:text-amber-400 hover:bg-amber-400/10 transition-all" title="Describe"><FileSearch className="w-3.5 h-3.5" /></button>
                            <button onClick={() => setYamlTarget({ kind: 'Ingress', namespace: ing.namespace, name: ing.name })} className="p-1.5 rounded-lg text-surface-600 hover:text-brand-400 hover:bg-brand-400/10 transition-all" title="YAML"><FileCode2 className="w-3.5 h-3.5" /></button>
                          </div>
                        </td>
                      </tr>
                      {isExpanded && (
                        <tr className="bg-surface-950/60">
                          <td colSpan={8} className="px-6 py-4 border-b border-surface-800/50">
                            <div className="grid grid-cols-2 gap-6">
                              {/* Traffic metrics */}
                              <div>
                                <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                                  <Activity className="w-3 h-3 text-brand-400" /> Traffic Metrics (5m rate)
                                </p>
                                {loadingIngMetrics === ingKey ? (
                                  <div className="text-2xs text-surface-500 animate-pulse">Querying Prometheus?</div>
                                ) : im?.metrics ? (
                                  <div className="grid grid-cols-3 gap-2">
                                    {[
                                      ['Req/s', im.metrics.reqPerSec.toFixed(2)],
                                      ['Error %', `${im.metrics.errorRate.toFixed(1)}%`],
                                      ['P95 Latency', `${im.metrics.p95LatencyMs}ms`],
                                    ].map(([label, val]) => (
                                      <div key={label} className="bg-surface-900 rounded-lg px-3 py-2">
                                        <div className="text-2xs text-surface-500 mb-0.5">{label}</div>
                                        <div className="text-sm font-semibold font-mono text-surface-200">{val}</div>
                                      </div>
                                    ))}
                                    <div className="col-span-3 text-2xs text-surface-600 mt-1">via {im.metrics.controller}</div>
                                  </div>
                                ) : (
                                  <div className="text-2xs text-surface-600 italic">
                                    {im?.hasController
                                      ? `${im.controllerType ?? 'Ingress'} controller detected ? request metrics unavailable (v1.12+ uses OTel instead of Prometheus)`
                                      : 'No ingress controller metrics available (nginx/traefik not detected)'}
                                  </div>
                                )}
                              </div>
                              {/* Rules */}
                              <div>
                                <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-2">Routing Rules</p>
                                <div className="space-y-1.5">
                                {(ing.rules ?? []).map((rule: any, ri: number) => (
                                    <div key={ri} className="bg-surface-900 rounded-lg px-3 py-2">
                                      <div className="text-2xs font-mono text-brand-300 mb-1">{rule.host ?? '*'}</div>
                                      {(rule.paths ?? []).map((p: any, pi: number) => {
                                        const backendSvc = networkData.services.find((s: K8sService) => s.namespace === ing.namespace && s.name === p.serviceName)
                                        const backendOk = backendSvc ? backendSvc.readyEndpoints > 0 : null
                                        return (
                                          <div key={pi} className="text-2xs font-mono ml-2 flex items-center gap-1.5">
                                            <span className="text-surface-500">{p.path} ? {p.serviceName}:{p.servicePort}</span>
                                            {backendOk === true  && <span className="w-1.5 h-1.5 rounded-full bg-success inline-block flex-shrink-0" title={`${backendSvc?.readyEndpoints} ready`} />}
                                            {backendOk === false && <span className="w-1.5 h-1.5 rounded-full bg-danger  inline-block flex-shrink-0" title="0 ready endpoints" />}
                                          </div>
                                        )
                                      })}
                                    </div>
                                  ))}
                                  {(ing.rules ?? []).length === 0 && <div className="text-2xs text-surface-600 italic">No rules defined</div>}
                                </div>
                              </div>
                            </div>
                            {/* Annotations */}
                            {Object.keys(ing.annotations ?? {}).length > 0 && (
                              <div className="mt-4 pt-3 border-t border-surface-800/50">
                                <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-2">Annotations</p>
                                <div className="grid grid-cols-1 gap-1 max-h-[140px] overflow-y-auto">
                                  {Object.entries(ing.annotations ?? {}).map(([k, v]) => (
                                    <div key={k} className="flex items-start gap-2 text-2xs font-mono bg-surface-900 rounded px-2 py-1">
                                      <span className={cn('flex-shrink-0', k.includes('nginx') ? 'text-brand-400' : k.includes('cert-manager') ? 'text-success' : 'text-surface-500')}>{k}</span>
                                      <span className="text-surface-300 break-all">{v}</span>
                                    </div>
                                  ))}
                                </div>
                              </div>
                            )}
                          </td>
                        </tr>
                      )}
                    </Fragment>
                  )
                })}
                {filteredIngresses.length === 0 && (
                  <tr><td colSpan={8} className="px-4 py-6 text-center text-surface-600 text-sm">{ingSearch ? 'No ingresses match the filter' : 'No ingresses found'}</td></tr>
                )}
              </tbody>
            </table>
            </div>
          </div>

          {/* TLS Certificates */}
          {(() => {
            let filteredCerts = (tlsCertsData.certs as TlsCert[])
              .filter(c => !certSearch || c.name.toLowerCase().includes(certSearch.toLowerCase()) ||
                c.subject.toLowerCase().includes(certSearch.toLowerCase()) ||
                c.dnsNames.some(d => d.toLowerCase().includes(certSearch.toLowerCase())))
            filteredCerts = [...filteredCerts].sort((a, b) =>
              certSortDir === 'asc' ? a.daysRemaining - b.daysRemaining : b.daysRemaining - a.daysRemaining
            )
            return (
          <div className="rounded-xl border border-surface-800 bg-surface-900 overflow-hidden">
            <div className="px-4 py-3 border-b border-surface-800">
              <div className="flex items-center gap-2 mb-2">
                <Lock className="w-4 h-4 text-success" />
                <span className="text-sm font-semibold text-white">TLS Certificates</span>
                <span className="text-2xs text-surface-500 ml-1">({filteredCerts.length}{certSearch ? `/${tlsCertsData.certs.length}` : ''})</span>
                {tlsCertsData.certs.some((c: TlsCert) => c.isExpired) && (
                  <span className="ml-auto text-2xs px-2 py-0.5 rounded-full bg-danger/10 text-danger border border-danger/20 font-semibold">
                    {tlsCertsData.certs.filter((c: TlsCert) => c.isExpired).length} Expired
                  </span>
                )}
                {tlsCertsData.certs.some((c: TlsCert) => c.isExpiringSoon && !c.isExpired) && (
                  <span className={cn('text-2xs px-2 py-0.5 rounded-full bg-warning/10 text-warning border border-warning/20 font-semibold',
                    tlsCertsData.certs.some((c: TlsCert) => c.isExpired) ? '' : 'ml-auto'
                  )}>
                    {tlsCertsData.certs.filter((c: TlsCert) => c.isExpiringSoon && !c.isExpired).length} Expiring soon
                  </span>
                )}
              </div>
              <div className="flex items-center gap-2">
                <div className="relative flex-1 max-w-xs">
                  <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-surface-500" />
                  <input value={certSearch} onChange={e => setCertSearch(e.target.value)} placeholder="Search name / domain?"
                    className="w-full bg-surface-800 border border-surface-700 rounded-lg pl-8 pr-3 py-1.5 text-2xs text-white placeholder-surface-500 focus:outline-none focus:border-brand-500" />
                </div>
                <button onClick={() => setCertSortDir(d => d === 'asc' ? 'desc' : 'asc')}
                  className="flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-2xs font-semibold border bg-surface-800 text-surface-500 border-surface-700 hover:border-surface-600">
                  Expiry {certSortDir === 'asc' ? '?' : '?'}
                </button>
