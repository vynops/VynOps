                                          {(['enforce', 'warn', 'audit'] as const).map(mode => {
                                            const val = ns.labels?.[`pod-security.kubernetes.io/${mode}`]
                                            if (!val) return null
                                            const col = mode === 'enforce' ? 'text-success' : mode === 'warn' ? 'text-warning' : 'text-brand-400'
                                            return <div key={mode}><span className={cn('w-14 inline-block font-semibold', col)}>{mode}</span><span className="text-surface-300">{val}</span></div>
                                          })}
                                        </div>
                                      </div>
                                    )}
                                    {(hasQuota || hasLR || hasNP) && (
                                      <div>
                                        <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-2">Governance</p>
                                        <div className="space-y-0.5 text-2xs">
                                          {hasQuota && <div><span className="text-success">?</span> <span className="text-surface-400">ResourceQuota</span></div>}
                                          {hasLR && <div><span className="text-brand-400">?</span> <span className="text-surface-400">LimitRange</span>{(limitRangeCompliance[nsKey] ?? 0) > 0 && <span className="text-warning ml-1">? {limitRangeCompliance[nsKey]} BestEffort pods</span>}</div>}
                                          {hasNP && <div><span className="text-purple-400">?</span> <span className="text-surface-400">NetworkPolicy</span></div>}
                                        </div>
                                      </div>
                                    )}
                                  </div>
                                  {/* Pods */}
                                  <div>
                                    <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-2">
                                      Pods {nsPods.length > 0 && <span className="normal-case font-normal text-surface-500">({sum.podRunning}/{sum.podTotal} running)</span>}
                                    </p>
                                    {nsPods.length === 0
                                      ? <span className="text-surface-600 text-2xs">no pods</span>
                                      : <div className="space-y-0.5">
                                          {nsPods.slice(0, 9).map((pod: any) => (
                                            <div key={pod.name} className="flex items-center gap-2 group">
                                              <span className={cn('w-1.5 h-1.5 rounded-full flex-shrink-0',
                                                pod.status === 'Running' ? 'bg-success' : pod.status === 'Pending' ? 'bg-warning animate-pulse' : 'bg-danger'
                                              )} />
                                              <span className="font-mono text-2xs text-surface-300 truncate max-w-[160px]">{pod.name}</span>
                                              {pod.status !== 'Running' && <span className="text-2xs text-warning flex-shrink-0">{pod.status}</span>}
                                              <button
                                                onClick={e => { e.stopPropagation(); setLogTarget({ pod: pod.name, namespace: nsKey }) }}
                                                className="ml-auto p-0.5 rounded text-surface-700 hover:text-brand-400 hover:bg-brand-400/10 opacity-0 group-hover:opacity-100 transition-all flex-shrink-0"
                                                title="View logs">
                                                <ScrollText className="w-3 h-3" />
                                              </button>
                                            </div>
                                          ))}
                                          {nsPods.length > 9 && <div className="text-2xs text-surface-600 mt-1">+{nsPods.length - 9} more</div>}
                                        </div>
                                    }
                                  </div>
                                  {/* Workloads + Services */}
                                  <div>
                                    <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-2">Workloads &amp; Services</p>
                                    {nsWorkloads.length === 0 && nsSvcs.length === 0
                                      ? <span className="text-surface-600 text-2xs">none</span>
                                      : <div className="space-y-0.5">
                                          {nsWorkloads.map((w, wi) => (
                                            <div key={wi} className="flex items-center gap-2">
                                              <span className="text-2xs text-surface-600 w-20 flex-shrink-0">{w.kind.replace('Deployment', 'Deploy').replace('StatefulSet', 'STS').replace('DaemonSet', 'DS')}</span>
                                              <span className="font-mono text-2xs text-surface-300 truncate">{w.name}</span>
                                              <span className="text-2xs text-surface-500 ml-auto tabular-nums flex-shrink-0">{w.ready}</span>
                                            </div>
                                          ))}
                                          {nsWorkloads.length > 0 && nsSvcs.length > 0 && <div className="border-t border-surface-800 my-1.5" />}
                                          {nsSvcs.slice(0, 6).map((svc: K8sService) => (
                                            <div key={svc.name} className="flex items-center gap-2">
                                              <span className="text-2xs text-surface-600 w-20 flex-shrink-0">Service</span>
                                              <span className="font-mono text-2xs text-surface-300 truncate">{svc.name}</span>
                                              <span className="text-2xs text-surface-500 ml-auto flex-shrink-0">{svc.type}</span>
                                            </div>
                                          ))}
                                          {nsSvcs.length > 6 && <div className="text-2xs text-surface-600">+{nsSvcs.length - 6} more</div>}
                                        </div>
                                    }
                                  </div>
                                </div>
                              </td>
                            </tr>
                          )}
                        </Fragment>
                      )
                    })}
                </tbody>
              </table>
              </div>
            </div>
            <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
                <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2">
                  <Server className="w-4 h-4 text-brand-400" />
                  <span className="text-sm font-semibold text-white">Limit Ranges</span>
                  <span className="text-2xs text-surface-500 ml-1">({quotasData.limitranges.length})</span>
                </div>
                {quotasData.limitranges.length === 0 && (
                  <div className="px-4 py-6 text-center">
                    <Server className="w-6 h-6 text-surface-600 mx-auto mb-2" />
                    <p className="text-sm text-surface-500">No LimitRanges configured</p>
                    <p className="text-2xs text-surface-600 mt-0.5">Define LimitRanges to set default CPU/memory constraints per namespace</p>
                  </div>
                )}
                {quotasData.limitranges.length > 0 && (
                <div className="overflow-x-auto">
                <table className="w-full text-xs">
                  <thead>
                    <tr className="border-b border-surface-800 bg-surface-950">
                      {['Name', 'Namespace', 'Type', 'Resource', 'Default Request', 'Default Limit', 'Min', 'Max'].map(h => (
                        <th key={h} className="px-3 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {quotasData.limitranges.flatMap((lr: LimitRange) =>
                      lr.limits.map((l, i) => (
                        <tr key={`${lr.namespace}/${lr.name}/${i}`} className="border-b border-surface-800/50 hover:bg-surface-800/40 transition-colors">
                          <td className="px-3 py-2.5 font-mono text-white">{lr.name}</td>
                          <td className="px-3 py-2.5 font-mono">
                            <div className="flex flex-col gap-0.5">
                              <span className="text-surface-400">{lr.namespace}</span>
                              {i === 0 && (
                                (limitRangeCompliance[lr.namespace] ?? 0) > 0
                                  ? <span className="text-2xs font-semibold text-warning">{limitRangeCompliance[lr.namespace]} BestEffort pods</span>
                                  : <span className="text-2xs text-success">all constrained ?</span>
                              )}
                            </div>
                          </td>
                          <td className="px-3 py-2.5 text-surface-400">{l.type}</td>
                          <td className="px-3 py-2.5 text-surface-400">{l.resource}</td>
                          <td className="px-3 py-2.5 text-surface-500 font-mono">{l.defaultRequest[l.resource] ?? '-'}</td>
                          <td className="px-3 py-2.5 text-surface-500 font-mono">{l.default[l.resource] ?? '-'}</td>
                          <td className="px-3 py-2.5 text-surface-500 font-mono">{l.min[l.resource] ?? '-'}</td>
                          <td className="px-3 py-2.5 text-surface-500 font-mono">{l.max[l.resource] ?? '-'}</td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
                </div>
                )}
              </div>

            {/* Resource Quotas */}
            <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
                <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2">
                  <Layers className="w-4 h-4 text-amber-400" />
                  <span className="text-sm font-semibold text-white">Resource Quotas</span>
                  <span className="text-2xs text-surface-500 ml-1">({quotasData.quotas.length})</span>
                </div>
                {quotasData.quotas.length === 0 && (
                  <div className="px-4 py-6 text-center">
                    <Layers className="w-6 h-6 text-surface-600 mx-auto mb-2" />
                    <p className="text-sm text-surface-500">No ResourceQuotas configured</p>
                    <p className="text-2xs text-surface-600 mt-0.5">Namespaces are uncapped ? create ResourceQuota objects to limit CPU, memory, and pod counts per namespace</p>
                  </div>
                )}
                {quotasData.quotas.length > 0 && (
                <div className="overflow-x-auto">
                <table className="w-full text-xs">
                  <thead>
                    <tr className="border-b border-surface-800 bg-surface-950">
                      {['Namespace', 'CPU Request', 'CPU Limit', 'Mem Request', 'Mem Limit', 'Pods'].map(h => (
                        <th key={h} className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {quotasData.quotas.map((q: ResourceQuota) => {
                      const cpuReqPct = q.cpuRequestLimit > 0 ? q.cpuRequestUsed / q.cpuRequestLimit : 0
                      const cpuLimPct = q.cpuLimitLimit   > 0 ? q.cpuLimitUsed   / q.cpuLimitLimit   : 0
                      const memReqPct = q.memRequestLimit > 0 ? q.memRequestUsed / q.memRequestLimit : 0
                      const memLimPct = q.memLimitLimit   > 0 ? q.memLimitUsed   / q.memLimitLimit   : 0
                      const podPct    = q.podLimit        > 0 ? q.podUsed        / q.podLimit        : 0
                      const barCol = (pct: number) => pct >= 0.9 ? 'bg-danger' : pct >= 0.75 ? 'bg-warning' : 'bg-success'
                      const pctBar = (pct: number, label: string) => (
                        <div className="space-y-0.5 min-w-[80px]">
                          <div className="w-20 h-1.5 rounded-full bg-surface-700 overflow-hidden">
                            <div className={cn('h-full rounded-full', barCol(pct))} style={{ width: `${Math.min(pct * 100, 100)}%` }} />
                          </div>
                          <div className="font-mono text-2xs text-surface-400">{label}</div>
                        </div>
                      )
                      return (
                        <tr key={q.namespace} className="border-b border-surface-800/50 hover:bg-surface-800/40">
                          <td className="px-4 py-2.5 font-mono text-white text-xs">{q.namespace}</td>
                          <td className="px-4 py-2.5">{pctBar(cpuReqPct, `${q.cpuRequestUsed.toFixed(1)}/${q.cpuRequestLimit.toFixed(1)}`)}</td>
                          <td className="px-4 py-2.5">{pctBar(cpuLimPct, `${q.cpuLimitUsed.toFixed(1)}/${q.cpuLimitLimit.toFixed(1)}`)}</td>
                          <td className="px-4 py-2.5">{pctBar(memReqPct, `${q.memRequestUsed.toFixed(1)}/${q.memRequestLimit.toFixed(1)} Gi`)}</td>
                          <td className="px-4 py-2.5">{pctBar(memLimPct, `${q.memLimitUsed.toFixed(1)}/${q.memLimitLimit.toFixed(1)} Gi`)}</td>
                          <td className="px-4 py-2.5">{pctBar(podPct, `${q.podUsed}/${q.podLimit}`)}</td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
                </div>
                )}
              </div>

            {/* Network Policies */}
            <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
              <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2">
                <Shield className="w-4 h-4 text-purple-400" />
                <span className="text-sm font-semibold text-white">Network Policies</span>
                <span className="text-2xs text-surface-500 ml-1">({netpolData.policies.length})</span>
                <div className="ml-auto relative w-52">
                  <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-surface-500 pointer-events-none" />
                  <input value={netpolSearch} onChange={e => setNetpolSearch(e.target.value)} placeholder="Search policies?"
                    className="w-full bg-surface-800 border border-surface-700 rounded-lg pl-8 pr-3 py-1.5 text-2xs text-white placeholder-surface-500 focus:outline-none focus:border-brand-500" />
                </div>
              </div>
              <div className="overflow-x-auto">
              <table className="w-full text-sm">
                <thead>
                  <tr className="border-b border-surface-800 bg-surface-950">
                    {['Name', 'Namespace', 'Pod Selector', 'Policy Types', 'Ingress Rules', 'Egress Rules', ''].map(h => (
                      <th key={h} className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {netpolData.policies
                    .filter((np: K8sNetworkPolicy) => !netpolSearch || np.name.toLowerCase().includes(netpolSearch.toLowerCase()) || np.namespace.toLowerCase().includes(netpolSearch.toLowerCase()))
                    .map((np: K8sNetworkPolicy) => {
                      const npKey = `${np.namespace}/${np.name}`
                      const isExpNp = expandedNetpol === npKey
                      const hasRules = (np.ingress?.length ?? 0) > 0 || (np.egress?.length ?? 0) > 0
                      return (
                        <Fragment key={npKey}>
                          <tr className={cn('border-b border-surface-800/50 hover:bg-surface-800/40', hasRules && 'cursor-pointer')}
                            onClick={() => hasRules && setExpandedNetpol(isExpNp ? null : npKey)}>
                            <td className="px-4 py-2.5 font-mono text-white text-xs">
                              <div className="flex items-center gap-1.5">
                                {hasRules
                                  ? (isExpNp ? <ChevronDown className="w-3 h-3 text-surface-400 flex-shrink-0" /> : <ChevronRight className="w-3 h-3 text-surface-500 flex-shrink-0" />)
                                  : <span className="w-3 inline-block" />}
                                {np.name}
                              </div>
                            </td>
                            <td className="px-4 py-2.5 text-surface-400 text-xs">{np.namespace}</td>
                            <td className="px-4 py-2.5 font-mono text-2xs text-brand-300">
                              {Object.keys(np.podSelector ?? {}).length === 0
                                ? <span className="text-surface-600 italic">all pods</span>
                                : Object.entries(np.podSelector ?? {}).slice(0, 2).map(([k, v]) => `${k}=${v}`).join(', ')}
                            </td>
                            <td className="px-4 py-2.5">
                              <div className="flex gap-1">
                                {(np.policyTypes ?? []).map((t: string) => (
                                  <span key={t} className={cn('text-2xs px-1.5 py-0.5 rounded-full font-semibold border',
                                    t === 'Ingress' ? 'bg-brand-500/10 text-brand-400 border-brand-500/20' : 'bg-purple-500/10 text-purple-400 border-purple-500/20'
                                  )}>{t}</span>
                                ))}
                              </div>
                            </td>
                            <td className="px-4 py-2.5 tabular-nums text-xs">
                              <span className={cn((np.ingressRules ?? 0) > 0 ? 'text-brand-400 font-semibold' : 'text-surface-600')}>{np.ingressRules ?? 0}</span>
                            </td>
                            <td className="px-4 py-2.5 tabular-nums text-xs">
                              <span className={cn((np.egressRules ?? 0) > 0 ? 'text-purple-400 font-semibold' : 'text-surface-600')}>{np.egressRules ?? 0}</span>
                            </td>
                            <td className="px-4 py-2.5" onClick={e => e.stopPropagation()}>
                              <div className="flex items-center gap-1">
                                <button onClick={() => setDescribeTarget({ kind: 'NetworkPolicy', namespace: np.namespace, name: np.name })}
                                  className="p-1.5 rounded-lg text-surface-600 hover:text-amber-400 hover:bg-amber-400/10 transition-all" title="Describe">
                                  <FileSearch className="w-3.5 h-3.5" />
                                </button>
                                <button onClick={() => setYamlTarget({ kind: 'NetworkPolicy', namespace: np.namespace, name: np.name })}
                                  className="p-1.5 rounded-lg text-surface-600 hover:text-brand-400 hover:bg-brand-400/10 transition-all" title="YAML">
                                  <FileCode2 className="w-3.5 h-3.5" />
                                </button>
                              </div>
                            </td>
                          </tr>
                          {isExpNp && (
                            <tr className="bg-surface-950/60 border-b border-surface-800/50">
                              <td colSpan={7} className="px-6 py-4">
                                <div className="grid grid-cols-2 gap-4">
                                  {(np.ingress?.length ?? 0) > 0 && (
                                    <div>
                                      <p className="text-2xs font-semibold text-brand-400 uppercase tracking-wider mb-2">Ingress Rules ({np.ingress.length})</p>
                                      <div className="space-y-2">
                                        {np.ingress.map((rule, ri) => (
                                          <div key={ri} className="bg-surface-900 rounded-lg px-3 py-2 text-2xs space-y-1">
                                            <div className="text-surface-500">Rule {ri + 1}</div>
                                            {rule.from.length === 0
                                              ? <div className="text-success italic">Allow from all sources</div>
                                              : rule.from.map((peer, pi) => (
                                                  <div key={pi} className="font-mono text-surface-300 space-y-0.5">
                                                    {peer.podSelector && <div>pods: <span className="text-brand-300">{Object.entries(peer.podSelector).map(([k,v])=>`${k}=${v}`).join(',') || 'all'}</span></div>}
                                                    {peer.namespaceSelector && <div>ns: <span className="text-purple-300">{Object.entries(peer.namespaceSelector).map(([k,v])=>`${k}=${v}`).join(',') || 'all'}</span></div>}
                                                    {peer.ipBlock && <div>cidr: <span className="text-amber-300">{peer.ipBlock.cidr}</span></div>}
                                                  </div>
                                                ))
                                            }
                                            {rule.ports.length > 0 && (
                                              <div className="flex gap-1 mt-1 flex-wrap">
                                                {rule.ports.map((p, pi) => (
                                                  <span key={pi} className="bg-surface-800 font-mono px-1.5 py-0.5 rounded text-brand-300">{p.port}/{p.protocol}</span>
                                                ))}
                                              </div>
                                            )}
                                          </div>
                                        ))}
                                      </div>
                                    </div>
                                  )}
                                  {(np.egress?.length ?? 0) > 0 && (
                                    <div>
                                      <p className="text-2xs font-semibold text-purple-400 uppercase tracking-wider mb-2">Egress Rules ({np.egress.length})</p>
                                      <div className="space-y-2">
                                        {np.egress.map((rule, ri) => (
                                          <div key={ri} className="bg-surface-900 rounded-lg px-3 py-2 text-2xs space-y-1">
                                            <div className="text-surface-500">Rule {ri + 1}</div>
                                            {rule.to.length === 0
                                              ? <div className="text-success italic">Allow to all destinations</div>
                                              : rule.to.map((peer, pi) => (
                                                  <div key={pi} className="font-mono text-surface-300 space-y-0.5">
                                                    {peer.podSelector && <div>pods: <span className="text-brand-300">{Object.entries(peer.podSelector).map(([k,v])=>`${k}=${v}`).join(',') || 'all'}</span></div>}
                                                    {peer.namespaceSelector && <div>ns: <span className="text-purple-300">{Object.entries(peer.namespaceSelector).map(([k,v])=>`${k}=${v}`).join(',') || 'all'}</span></div>}
                                                    {peer.ipBlock && <div>cidr: <span className="text-amber-300">{peer.ipBlock.cidr}</span></div>}
                                                  </div>
                                                ))
                                            }
                                            {rule.ports.length > 0 && (
                                              <div className="flex gap-1 mt-1 flex-wrap">
                                                {rule.ports.map((p, pi) => (
                                                  <span key={pi} className="bg-surface-800 font-mono px-1.5 py-0.5 rounded text-purple-300">{p.port}/{p.protocol}</span>
                                                ))}
                                              </div>
                                            )}
                                          </div>
                                        ))}
                                      </div>
                                    </div>
                                  )}
                                </div>
                              </td>
                            </tr>
                          )}
                        </Fragment>
                      )
                    })}
                  {netpolData.policies.length === 0 && (
                    <tr><td colSpan={7} className="px-4 py-6 text-center text-surface-600 text-sm">No network policies found</td></tr>
                  )}
                </tbody>
              </table>
              </div>
            </div>

            {/* Priority Classes */}
            {pcData.priorityClasses.length > 0 && (
              <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
                <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2">
                  <Layers className="w-4 h-4 text-amber-400" />
                  <span className="text-sm font-semibold text-white">Priority Classes</span>
                  <span className="text-2xs text-surface-500 ml-1">({pcData.priorityClasses.length})</span>
                  <span className="text-2xs text-surface-600 ml-auto">higher value = preempts lower-priority pods</span>
                </div>
                <div className="overflow-x-auto">
                <table className="w-full text-xs">
                  <thead>
                    <tr className="border-b border-surface-800 bg-surface-950">
                      {['Name', 'Value', 'Preemption', 'Global Default', 'Description', 'Age'].map(h => (
                        <th key={h} className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {pcData.priorityClasses.map((pc: K8sPriorityClass) => {
                      const isSystem = pc.value >= 1_000_000_000
                      const createdAgo = Math.round((Date.now() - new Date(pc.createdAt).getTime()) / 86_400_000)
                      return (
                        <tr key={pc.name} className="border-b border-surface-800/50 hover:bg-surface-800/40">
                          <td className="px-4 py-2.5 font-mono text-white text-xs">
                            <div className="flex items-center gap-1.5">
                              {pc.name}
                              {isSystem && <span className="text-2xs font-semibold text-purple-400 bg-purple-400/10 border border-purple-400/20 px-1 py-0.5 rounded">system</span>}
                              {pc.globalDefault && <span className="text-2xs font-semibold text-brand-400 bg-brand-400/10 border border-brand-400/20 px-1 py-0.5 rounded">default</span>}
                            </div>
                          </td>
                          <td className="px-4 py-2.5 tabular-nums font-mono font-semibold text-xs text-amber-400">{pc.value.toLocaleString()}</td>
                          <td className="px-4 py-2.5 text-xs text-surface-400">{pc.preemptionPolicy}</td>
                          <td className="px-4 py-2.5">
                            {pc.globalDefault
                              ? <CheckCircle2 className="w-3.5 h-3.5 text-success" />
                              : <span className="text-surface-600 text-2xs">?</span>}
                          </td>
                          <td className="px-4 py-2.5 text-surface-500 text-xs max-w-[260px] truncate" title={pc.description || undefined}>
                            {pc.description || <span className="text-surface-700 italic">no description</span>}
                          </td>
                          <td className="px-4 py-2.5 text-surface-500 text-xs">
                            {createdAgo === 0 ? 'today' : `${createdAgo}d`}
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
                </div>
              </div>
            )}

            {/* PodDisruptionBudgets */}
            {workloadsData.pdbs.length > 0 && (
              <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
                <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2">
                  <Shield className="w-4 h-4 text-success" />
                  <span className="text-sm font-semibold text-white">PodDisruptionBudgets</span>
                  <span className="text-2xs text-surface-500 ml-1">({workloadsData.pdbs.length})</span>
                  <span className="text-2xs text-surface-600 ml-auto">limits voluntary disruptions during node drain / upgrades</span>
                </div>
                <div className="overflow-x-auto">
                <table className="w-full text-xs">
                  <thead>
                    <tr className="border-b border-surface-800 bg-surface-950">
                      {['Name', 'Namespace', 'Min Available', 'Max Unavailable', 'Current / Desired', 'Expected Pods', 'Disruptions OK', ''].map(h => (
