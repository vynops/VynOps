    Failed:     allPods.filter(p => p.status === 'Failed').length,
    Other:      allPods.filter(p => !['Running','Pending','CrashLoopBackOff','OOMKilled','Evicted','Succeeded','Degraded','Failed'].includes(p.status)).length,
  }), [allPods])

  const podNamespaces = useMemo(() =>
    Array.from(new Set(allPods.map(p => p.namespace))).sort()
  , [allPods])

  const handleDeleteAllEvicted = useCallback(async () => {
    const evicted = allPods.filter(p => p.status === 'Evicted')
    if (!evicted.length) return
    setDeletingEvicted(true)
    await Promise.allSettled(evicted.map(p =>
      fetch(`/api/k8s/pods/${encodeURIComponent(p.namespace)}/${encodeURIComponent(p.name)}/delete`, { method: 'DELETE', headers: getClusterHeaders() })
    ))
    setDeletingEvicted(false)
    setTimeout(() => refreshPods(), 1500)
  }, [allPods, refreshPods])

  // Workloads search + filter + sort
  const workloadNamespaces = useMemo(() =>
    Array.from(new Set([
      ...workloadsData.deployments.map((d: K8sDeployment) => d.namespace),
      ...workloadsData.statefulsets.map((s: K8sStatefulSet) => s.namespace),
      ...workloadsData.daemonsets.map((d: K8sDaemonSet) => d.namespace),
    ])).sort()
  , [workloadsData.deployments, workloadsData.statefulsets, workloadsData.daemonsets])

  const filteredDeploys = useMemo(() => {
    let list = [...workloadsData.deployments] as K8sDeployment[]
    if (wNsFilter) list = list.filter(d => d.namespace === wNsFilter)
    if (wSearch) {
      const q = wSearch.toLowerCase()
      list = list.filter(d =>
        d.name.toLowerCase().includes(q) ||
        d.namespace.toLowerCase().includes(q) ||
        (d.image ?? '').toLowerCase().includes(q) ||
        (d.helmRelease ?? '').toLowerCase().includes(q)
      )
    }
    if (wStatusFilter === 'Healthy')  list = list.filter(d => d.ready === d.desired && d.desired > 0 && !d.rollingOut)
    if (wStatusFilter === 'Degraded') list = list.filter(d => d.ready < d.desired && !d.rollingOut)
    if (wStatusFilter === 'Rolling')  list = list.filter(d => !!d.rollingOut)
    list.sort((a, b) => {
      let cmp = 0
      if (wSortCol === 'name')      cmp = a.name.localeCompare(b.name)
      if (wSortCol === 'namespace') cmp = a.namespace.localeCompare(b.namespace)
      if (wSortCol === 'ready')     cmp = (a.ready / Math.max(a.desired, 1)) - (b.ready / Math.max(b.desired, 1))
      if (wSortCol === 'age')       cmp = new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime()
      if (wSortCol === 'status') {
        const rank = (d: K8sDeployment) => d.rollingOut ? 1 : d.ready < d.desired ? 2 : 0
        cmp = rank(a) - rank(b)
      }
      return wSortDir === 'asc' ? cmp : -cmp
    })
    return list
  }, [workloadsData.deployments, wSearch, wNsFilter, wSortCol, wSortDir, wStatusFilter])

  const filteredSTS = useMemo(() => {
    let list = [...workloadsData.statefulsets] as K8sStatefulSet[]
    if (wNsFilter) list = list.filter(s => s.namespace === wNsFilter)
    if (wSearch) { const q = wSearch.toLowerCase(); list = list.filter(s => s.name.toLowerCase().includes(q) || s.namespace.toLowerCase().includes(q)) }
    if (wStatusFilter === 'Healthy')  list = list.filter(s => s.ready === s.desired && s.desired > 0 && !s.rollingOut)
    if (wStatusFilter === 'Degraded') list = list.filter(s => s.ready < s.desired && !s.rollingOut)
    list.sort((a, b) => {
      let cmp = 0
      if (wStsSortCol === 'name')      cmp = a.name.localeCompare(b.name)
      if (wStsSortCol === 'namespace') cmp = a.namespace.localeCompare(b.namespace)
      if (wStsSortCol === 'ready')     cmp = (a.ready / Math.max(a.desired, 1)) - (b.ready / Math.max(b.desired, 1))
      return wStsSortDir === 'asc' ? cmp : -cmp
    })
    return list
  }, [workloadsData.statefulsets, wSearch, wNsFilter, wStatusFilter, wStsSortCol, wStsSortDir])

  const filteredDS = useMemo(() => {
    let list = [...workloadsData.daemonsets] as K8sDaemonSet[]
    if (wNsFilter) list = list.filter(d => d.namespace === wNsFilter)
    if (wSearch) { const q = wSearch.toLowerCase(); list = list.filter(d => d.name.toLowerCase().includes(q) || d.namespace.toLowerCase().includes(q)) }
    if (wStatusFilter === 'Healthy')  list = list.filter(d => d.ready === d.desired && d.desired > 0)
    if (wStatusFilter === 'Degraded') list = list.filter(d => d.ready < d.desired)
    list.sort((a, b) => {
      let cmp = 0
      if (wDsSortCol === 'name')      cmp = a.name.localeCompare(b.name)
      if (wDsSortCol === 'namespace') cmp = a.namespace.localeCompare(b.namespace)
      if (wDsSortCol === 'ready')     cmp = (a.ready / Math.max(a.desired, 1)) - (b.ready / Math.max(b.desired, 1))
      return wDsSortDir === 'asc' ? cmp : -cmp
    })
    return list
  }, [workloadsData.daemonsets, wSearch, wNsFilter, wStatusFilter, wDsSortCol, wDsSortDir])

  const filteredSvcs = useMemo(() => {
