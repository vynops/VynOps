                                        : <div className="flex flex-wrap gap-1">
                                            {nsLabels.map(([k, v]) => (
                                              <span key={k} className="bg-surface-800 border border-surface-700 rounded px-1.5 py-0.5 font-mono text-2xs text-surface-400">{k}={v}</span>
                                            ))}
                                          </div>
                                      }
                                    </div>
                                    {(['enforce', 'warn', 'audit'] as const).some(m => ns.labels?.[`pod-security.kubernetes.io/${m}`]) && (
                                      <div>
