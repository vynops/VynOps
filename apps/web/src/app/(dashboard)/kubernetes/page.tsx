                            <td className="px-3 py-2.5">
                              {psaLevel
                                ? <span className={cn('text-2xs px-1.5 py-0.5 rounded-full font-semibold border', psaColor)}>{psaLevel}</span>
                                : (() => {
                                    const warn  = ns.labels?.['pod-security.kubernetes.io/warn']
                                    const audit = ns.labels?.['pod-security.kubernetes.io/audit']
                                    const shown = warn ?? audit
                                    if (!shown) return <span className="text-surface-600 text-2xs">?</span>
                                    const mode = warn ? 'warn' : 'audit'
                                    const lvlCls = shown === 'restricted' ? 'text-success' : shown === 'baseline' ? 'text-warning' : 'text-surface-400'
                                    return (
                                      <div className="flex items-center gap-1">
                                        <span className={cn('text-2xs font-semibold', lvlCls)}>{shown}</span>
                                        <span className={cn('text-2xs px-1 py-0.5 rounded font-medium border',
                                          mode === 'warn' ? 'bg-warning/10 text-warning border-warning/20' : 'bg-brand-400/10 text-brand-400 border-brand-400/20'
                                        )}>{mode}</span>
                                      </div>
                                    )
                                  })()
                              }
                            </td>
                            <td className="px-3 py-2.5">
                              {sum.podTotal === 0
                                ? <span className="text-surface-600 text-2xs">?</span>
                                : <div className="flex items-center gap-1.5">
                                    <span className={cn('font-semibold text-xs tabular-nums', podHealthy ? 'text-success' : 'text-warning')}>
                                      {sum.podRunning}/{sum.podTotal}
                                    </span>
                                    <div className="w-10 h-1 rounded-full bg-surface-700 overflow-hidden">
                                      <div className={cn('h-full rounded-full', podHealthy ? 'bg-success' : 'bg-warning')}
