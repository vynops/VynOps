    fetch(`/api/k8s/services/${encodeURIComponent(ns)}/${encodeURIComponent(nm)}/endpoints`, { headers: getClusterHeaders() })
      .then(r => r.json())
      .then(d => setSvcEndpoints(prev => ({ ...prev, [expandedSvc]: d })))
      .catch(() => setSvcEndpoints(prev => ({ ...prev, [expandedSvc]: { ready: [], notReady: [], ports: [] } })))
      .finally(() => setLoadingSvcEp(null))
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [expandedSvc])

  // Lazy-load ingress traffic metrics when an Ingress row is expanded
  useEffect(() => {
    if (!expandedIng || ingMetrics[expandedIng] !== undefined) return
    const slash = expandedIng.indexOf('/')
    const ns   = expandedIng.slice(0, slash)
    const nm   = expandedIng.slice(slash + 1)
    setLoadingIngMetrics(expandedIng)
    fetch(`/api/k8s/ingress-metrics?namespace=${encodeURIComponent(ns)}&name=${encodeURIComponent(nm)}`, { headers: getClusterHeaders() })
      .then(r => r.json())
      .then(d => setIngMetrics(prev => ({ ...prev, [expandedIng]: d })))
      .catch(() => setIngMetrics(prev => ({ ...prev, [expandedIng]: { metrics: null, hasController: false } })))
      .finally(() => setLoadingIngMetrics(null))
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [expandedIng])

  // Flatten podsByNode into a sorted list
  const allPods: (K8sPod & { nodeName: string })[] = useMemo(() => {
    const list: (K8sPod & { nodeName: string })[] = []
    for (const [node, pods] of Object.entries(podsData.podsByNode)) {
      for (const pod of (pods as K8sPod[])) list.push({ ...pod, nodeName: node })
    }
    list.sort((a, b) => {
      if (a.status === 'Running' && b.status !== 'Running') return -1
      if (a.status !== 'Running' && b.status === 'Running') return 1
      return a.namespace.localeCompare(b.namespace) || a.name.localeCompare(b.name)
    })
    return list
  }, [podsData.podsByNode])

  // Status buckets for filter chips
  const statusCounts = useMemo(() => ({
    Running:    allPods.filter(p => p.status === 'Running').length,
    Pending:    allPods.filter(p => p.status === 'Pending').length,
    Degraded:   allPods.filter(p => p.status === 'Degraded').length,
    CrashLoop:  allPods.filter(p => p.status === 'CrashLoopBackOff').length,
    OOMKilled:  allPods.filter(p => p.status === 'OOMKilled' || !!p.oomKilled).length,
