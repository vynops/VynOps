        })()}

        {/* -- POLICY TAB -- */}
        {tab === 'Policy' && (
          <div className="space-y-4">

            {/* ?? Scorecard ??????????????????????????????????????????????? */}
            <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
              {([
                { label: 'PSA Enforced',  value: policyInsights.psaCounts.restricted + policyInsights.psaCounts.baseline, total: policyInsights.totalNs,      sub: policyInsights.psaCounts.none > 0 ? `${policyInsights.psaCounts.none} unlabeled` : 'all labelled' },
                { label: 'Net Isolated',  value: policyInsights.isolatedNs,            total: policyInsights.totalNs,      sub: policyInsights.openNamespaces.length > 0 ? `${policyInsights.openNamespaces.length} open` : policyInsights.defaultDenyCoverage < policyInsights.isolatedNs ? `${policyInsights.defaultDenyCoverage} default-deny` : 'all isolated' },
                { label: 'Quota Capped',  value: policyInsights.quotaCoverage,          total: policyInsights.totalNs,      sub: policyInsights.uncappedNamespaces.length > 0 ? `${policyInsights.uncappedNamespaces.length} uncapped` : 'fully capped'  },
                { label: 'LimitRange',    value: policyInsights.lrCoverage,             total: policyInsights.totalNs,      sub: `${policyInsights.totalNs - policyInsights.lrCoverage} without LR` },
                { label: 'PDB Protected', value: policyInsights.workloadCoveredByPDB,   total: policyInsights.totalWorkloads, sub: policyInsights.workloadsWithoutPDB.length > 0 ? `${policyInsights.workloadsWithoutPDB.length} exposed` : 'all covered' },
              ] as { label: string; value: number; total: number; sub: string }[]).map(s => {
                const pct    = s.total > 0 ? s.value / s.total : 1
                const valCls = pct >= 0.8 ? 'text-success' : pct >= 0.5 ? 'text-warning' : 'text-danger'
                const barCls = pct >= 0.8 ? 'bg-success'   : pct >= 0.5 ? 'bg-warning'   : 'bg-danger'
                return (
                  <div key={s.label} className="rounded-xl bg-surface-900 border border-surface-800 px-4 py-3">
                    <div className="text-2xs text-surface-500 font-semibold uppercase tracking-wider mb-1.5">{s.label}</div>
                    <div className="flex items-baseline gap-1 mb-1.5">
                      <span className={cn('text-2xl font-bold tabular-nums', valCls)}>{s.value}</span>
                      <span className="text-sm text-surface-600">/{s.total}</span>
                    </div>
                    <div className="w-full h-1 rounded-full bg-surface-700 overflow-hidden mb-1.5">
                      <div className={cn('h-full rounded-full transition-all', barCls)} style={{ width: `${Math.round(pct * 100)}%` }} />
                    </div>
                    <div className="text-2xs text-surface-500">{s.sub}</div>
                  </div>
                )
              })}
            </div>

            {/* ?? Findings panel ?????????????????????????????????????????? */}
            {(policyInsights.openNamespaces.length + policyInsights.uncappedNamespaces.length +
              policyInsights.workloadsWithoutPDB.length + policyInsights.highUtilNs.length +
              (policyInsights.isolatedNs - policyInsights.defaultDenyCoverage)) > 0 && (
              <div className="rounded-2xl bg-surface-900 border border-warning/25 overflow-hidden">
                <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2">
                  <Shield className="w-4 h-4 text-warning" />
                  <span className="text-sm font-semibold text-white">Policy Findings</span>
                  <span className="ml-0.5 text-2xs bg-warning/10 text-warning border border-warning/20 px-1.5 py-0.5 rounded-full font-semibold">
                    {policyInsights.openNamespaces.length + policyInsights.uncappedNamespaces.length + policyInsights.workloadsWithoutPDB.length + policyInsights.highUtilNs.length + (policyInsights.isolatedNs - policyInsights.defaultDenyCoverage)}
                  </span>
                  <span className="ml-auto text-2xs text-surface-500">items requiring attention</span>
                </div>
                <div className="divide-y divide-surface-800/40">
                  {policyInsights.openNamespaces.length > 0 && (
                    <div className="px-4 py-3">
                      <div className="flex items-center gap-2 mb-2">
                        <span className="w-2 h-2 rounded-full bg-danger flex-shrink-0" />
                        <span className="text-xs font-semibold text-white">{policyInsights.openNamespaces.length} namespace{policyInsights.openNamespaces.length > 1 ? 's' : ''} without NetworkPolicy</span>
                        <span className="text-2xs text-surface-500">&mdash; all cluster egress/ingress permitted</span>
                      </div>
                      <div className="flex flex-wrap gap-1 ml-4">
                        {policyInsights.openNamespaces.map(ns => (
                          <span key={ns} className="font-mono text-2xs bg-danger/10 border border-danger/20 text-danger px-1.5 py-0.5 rounded">{ns}</span>
                        ))}
                      </div>
                    </div>
                  )}
                  {policyInsights.uncappedNamespaces.length > 0 && (
                    <div className="px-4 py-3">
                      <div className="flex items-center gap-2 mb-2">
                        <span className="w-2 h-2 rounded-full bg-warning flex-shrink-0" />
                        <span className="text-xs font-semibold text-white">{policyInsights.uncappedNamespaces.length} namespace{policyInsights.uncappedNamespaces.length > 1 ? 's' : ''} without ResourceQuota</span>
                        <span className="text-2xs text-surface-500">&mdash; resource consumption uncapped</span>
                      </div>
                      <div className="flex flex-wrap gap-1 ml-4">
                        {policyInsights.uncappedNamespaces.map(ns => (
                          <span key={ns} className="font-mono text-2xs bg-warning/10 border border-warning/20 text-warning px-1.5 py-0.5 rounded">{ns}</span>
                        ))}
                      </div>
                    </div>
                  )}
                  {policyInsights.workloadsWithoutPDB.length > 0 && (
                    <div className="px-4 py-3">
                      <div className="flex items-center gap-2 mb-2">
                        <span className="w-2 h-2 rounded-full bg-warning flex-shrink-0" />
                        <span className="text-xs font-semibold text-white">{policyInsights.workloadsWithoutPDB.length} workload{policyInsights.workloadsWithoutPDB.length > 1 ? 's' : ''} without PodDisruptionBudget</span>
                        <span className="text-2xs text-surface-500">&mdash; vulnerable to full disruption during node drain</span>
                      </div>
                      <div className="flex flex-wrap gap-1 ml-4">
                        {policyInsights.workloadsWithoutPDB.slice(0, 12).map(w => (
                          <span key={`${w.ns}/${w.name}`} className="font-mono text-2xs bg-surface-800 border border-surface-700 text-surface-300 px-1.5 py-0.5 rounded">
                            <span className="text-surface-500">{w.ns}/</span>{w.name}
