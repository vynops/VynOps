function ScaleModal({ deployment, onClose, onDone }: { deployment: K8sDeployment; onClose: () => void; onDone: () => void }) {
  const [replicas, setReplicas] = useState(deployment.desired)
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState<string | null>(null)

  const apply = async () => {
    setLoading(true); setError(null)
    const r = await fetch(`/api/k8s/deployments/${deployment.namespace}/${deployment.name}/scale`, {
      method: 'PATCH', headers: { 'Content-Type': 'application/json', ...getClusterHeaders() },
      body: JSON.stringify({ replicas }),
    })
    const j = await r.json()
    if (j.ok) { onDone(); onClose() } else setError(j.error ?? 'Failed')
    setLoading(false)
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center">
      <div className="absolute inset-0 bg-black/60" onClick={onClose} />
      <div className="relative bg-surface-900 border border-surface-700 rounded-2xl p-6 w-80 shadow-2xl space-y-4">
        <h3 className="text-sm font-bold text-white">Scale: {deployment.name}</h3>
        <div className="flex items-center justify-between">
          <span className="text-xs text-surface-400">Replicas</span>
          <div className="flex items-center gap-2">
            <button onClick={() => setReplicas(r => Math.max(0, r - 1))} className="w-7 h-7 flex items-center justify-center bg-surface-700 hover:bg-surface-600 rounded-lg text-white"><Minus className="w-3 h-3" /></button>
            <span className="w-8 text-center text-lg font-bold text-white tabular-nums">{replicas}</span>
            <button onClick={() => setReplicas(r => r + 1)} className="w-7 h-7 flex items-center justify-center bg-surface-700 hover:bg-surface-600 rounded-lg text-white"><Plus className="w-3 h-3" /></button>
          </div>
        </div>
        {error && <p className="text-xs text-danger">{error}</p>}
        <div className="flex gap-2 pt-1">
          <button onClick={onClose} className="flex-1 px-3 py-2 rounded-xl text-xs text-surface-400 hover:text-white bg-surface-800 hover:bg-surface-700">Cancel</button>
          <button onClick={apply} disabled={loading} className="flex-1 px-3 py-2 rounded-xl text-xs font-semibold text-white bg-brand-500 hover:bg-brand-600 disabled:opacity-40">{loading ? 'Scaling?' : 'Apply'}</button>
        </div>
      </div>
    </div>
  )
}

