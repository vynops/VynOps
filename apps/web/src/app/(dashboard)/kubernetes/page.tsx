        <div className="grid grid-cols-3 gap-3">
          {[['State', <span key="s" className={`font-semibold ${stateColor}`}>{container.stateReason ?? container.state}</span>],
            ['Ready', container.ready ? <span key="r" className="text-success font-semibold">Yes</span> : <span key="r" className="text-danger font-semibold">No</span>],
