function KubernetesInner() {
  const router = useRouter()
  const searchParams = useSearchParams()
  const [tab, setTab] = useState<Tab>(() => {
    const t = searchParams.get('tab')
    return (TABS as readonly string[]).includes(t ?? '') ? t as Tab : 'Pods'
  })
  const [search, setSearch] = useState(() => searchParams.get('pod') ?? '')
  const [expandedPod, setExpandedPod] = useState<string | null>(() => searchParams.get('pod') ?? null)
  const [nsFilter, setNsFilter] = useState<string | null>(() => searchParams.get('ns') ?? null)
  const [selectedContainer, setSelectedContainer] = useState<{ container: K8sContainer; pod: string; namespace: string } | null>(null)
  const [expandedDeploy, setExpandedDeploy] = useState<string | null>(null)
  const [logTarget, setLogTarget] = useState<{ pod: string; namespace: string; container?: string } | null>(null)
  const [describeTarget, setDescribeTarget] = useState<{ kind: string; namespace: string; name: string } | null>(null)
  const [yamlTarget, setYamlTarget] = useState<{ kind: string; namespace: string; name: string } | null>(null)
  const [execTarget, setExecTarget] = useState<{ pod: string; namespace: string; container?: string } | null>(null)
  const [scaleTarget, setScaleTarget] = useState<K8sDeployment | null>(null)
  const [deletePod, setDeletePod] = useState<{ namespace: string; name: string } | null>(null)
  const [crashFix,  setCrashFix]  = useState<{ pod: string; namespace: string } | null>(null)
  const [deletingPod, setDeletingPod] = useState(false)
  const [restartingDeploy, setRestartingDeploy] = useState<string | null>(null)
  const [cordoningNode, setCordoningNode] = useState<string | null>(null)
  const { clusters, setClusters, addCluster, removeCluster, activeCluster } = useDashboardStore()
  const [showConnectModal, setShowConnectModal] = useState(false)
  const [connectSuccess, setConnectSuccess] = useState(false)
  const [connectLoading, setConnectLoading] = useState(false)
  const [connectError, setConnectError] = useState<string | null>(null)
  const [connectForm, setConnectForm] = useState({ name: '', url: '', promUrl: '', provider: 'on-prem', region: '' })
  const [probingCluster, setProbingCluster] = useState<string | null>(null)

  // Load persisted registered clusters from server on mount
  useEffect(() => {
    fetch('/api/settings/clusters')
      .then(r => r.ok ? r.json() : [])
      .then((data: K8sCluster[]) => { if (Array.isArray(data)) setClusters(data) })
      .catch(() => null)
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [])

  const handleRegisterCluster = useCallback(async () => {
    setConnectError(null)
    setConnectLoading(true)
    try {
      const r = await fetch('/api/settings/clusters', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name:     connectForm.name,
          k8sUrl:   connectForm.url,
          promUrl:  connectForm.promUrl,
          provider: connectForm.provider,
          region:   connectForm.region,
        }),
      })
      if (!r.ok) {
        const e = await r.json()
        setConnectError(e.error ?? 'Registration failed')
        return
      }
      const cluster: K8sCluster = await r.json()
      addCluster(cluster)
      setConnectSuccess(true)
    } catch {
      setConnectError('Network error ? check that the proxy URL is reachable from this server')
    } finally {
      setConnectLoading(false)
    }
  }, [connectForm, addCluster])

  const handleRemoveCluster = useCallback(async (id: string) => {
    try {
