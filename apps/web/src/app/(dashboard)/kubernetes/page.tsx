                              <button onClick={() => setYamlTarget({ kind: 'PodDisruptionBudget', namespace: pdb.namespace, name: pdb.name })}
                                className="p-1.5 rounded-lg text-surface-600 hover:text-brand-400 hover:bg-brand-400/10 transition-all" title="YAML">
                                <FileCode2 className="w-3.5 h-3.5" />
                              </button>
                            </div>
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
              </div>
              </div>
            )}
          </div>
        )}

        {/* ?? Container Security Scorecard (Policy tab addition) ?? */}
        {tab === 'Policy' && (
          <div className="space-y-4 mt-4">
            <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
              <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2">
                <Shield className="w-4 h-4 text-danger" />
                <span className="text-sm font-semibold text-white">Container Security Audit</span>
                <span className="text-2xs text-surface-500 ml-1">non-system pods</span>
                {containerSecData.findings.length > 0 && (
                  <span className="ml-2 text-2xs px-2 py-0.5 rounded-full bg-danger/10 text-danger border border-danger/20 font-semibold">
                    {containerSecData.findings.length} issues
                  </span>
                )}
              </div>
              <div className="grid grid-cols-3 sm:grid-cols-7 gap-0 divide-x divide-surface-800 border-b border-surface-800">
                {([
                  { label: 'Privileged',     value: containerSecData.summary.privilegedCount,      danger: true  },
                  { label: 'May Run Root',   value: containerSecData.summary.runAsRootCount,        danger: true  },
                  { label: 'Allow Priv Esc', value: containerSecData.summary.allowPrivEscCount,     danger: true  },
                  { label: 'Host Network',   value: containerSecData.summary.hostNetworkCount,      danger: true  },
                  { label: 'HostPath Vol',   value: containerSecData.summary.hostPathCount,         danger: false },
                  { label: 'No Seccomp',     value: containerSecData.summary.noSeccompCount,        danger: false },
                  { label: 'Writable RootFS',value: containerSecData.summary.noReadOnlyRootFsCount, danger: false },
                ] as { label: string; value: number; danger: boolean }[]).map(s => (
                  <div key={s.label} className="px-3 py-3 text-center">
                    <div className={cn('text-xl font-bold tabular-nums', s.danger && s.value > 0 ? 'text-danger' : s.value > 0 ? 'text-warning' : 'text-success')}>{s.value}</div>
                    <div className="text-2xs text-surface-500 mt-0.5 leading-tight">{s.label}</div>
                  </div>
                ))}
              </div>
              {containerSecData.findings.length > 0 && (
                <div className="overflow-y-auto max-h-[280px]">
                  <table className="w-full text-xs">
                    <thead className="sticky top-0 z-10">
                      <tr className="border-b border-surface-800 bg-surface-950">
                        {['Namespace', 'Pod', 'Container', 'Risks'].map(h => (
                          <th key={h} className="px-3 py-2 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {containerSecData.findings
                        .filter(f => !secCtxNsFilter || f.namespace === secCtxNsFilter)
                        .slice(0, 60)
                        .map((f, i) => {
                          const hasCrit = f.risks.some(r => ['privileged', 'hostNetwork', 'mayRunAsRoot'].includes(r))
                          return (
                            <tr key={i} className={cn('border-b border-surface-800/40 hover:bg-surface-800/30', hasCrit && 'bg-danger/5')}>
                              <td className="px-3 py-2 font-mono text-white">{f.namespace}</td>
                              <td className="px-3 py-2 font-mono text-surface-400 max-w-[180px] truncate" title={f.pod}>{f.pod}</td>
                              <td className="px-3 py-2 font-mono text-brand-300">{f.container}</td>
                              <td className="px-3 py-2">
                                <div className="flex flex-wrap gap-1">
                                  {f.risks.map(r => {
                                    const critRisks = new Set(['privileged', 'hostNetwork', 'mayRunAsRoot'])
                                    return (
                                      <span key={r} className={cn('text-2xs px-1.5 py-0.5 rounded font-semibold',
                                        critRisks.has(r) ? 'bg-danger/10 text-danger border border-danger/20' :
                                        'bg-warning/10 text-warning border border-warning/20'
                                      )}>{r}</span>
                                    )
                                  })}
                                </div>
                              </td>
                            </tr>
                          )
                        })}
                    </tbody>
                  </table>
                </div>
              )}
              {containerSecData.findings.length === 0 && (
                <div className="px-4 py-6 text-center text-success text-sm font-semibold">
                  ? No container security issues detected in user namespaces
                </div>
              )}
            </div>
            {/* CRD Browser */}
            {crdsData.crds.length > 0 && (
              <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
                <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2 flex-wrap">
                  <Layers className="w-4 h-4 text-purple-400" />
                  <span className="text-sm font-semibold text-white">Custom Resource Definitions</span>
                  <span className="text-2xs text-surface-500 ml-1">({crdsData.crds.length})</span>
                  <div className="ml-auto flex flex-wrap gap-1">
                    <button onClick={() => setCrdGroupFilter(null)}
                      className={cn('text-2xs px-2 py-0.5 rounded border font-medium transition-all',
