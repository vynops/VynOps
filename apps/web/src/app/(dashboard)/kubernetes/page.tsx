                            const inIsolated = (netpolData.policies as K8sNetworkPolicy[]).some(np => np.namespace === ns.name)
                            const hasDefaultDeny = (netpolData.policies as K8sNetworkPolicy[]).some(np =>
                              np.namespace === ns.name &&
                              Object.keys(np.podSelector ?? {}).length === 0 &&
                              (((np.policyTypes ?? []).includes('Ingress') && (np.ingress?.length ?? 0) === 0) ||
                               ((np.policyTypes ?? []).includes('Egress')  && (np.egress?.length  ?? 0) === 0))
                            )
                            return inIsolated && !hasDefaultDeny
                          })
                          .map(ns => (
                            <span key={ns.name} className="font-mono text-2xs bg-purple-400/10 border border-purple-400/20 text-purple-400 px-1.5 py-0.5 rounded">{ns.name}</span>
                          ))
                        }
                      </div>
                    </div>
                  )}
                </div>
              </div>
            )}

            <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
