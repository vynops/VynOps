    if (svcTypeFilter) list = list.filter(s => s.type === svcTypeFilter)
    if (svcNsFilter)   list = list.filter(s => s.namespace === svcNsFilter)
    if (svcSearch) { const q = svcSearch.toLowerCase(); list = list.filter(s => s.name.toLowerCase().includes(q) || s.namespace.toLowerCase().includes(q)) }
    return [...list].sort((a, b) => {
      let cmp = 0
      if (svcSortCol === 'name')      cmp = a.name.localeCompare(b.name)
      if (svcSortCol === 'namespace') cmp = a.namespace.localeCompare(b.namespace)
      if (svcSortCol === 'type')      cmp = a.type.localeCompare(b.type)
      if (svcSortCol === 'endpoints') cmp = a.readyEndpoints - b.readyEndpoints
      if (svcSortCol === 'age')       cmp = new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime()
      return svcSortDir === 'asc' ? cmp : -cmp
    })
  }, [networkData.services, svcSearch, svcTypeFilter, svcNsFilter, svcSortCol, svcSortDir])

  const filteredIngresses = useMemo(() => {
    if (!ingSearch) return ingressData.ingresses as K8sIngress[]
    const q = ingSearch.toLowerCase()
    return (ingressData.ingresses as K8sIngress[]).filter(ing =>
      ing.name.toLowerCase().includes(q) ||
      ing.namespace.toLowerCase().includes(q) ||
      ing.rules.some(r => r.host?.toLowerCase().includes(q))
    )
  }, [ingressData.ingresses, ingSearch])

  const certUsage = useMemo(() => {
    const usage: Record<string, number> = {}
    for (const ing of ingressData.ingresses as K8sIngress[]) {
      for (const tls of (ing.tls ?? [])) {
        const key = `${ing.namespace}/${tls.secretName}`
        usage[key] = (usage[key] ?? 0) + 1
      }
    }
    return usage
  }, [ingressData.ingresses])

  // LimitRange compliance: count BestEffort pods in namespaces that have a LimitRange
  const limitRangeCompliance = useMemo(() => {
    const nsWithLR = new Set(quotasData.limitranges.map((lr: LimitRange) => lr.namespace))
    const beByNs: Record<string, number> = {}
    for (const pod of (podsData.pods as any[])) {
      if (nsWithLR.has(pod.namespace) && pod.qosClass === 'BestEffort') {
        beByNs[pod.namespace] = (beByNs[pod.namespace] ?? 0) + 1
      }
    }
    return beByNs
  }, [podsData.pods, quotasData.limitranges])

  // Per-namespace summary: pod counts + workload counts + service counts
  const nsSummary = useMemo(() => {
    const s: Record<string, { podTotal: number; podRunning: number; depCount: number; stsCount: number; dsCount: number; svcCount: number }> = {}
    const get = (ns: string) => (s[ns] ??= { podTotal: 0, podRunning: 0, depCount: 0, stsCount: 0, dsCount: 0, svcCount: 0 })
    for (const pod of (podsData.pods as any[])) { get(pod.namespace).podTotal++; if (pod.status === 'Running') get(pod.namespace).podRunning++ }
    for (const d of workloadsData.deployments  as K8sDeployment[])  { get(d.namespace).depCount++   }
    for (const st of workloadsData.statefulsets as K8sStatefulSet[]) { get(st.namespace).stsCount++  }
    for (const ds of workloadsData.daemonsets  as K8sDaemonSet[])   { get(ds.namespace).dsCount++   }
    for (const svc of networkData.services      as K8sService[])     { get(svc.namespace).svcCount++ }
    return s
  }, [podsData.pods, workloadsData.deployments, workloadsData.statefulsets, workloadsData.daemonsets, networkData.services])

  // Cross-cutting policy analysis
  const policyInsights = useMemo(() => {
    const nsList = quotasData.namespaces as K8sNamespace[]
    const SYSNS  = new Set(['kube-system', 'kube-public', 'kube-node-lease'])
    const userNs = nsList.filter(ns => !SYSNS.has(ns.name))
    const totalNs = userNs.length

    const psaCounts = { restricted: 0, baseline: 0, privileged: 0, none: 0 }
    for (const ns of userNs) {
      const lvl = ns.labels?.['pod-security.kubernetes.io/enforce']
      if      (lvl === 'restricted') psaCounts.restricted++
      else if (lvl === 'baseline')   psaCounts.baseline++
      else if (lvl === 'privileged') psaCounts.privileged++
      else                           psaCounts.none++
    }

    const nsWithNP    = new Set((netpolData.policies as K8sNetworkPolicy[]).map(np => np.namespace))
    const isolatedNs  = userNs.filter(ns => nsWithNP.has(ns.name)).length
    const openNamespaces = userNs.filter(ns => !nsWithNP.has(ns.name)).map(ns => ns.name)

    // Namespaces with a default-deny policy (wildcard podSelector + empty ingress or egress rules)
    const defaultDenyNs = new Set<string>()
    for (const np of (netpolData.policies as K8sNetworkPolicy[])) {
      if (Object.keys(np.podSelector ?? {}).length !== 0) continue
      const hasIngressDeny = (np.policyTypes ?? []).includes('Ingress') && (np.ingress?.length ?? 0) === 0
      const hasEgressDeny  = (np.policyTypes ?? []).includes('Egress')  && (np.egress?.length  ?? 0) === 0
      if (hasIngressDeny || hasEgressDeny) defaultDenyNs.add(np.namespace)
    }
    const defaultDenyCoverage = userNs.filter(ns => defaultDenyNs.has(ns.name)).length

    const nsWithQuota  = new Set((quotasData.quotas as ResourceQuota[]).map(q => q.namespace))
    const quotaCoverage = userNs.filter(ns => nsWithQuota.has(ns.name)).length
    const uncappedNamespaces = userNs.filter(ns => !nsWithQuota.has(ns.name)).map(ns => ns.name)

    const nsWithLR   = new Set((quotasData.limitranges as LimitRange[]).map(lr => lr.namespace))
    const lrCoverage = userNs.filter(ns => nsWithLR.has(ns.name)).length

    const highUtilNs = (quotasData.quotas as ResourceQuota[]).filter(q => [
      q.cpuRequestLimit > 0 ? q.cpuRequestUsed / q.cpuRequestLimit : 0,
      q.memRequestLimit > 0 ? q.memRequestUsed / q.memRequestLimit : 0,
      q.podLimit        > 0 ? q.podUsed        / q.podLimit        : 0,
    ].some(p => p > 0.8)).map(q => q.namespace)

    const matchesPDB = (ns: string, sel: Record<string, string>) =>
      (workloadsData.pdbs as K8sPDB[]).some(pdb =>
        pdb.namespace === ns && Object.keys(pdb.selector).length > 0 &&
        Object.entries(pdb.selector).every(([k, v]) => sel[k] === v)
      )
    const userDeploys = (workloadsData.deployments as any[]).filter(d => !SYSNS.has(d.namespace))
    const userSTS     = (workloadsData.statefulsets as any[]).filter(s => !SYSNS.has(s.namespace))
    const totalWorkloads = userDeploys.length + userSTS.length
    const workloadsWithoutPDB = [
      ...userDeploys.filter(d => !matchesPDB(d.namespace, d.selector ?? {})).map(d => ({ ns: d.namespace, name: d.name, kind: 'Deploy' as const })),
      ...userSTS.filter(s    => !matchesPDB(s.namespace, s.selector ?? {})).map(s => ({ ns: s.namespace, name: s.name, kind: 'STS'    as const })),
    ]
    const workloadCoveredByPDB = totalWorkloads - workloadsWithoutPDB.length

    return { totalNs, psaCounts, isolatedNs, defaultDenyCoverage,
             quotaCoverage, lrCoverage,
             openNamespaces, uncappedNamespaces, highUtilNs,
             workloadsWithoutPDB, workloadCoveredByPDB, totalWorkloads }
  }, [quotasData.namespaces, quotasData.quotas, quotasData.limitranges,
      netpolData.policies, workloadsData.deployments, workloadsData.statefulsets, workloadsData.pdbs])

  // RBAC risk analysis
  const rbacInsights = useMemo(() => {
    const allRoles    = [...securityData.roles, ...securityData.clusterRoles] as K8sRole[]
    const allBindings = [...securityData.roleBindings, ...securityData.clusterRoleBindings] as K8sRoleBinding[]

    const clusterAdminBindings = allBindings.filter(rb => rb.roleRef.name === 'cluster-admin')

    const wildcardRoles = allRoles.filter(r =>
      r.rules.some(rule => rule.verbs.includes('*') || rule.resources.includes('*'))
    )
    const secretRoles = allRoles.filter(r =>
      r.rules.some(rule =>
        (rule.resources.includes('secrets') || rule.resources.includes('*')) &&
        rule.verbs.some((v: string) => ['get', 'list', 'watch', '*'].includes(v))
      )
    )
    const boundRoleNames = new Set(allBindings.map(rb => rb.roleRef.name))
    const orphanedRoles  = allRoles.filter(r => !boundRoleNames.has(r.name))

    // Privilege escalation: roles that can impersonate, escalate, or bind
    const PRIV_ESC_VERBS = new Set(['impersonate', 'escalate', 'bind'])
    const escalationRoles = allRoles.filter(r =>
      r.rules.some(rule => rule.verbs.some((v: string) => PRIV_ESC_VERBS.has(v)))
    )

    // Service account ? bound-role count + binding details
    const saBoundCount: Record<string, number> = {}
    const saBindings: Record<string, { bindingName: string; roleName: string; roleKind: string; bindingNs?: string }[]> = {}
    for (const rb of allBindings) {
      for (const subj of rb.subjects) {
        if (subj.kind === 'ServiceAccount') {
          const key = `${subj.namespace ?? ''}/${subj.name}`
          saBoundCount[key] = (saBoundCount[key] ?? 0) + 1
          if (!saBindings[key]) saBindings[key] = []
          saBindings[key].push({ bindingName: rb.name, roleName: rb.roleRef.name, roleKind: rb.roleRef.kind, bindingNs: rb.namespace })
        }
      }
    }

    // Unused SAs: no bindings referencing them, and not a default SA
    const unusedSAs = (securityData.serviceAccounts as K8sServiceAccount[]).filter(sa => {
      const key = `${sa.namespace}/${sa.name}`
      return (saBoundCount[key] ?? 0) === 0 && sa.name !== 'default'
    })

    return { clusterAdminBindings, wildcardRoles, secretRoles, escalationRoles,
             orphanedRoles, unusedSAs, saBoundCount, saBindings,
             totalRoles: allRoles.length, totalBindings: allBindings.length,
             totalSAs: (securityData.serviceAccounts as K8sServiceAccount[]).length }
  }, [securityData.roles, securityData.clusterRoles, securityData.roleBindings, securityData.clusterRoleBindings, securityData.serviceAccounts])

  // "Who can do X" ? traverse bindings ? roles ? rules
  const whoCanResults = useMemo(() => {
    if (!whoCanVerb.trim() && !whoCanResource.trim()) return []
    const allRolesArr    = [...securityData.roles, ...securityData.clusterRoles] as K8sRole[]
    const allBindingsArr = [...securityData.roleBindings, ...securityData.clusterRoleBindings] as K8sRoleBinding[]
    const clusterRoleMap = new Map<string, K8sRole>()
    const roleMap        = new Map<string, K8sRole>()
    for (const r of allRolesArr) {
      if (r.isCluster) clusterRoleMap.set(r.name, r)
      else roleMap.set(`${r.namespace}/${r.name}`, r)
    }
    const verbQ = whoCanVerb.trim().toLowerCase()
    const resQ  = whoCanResource.trim().toLowerCase()
    function roleAllows(role: K8sRole): boolean {
      return role.rules.some(rule => {
        const verbOk = !verbQ || rule.verbs.some(v => v === '*' || v.toLowerCase() === verbQ)
        const resOk  = !resQ  || rule.resources.some(r => r === '*' || r.toLowerCase() === resQ)
        return verbOk && resOk
      })
    }
    const results: { subject: string; kind: string; via: string; bindingNs?: string }[] = []
    const seen = new Set<string>()
    for (const binding of allBindingsArr) {
      if (whoCanNs && binding.namespace && binding.namespace !== whoCanNs) continue
      let role: K8sRole | undefined
      if (binding.roleRef.kind === 'ClusterRole') role = clusterRoleMap.get(binding.roleRef.name)
      else role = roleMap.get(`${binding.namespace}/${binding.roleRef.name}`)
      if (!role || !roleAllows(role)) continue
      for (const subj of binding.subjects) {
        const key = `${subj.kind}/${subj.name}/${subj.namespace ?? ''}`
        if (!seen.has(key)) {
          seen.add(key)
          results.push({ subject: subj.name, kind: subj.kind, via: `${binding.name} ? ${role.name}`, bindingNs: binding.namespace })
        }
      }
    }
    return results
  }, [whoCanVerb, whoCanResource, whoCanNs, securityData.roles, securityData.clusterRoles, securityData.roleBindings, securityData.clusterRoleBindings])

  const parseCpu = (s?: string | null): number | null => {
    if (!s) return null
    if (s.endsWith('m')) return parseInt(s) / 1000
    return parseFloat(s)
  }
  const parseMem = (s?: string | null): number | null => {
    if (!s) return null
    if (s.endsWith('Ki')) return parseInt(s) * 1024
    if (s.endsWith('Mi')) return parseInt(s) * 1024 * 1024
    if (s.endsWith('Gi')) return parseInt(s) * 1024 * 1024 * 1024
    if (s.endsWith('Ti')) return parseInt(s) * 1024 * 1024 * 1024 * 1024
    if (s.endsWith('k'))  return parseInt(s) * 1000
    if (s.endsWith('M'))  return parseInt(s) * 1000 * 1000
    if (s.endsWith('G'))  return parseInt(s) * 1000 * 1000 * 1000
    return parseInt(s)
  }

  const filteredPods = useMemo(() => {
    const searched = allPods.filter(p => {
      const q = search.toLowerCase()
      const matchText = !search ||
        p.name.toLowerCase().includes(q) ||
        p.namespace.toLowerCase().includes(q) ||
        p.nodeName.toLowerCase().includes(q)
      const matchStatus = !statusFilter ||
        (statusFilter === 'Running'   && p.status === 'Running') ||
        (statusFilter === 'Pending'   && p.status === 'Pending') ||
        (statusFilter === 'CrashLoop' && p.status === 'CrashLoopBackOff') ||
        (statusFilter === 'OOMKilled' && (p.status === 'OOMKilled' || !!p.oomKilled)) ||
        (statusFilter === 'Evicted'   && p.status === 'Evicted') ||
        (statusFilter === 'Degraded'  && p.status === 'Degraded') ||
        (statusFilter === 'Failed'    && p.status === 'Failed') ||
        (statusFilter === 'Other'     && !['Running','Pending','CrashLoopBackOff','OOMKilled','Evicted','Succeeded','Degraded','Failed'].includes(p.status))
      const matchNs   = !nsFilter   || p.namespace === nsFilter
      const matchNode = !nodeFilter || p.nodeName  === nodeFilter
      return matchText && matchStatus && matchNs && matchNode
    })
    searched.sort((a, b) => {
      let cmp = 0
      if      (sortCol === 'name')      cmp = a.name.localeCompare(b.name)
      else if (sortCol === 'namespace') cmp = a.namespace.localeCompare(b.namespace)
      else if (sortCol === 'status')    cmp = a.status.localeCompare(b.status)
      else if (sortCol === 'node')      cmp = a.nodeName.localeCompare(b.nodeName)
      else if (sortCol === 'restarts')  cmp = a.restarts - b.restarts
      else if (sortCol === 'cpu')       cmp = (a.cpuUsageCores ?? -1) - (b.cpuUsageCores ?? -1)
      else if (sortCol === 'mem')       cmp = (a.memUsageBytes ?? -1) - (b.memUsageBytes ?? -1)
      else if (sortCol === 'age')       cmp = new Date(a.age).getTime() - new Date(b.age).getTime()
      return sortDir === 'asc' ? cmp : -cmp
    })
    return searched
  }, [allPods, search, statusFilter, sortCol, sortDir, nsFilter, nodeFilter])

  const totalPods = allPods.length
  const runningPods = allPods.filter(p => p.status === 'Running').length

  // Cluster-level resource aggregation from live nodes data
  const clusterCpuCores = (nodesData.nodes as any[]).reduce((a, n) => a + (n.cpuCapacity ?? 0), 0)
  const clusterCpuUsed = (nodesData.nodes as any[]).reduce((a, n) => a + (n.cpuUsed ?? 0), 0)
  const clusterMemTotalGi = (nodesData.nodes as any[]).reduce((a, n) => a + (n.memoryCapacity ?? 0), 0)
  const clusterMemUsedGi = (nodesData.nodes as any[]).reduce((a, n) => a + (n.memoryUsed ?? 0), 0)
  const clusterStatus: 'healthy' | 'degraded' | 'unknown' = nodesData.nodes.length === 0
    ? 'unknown'
    : (nodesData.nodes as any[]).every(n => n.status === 'Ready') ? 'healthy' : 'degraded'

  const liveForTab: Record<Tab, boolean> = {
    Clusters: nodesLive,
    Pods: podsLive,
    Workloads: workloadsLive,
    Services: networkLive,
    Policy: quotasLive,
    RBAC: securityLive,
  }

  // Build live cluster entry from real-time data for fleet table
  const liveClusterEntry = useMemo<K8sCluster>(() => ({
    id: activeCluster?.id ?? clusterMeta.id,
    name: clusterMeta.name,
    provider: clusterMeta.provider as any,
    region: clusterMeta.region,
    version: clusterMeta.version,
    status: clusterStatus,
    nodeCount: nodesData.nodes.length,
    podCount: totalPods,
    namespaceCount: clusterMeta.namespaceCount,
    cpuCapacity: clusterCpuCores,
    cpuUsed: clusterCpuUsed,
    memoryCapacity: clusterMemTotalGi,
    memoryUsed: clusterMemUsedGi,
    storageCapacity: 0, storageUsed: 0, networkInMbps: 0, networkOutMbps: 0,
    createdAt: activeCluster?.createdAt ?? clusterMeta.id,
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }), [clusterMeta.name, clusterMeta.provider, clusterMeta.region, clusterMeta.version, clusterMeta.namespaceCount, clusterStatus, nodesData.nodes.length, totalPods, clusterCpuCores, clusterCpuUsed, clusterMemTotalGi, clusterMemUsedGi])

  const fleetClusters = useMemo(
    () => [liveClusterEntry, ...clusters.filter(c => c.id !== liveClusterEntry.id && c.name !== liveClusterEntry.name)],
    [liveClusterEntry, clusters],
  )

  return (
    <>
    <div className="flex flex-col h-full">
      {/* Header */}
      <div className="flex items-center justify-between px-3 sm:px-6 py-3 sm:py-4 border-b border-surface-800">
        <div>
          <h1 className="text-lg font-bold text-white flex items-center gap-2">
            <Boxes className="w-5 h-5 text-brand-400" /> Kubernetes
          </h1>
          <p className="text-xs text-surface-500 mt-0.5">
            {nodesData.nodes.length} nodes {'?'} {totalPods} pods ({runningPods} running)
          </p>
        </div>
        <div className="flex items-center gap-2">
          <div className="relative">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-surface-500" />
            <input
              value={search}
              onChange={e => setSearch(e.target.value)}
              placeholder="Filter pods, namespaces, nodes..."
              className="w-60 bg-surface-800 border border-surface-700 rounded-xl pl-8 pr-3 py-1.5 text-sm text-white placeholder-surface-500 outline-none focus:border-brand-500"
            />
          </div>
          <button
            onClick={refreshPods}
            className="w-8 h-8 flex items-center justify-center bg-surface-800 hover:bg-surface-700 border border-surface-700 rounded-xl text-surface-400 hover:text-white transition-all"
          >
            <RefreshCw className="w-3.5 h-3.5" />
          </button>
          {podsErr && (
            <span className="flex items-center gap-1.5 px-2.5 py-1 bg-warning/5 border border-warning/20 rounded-xl text-xs text-warning/80">
              <AlertTriangle className="w-3 h-3" /> {podsErr}
            </span>
          )}
        </div>
      </div>

      {/* Cluster summary row */}
      <div className="flex gap-3 px-3 sm:px-6 py-3 border-b border-surface-800 overflow-x-auto scrollbar-none">
        <div className="flex items-center gap-2 px-3 py-2 rounded-xl bg-surface-900 border border-surface-800 flex-shrink-0 hover:border-brand-500/40 cursor-pointer transition-all" onClick={() => { setTab('Clusters'); router.replace(`?tab=Clusters`, { scroll: false }) }}>
          <StatusDot status={clusterStatus} />
          <span className="text-xs font-medium text-white">{clusterMeta.name}</span>
          <span className="text-2xs text-surface-500">{nodesData.nodes.length || '?'}n ? {totalPods || '?'}p</span>
          {(nodesLive || clusterMetaLive) && <LiveDot live />}
        </div>
      </div>

      {/* Tabs */}
      <div className="flex items-center gap-1 px-3 sm:px-6 pt-2 sm:pt-3 border-b border-surface-800 overflow-x-auto scrollbar-none flex-shrink-0">
        {TABS.map(t => (
          <button
            key={t}
            onClick={() => { setTab(t); router.replace(`?tab=${encodeURIComponent(t)}`, { scroll: false }) }}
            className={cn('px-3 py-2 text-sm font-medium border-b-2 transition-all flex items-center gap-1.5',
              tab === t ? 'border-brand-500 text-brand-400' : 'border-transparent text-surface-400 hover:text-surface-300'
            )}
          >
            {t}
            {liveForTab[t] && <LiveDot live />}
          </button>
        ))}
      </div>

      <div className="flex-1 overflow-y-auto p-3 sm:p-6">

        {/* ?????? PODS TAB ?????? */}
        {tab === 'Pods' && (
          <div className="space-y-3">
            {/* Node topology spread mini-summary */}
            {nodesData.nodes.length > 0 && (
              <div className="rounded-2xl bg-surface-900 border border-surface-800 px-4 py-3 flex items-center gap-6 overflow-x-auto">
                <span className="text-2xs font-semibold text-surface-500 uppercase tracking-wider flex-shrink-0">Pod Spread</span>
                {(nodesData.nodes as any[]).filter(n => allPods.some(p => p.nodeName === n.name)).map(n => {
                  const count = allPods.filter(p => p.nodeName === n.name).length
                  const pct   = totalPods > 0 ? Math.round((count / totalPods) * 100) : 0
                  const isActive = nodeFilter === n.name
                  return (
                    <div key={n.name}
                      onClick={() => setNodeFilter(isActive ? null : n.name)}
                      className={cn('flex items-center gap-2 min-w-0 cursor-pointer rounded-lg px-1.5 py-0.5 transition-all', isActive ? 'bg-brand-500/20' : 'hover:bg-surface-800')}>
                      <div className={cn('w-2 h-2 rounded-full flex-shrink-0', n.status === 'Ready' ? 'bg-success' : 'bg-danger')} />
                      <span className="text-2xs font-mono text-surface-300 truncate">{n.name.replace(`${activeCluster?.name ?? ''}-`, '')}</span>
                      <div className="w-20 h-1.5 rounded-full bg-surface-800 flex-shrink-0">
                        <div className="h-full rounded-full bg-brand-500" style={{ width: `${pct}%` }} />
                      </div>
                      <span className="text-2xs text-surface-400 tabular-nums flex-shrink-0">{count}p</span>
                    </div>
                  )
                })}
                {(() => {
                  const unscheduled = allPods.filter(p => p.nodeName === '__unscheduled__').length
                  if (unscheduled === 0) return null
                  return (
                    <div className="flex items-center gap-2 min-w-0">
                      <div className="w-2 h-2 rounded-full flex-shrink-0 bg-warning" />
                      <span className="text-2xs font-mono text-warning/80">unscheduled</span>
                      <span className="text-2xs text-surface-400 tabular-nums flex-shrink-0">{unscheduled}p</span>
                    </div>
                  )
                })()}
                <span className="ml-auto text-2xs text-surface-600">{totalPods} total</span>
              </div>
            )}
            <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
            {/* Toolbar: status chips + export */}
            <div className="px-4 py-3 border-b border-surface-800 flex flex-wrap items-center gap-2">
              <span className="text-sm font-semibold text-white flex items-center gap-2 mr-2">
                <Activity className="w-4 h-4 text-brand-400" /> Pods
                <span className="text-2xs text-surface-500 font-normal">
                  {filteredPods.length}{filteredPods.length !== totalPods ? ` of ${totalPods}` : ''} total {'?'} {runningPods} running
                </span>
              </span>
              <select
                value={nsFilter ?? ''}
                onChange={e => setNsFilter(e.target.value || null)}
                className="h-6 px-1.5 bg-surface-800 border border-surface-700 rounded-lg text-2xs text-surface-300 outline-none focus:border-brand-500 cursor-pointer"
              >
                <option value="">All namespaces</option>
                {podNamespaces.map(ns => <option key={ns} value={ns}>{ns}</option>)}
              </select>
              {([
                { key: null,        label: 'All',       color: 'bg-surface-700 text-surface-300',  active: 'bg-surface-500 text-white',     count: totalPods              },
                { key: 'Running',   label: 'Running',   color: 'bg-surface-800 text-surface-400',  active: 'bg-success text-black',         count: statusCounts.Running   },
                { key: 'Degraded',  label: 'Degraded',  color: 'bg-surface-800 text-surface-400',  active: 'bg-yellow-600 text-white',      count: statusCounts.Degraded  },
                { key: 'Pending',   label: 'Pending',   color: 'bg-surface-800 text-surface-400',  active: 'bg-warning text-black',         count: statusCounts.Pending   },
                { key: 'CrashLoop', label: 'CrashLoop', color: 'bg-surface-800 text-surface-400',  active: 'bg-danger text-white',          count: statusCounts.CrashLoop },
                { key: 'OOMKilled', label: 'OOMKilled', color: 'bg-surface-800 text-surface-400',  active: 'bg-red-700 text-white',         count: statusCounts.OOMKilled },
                { key: 'Evicted',   label: 'Evicted',   color: 'bg-surface-800 text-surface-400',  active: 'bg-orange-600 text-white',      count: statusCounts.Evicted   },
                { key: 'Failed',    label: 'Failed',    color: 'bg-surface-800 text-surface-400',  active: 'bg-danger text-white',          count: statusCounts.Failed    },
                { key: 'Other',     label: 'Other Err', color: 'bg-surface-800 text-surface-400',  active: 'bg-surface-500 text-white',     count: statusCounts.Other     },
              ] as const).filter(c => c.key === null || c.count > 0).map(chip => (
                <button key={String(chip.key)}
                  onClick={() => setStatusFilter(statusFilter === chip.key ? null : chip.key as string | null)}
                  className={cn('px-2.5 py-1 rounded-full text-2xs font-semibold transition-all flex items-center gap-1 border border-transparent',
                    statusFilter === chip.key ? chip.active : `${chip.color} hover:border-surface-600`
                  )}>
                  {chip.label}
                  {chip.count > 0 && <span className="opacity-70 tabular-nums">{chip.count}</span>}
                </button>
              ))}
              {nsFilter && (
                <button
                  onClick={() => setNsFilter(null)}
                  className="px-2.5 py-1 rounded-full text-2xs font-semibold bg-brand-500/20 text-brand-300 border border-brand-500/30 flex items-center gap-1 hover:bg-brand-500/30 transition-all"
                >
                  ns: {nsFilter} <X className="w-3 h-3" />
                </button>
              )}
              {nodeFilter && (
                <button
                  onClick={() => setNodeFilter(null)}
                  className="px-2.5 py-1 rounded-full text-2xs font-semibold bg-purple-500/20 text-purple-300 border border-purple-500/30 flex items-center gap-1 hover:bg-purple-500/30 transition-all"
                >
                  node: {nodeFilter.replace(`${activeCluster?.name ?? ''}-`, '')} <X className="w-3 h-3" />
                </button>
              )}
              {statusFilter === 'Evicted' && statusCounts.Evicted > 0 && (
                <button
                  onClick={handleDeleteAllEvicted}
                  disabled={deletingEvicted}
                  className="flex items-center gap-1 px-2.5 py-1 rounded-full text-2xs font-semibold bg-danger/10 text-danger border border-danger/20 hover:bg-danger/20 transition-all disabled:opacity-50"
                >
                  {deletingEvicted ? <Loader2 className="w-3 h-3 animate-spin" /> : <Trash2 className="w-3 h-3" />}
                  Delete all evicted
                </button>
              )}
              <button
                onClick={() => exportCSV(filteredPods.map(p => ({ pod: p.name, namespace: p.namespace, status: p.status, node: p.nodeName, restarts: p.restarts, cpu: fmtCpu(p.cpuUsageCores), mem: fmtMem(p.memUsageBytes), age: p.age })), 'pods.csv')}
                className="ml-auto flex items-center gap-1.5 px-2.5 py-1.5 bg-surface-800 hover:bg-surface-700 border border-surface-700 rounded-lg text-xs text-surface-400 hover:text-white transition-all"
              >
                <Download className="w-3 h-3" /> CSV
              </button>
            </div>
            <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="border-b border-surface-800 bg-surface-950">
                  {([
                    { key: 'name',      label: 'Pod'       },
                    { key: 'namespace', label: 'Namespace' },
                    { key: 'status',    label: 'Status'    },
                    { key: 'node',      label: 'Node'      },
                    { key: null,        label: 'Ready'     },
                    { key: 'restarts',  label: 'Restarts'  },
                    { key: 'cpu',       label: 'CPU'       },
                    { key: 'mem',       label: 'Mem'       },
                    { key: 'age',       label: 'Age'       },
                    { key: null,        label: ''          },
                  ] as const).map((h, i) => h.key ? (
                    <th key={h.key}
                      onClick={() => { if (sortCol === h.key) setSortDir(d => d === 'asc' ? 'desc' : 'asc'); else { setSortCol(h.key as any); setSortDir('asc') } }}
                      className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider cursor-pointer hover:text-surface-300 select-none">
                      <span className="flex items-center gap-1">
                        {h.label}
                        <span className="text-surface-600">{sortCol === h.key ? (sortDir === 'asc' ? '?' : '?') : '?'}</span>
                      </span>
                    </th>
                  ) : (
                    <th key={i} className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h.label}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {filteredPods.map(pod => {
                  const isRunning   = pod.status === 'Running'
                  const isSucceeded = pod.status === 'Succeeded'
                  const isFailed    = pod.status === 'Failed'
                  const isOOM      = pod.status === 'OOMKilled' || pod.oomKilled
                  const isCrash    = pod.status === 'CrashLoopBackOff'
                  const isPending  = pod.status === 'Pending'
                  const isEvicted  = pod.status === 'Evicted'
                  const isImageErr = pod.status === 'ImagePullBackOff' || pod.status === 'ErrImagePull'
                  const ago = Math.round((Date.now() - new Date(pod.age).getTime()) / 60000)
                  const ageStr = ago < 60 ? `${ago}m` : ago < 1440 ? `${Math.round(ago / 60)}h` : `${Math.round(ago / 1440)}d`
                  const podKey = `${pod.namespace}/${pod.name}`
                  const isExpanded = expandedPod === podKey
                  const hasInitContainers = (pod.initContainers ?? []).length > 0
                  const hasSpike = (pod.restartsLast10m ?? 0) > 0
                  return (
                    <Fragment key={podKey}>
                      <tr
                        onClick={() => setExpandedPod(isExpanded ? null : podKey)}
                        className={cn('border-b border-surface-800/50 hover:bg-surface-800/40 cursor-pointer transition-colors',
                          isOOM && 'bg-red-950/30',
                        )}
                      >
                        <td className="px-4 py-2.5 font-mono text-xs text-white max-w-[200px]">
                          <div className="flex items-center gap-1.5">
                            {isExpanded ? <ChevronDown className="w-3 h-3 text-brand-400 flex-shrink-0" /> : <ChevronRight className="w-3 h-3 text-surface-500 flex-shrink-0" />}
                            <span className="truncate" title={pod.name}>{pod.name}</span>
                            {hasInitContainers && <span className="text-2xs text-purple-400 flex-shrink-0" title="Has init containers">[i]</span>}
                          </div>
                        </td>
                        <td className="px-4 py-2.5 text-surface-400 text-xs">{pod.namespace}</td>
                        <td className="px-4 py-2.5">
                          <div className="flex items-center gap-1.5">
                            {isOOM ? (
                              <span className="text-2xs px-2 py-0.5 rounded-full font-semibold bg-red-900/40 text-red-300 border border-red-700/40">OOMKilled</span>
                            ) : isCrash ? (
                              <span className="text-2xs px-2 py-0.5 rounded-full font-semibold bg-danger/10 text-danger border border-danger/20 animate-pulse">CrashLoop</span>
                            ) : isEvicted ? (
                              <span className="text-2xs px-2 py-0.5 rounded-full font-semibold bg-orange-900/40 text-orange-300 border border-orange-700/40">Evicted</span>
                            ) : isImageErr ? (
                              <span className="text-2xs px-2 py-0.5 rounded-full font-semibold bg-warning/10 text-warning border border-warning/20">ImagePull</span>
                            ) : isPending ? (
                              <span className="text-2xs px-2 py-0.5 rounded-full font-semibold bg-warning/10 text-warning border border-warning/20">{pod.status}</span>
                            ) : isSucceeded ? (
                              <span className="text-2xs px-2 py-0.5 rounded-full font-semibold bg-surface-700 text-surface-400 border border-surface-600">Succeeded</span>
                            ) : isFailed ? (
                              <span className="text-2xs px-2 py-0.5 rounded-full font-semibold bg-danger/10 text-danger border border-danger/20">Failed</span>
                            ) : (
                              <span className={cn('text-2xs px-2 py-0.5 rounded-full font-semibold',
                                isRunning ? 'bg-success/10 text-success' : 'bg-danger/10 text-danger',
                              )}>{pod.status}</span>
                            )}
                            {isPending && pod.schedulingFailureReason && (
                              <span className="text-2xs text-warning" title={pod.schedulingFailureReason}>&#x26A0;</span>
                            )}
                          </div>
                        </td>
                        <td className="px-4 py-2.5 text-surface-500 text-xs font-mono">{pod.nodeName.replace(`${activeCluster?.name ?? ''}-`, '')}</td>
                        <td className="px-4 py-2.5 text-surface-400 text-xs tabular-nums">{isSucceeded || isFailed ? <span className="text-surface-600">?</span> : pod.ready}</td>
                        <td className="px-4 py-2.5">
                          <div className="flex items-center gap-1.5">
                            <span className={cn('tabular-nums text-xs font-semibold', pod.restarts > 5 ? 'text-danger' : pod.restarts > 0 ? 'text-warning' : 'text-surface-600')}>{pod.restarts}</span>
                            {hasSpike && (
                              <span className="text-danger text-xs" title={`+${pod.restartsLast10m} restarts in last 10m`}>&#x1F525;</span>
                            )}
                          </div>
                        </td>
                        <td className="px-4 py-2.5 font-mono text-xs tabular-nums text-surface-400">
                          {pod.cpuUsageCores != null ? fmtCpu(pod.cpuUsageCores) : <span className="text-surface-700">?</span>}
                        </td>
                        <td className="px-4 py-2.5 font-mono text-xs tabular-nums text-surface-400">
                          {pod.memUsageBytes != null ? fmtMem(pod.memUsageBytes) : <span className="text-surface-700">?</span>}
                        </td>
                        <td className="px-4 py-2.5 text-surface-500 text-xs">
                          <div className="flex items-center gap-1.5">
                            <span>{ageStr}</span>
                            {pod.qosClass && (
                              <span className={cn('text-2xs px-1 py-0.5 rounded font-semibold',
                                pod.qosClass === 'Guaranteed' ? 'bg-success/10 text-success' :
                                pod.qosClass === 'Burstable'  ? 'bg-amber-500/10 text-amber-400' :
                                'bg-danger/10 text-danger'
                              )} title={`QoS: ${pod.qosClass}`}>{pod.qosClass[0]}</span>
                            )}
                            {(() => {
                              const img = pod.containers?.[0]?.image ?? ''
                              const reg = img.includes('/') ? img.split('/')[0]! : 'docker.io'
                              const isPrivate = reg !== 'docker.io' && !reg.includes('gcr.io') && !reg.includes('ghcr.io') && !reg.includes('quay.io') && !reg.includes('k8s.gcr.io') && !reg.includes('registry.k8s.io')
                              const label = reg === 'docker.io' ? 'hub' : reg.includes('gcr.io') ? 'gcr' : reg.includes('ghcr.io') ? 'ghcr' : reg.includes('quay.io') ? 'quay' : reg.includes('registry.k8s.io') || reg.includes('k8s.gcr.io') ? 'k8s' : reg.split('.')[0]!
                              if (!img) return null
                              return <span className={cn('text-2xs px-1 py-0.5 rounded font-mono', isPrivate ? 'bg-purple-500/10 text-purple-400' : 'bg-surface-700 text-surface-500')} title={reg}>{label}</span>
                            })()}
                          </div>
                        </td>
                        <td className="px-4 py-2.5" onClick={e => e.stopPropagation()}>
                          <div className="flex items-center gap-1">
                            {(isCrash || isOOM || pod.restarts > 5) && /^.+-[a-z0-9]{9,10}-[a-z0-9]{5}$/.test(pod.name) && (
                              <button onClick={() => setCrashFix({ pod: pod.name, namespace: pod.namespace })}
                                className="flex items-center gap-1 px-2 py-1 rounded-lg bg-danger/10 hover:bg-danger/20 border border-danger/20 text-danger text-2xs font-semibold transition-all"
                                title="Quick fix ? restart deployment">
                                <Zap className="w-3 h-3" /> Fix
                              </button>
                            )}
                            <button onClick={() => setLogTarget({ pod: pod.name, namespace: pod.namespace })}
                              className="p-1.5 rounded-lg text-surface-600 hover:text-brand-300 hover:bg-brand-400/10 transition-all" title="View logs">
                              <ScrollText className="w-3.5 h-3.5" />
                            </button>
                            <button onClick={() => setExecTarget({ pod: pod.name, namespace: pod.namespace })}
                              className="p-1.5 rounded-lg text-surface-600 hover:text-success hover:bg-success/10 transition-all" title="Open terminal">
                              <TerminalSquare className="w-3.5 h-3.5" />
                            </button>
                            <button onClick={() => setDescribeTarget({ kind: 'Pod', namespace: pod.namespace, name: pod.name })}
                              className="p-1.5 rounded-lg text-surface-600 hover:text-amber-400 hover:bg-amber-400/10 transition-all" title="Describe">
                              <FileSearch className="w-3.5 h-3.5" />
                            </button>
                            <button onClick={() => setYamlTarget({ kind: 'Pod', namespace: pod.namespace, name: pod.name })}
                              className="p-1.5 rounded-lg text-surface-600 hover:text-brand-400 hover:bg-brand-400/10 transition-all" title="View YAML">
                              <FileCode2 className="w-3.5 h-3.5" />
                            </button>
                            <button onClick={() => setDeletePod({ namespace: pod.namespace, name: pod.name })}
                              className="p-1.5 rounded-lg text-surface-600 hover:text-danger hover:bg-danger/10 transition-all" title="Delete pod">
                              <Trash2 className="w-3.5 h-3.5" />
                            </button>
                          </div>
                        </td>
                      </tr>
                      {isExpanded && (
                        <tr key={`${podKey}-expand`} className="bg-surface-950">
                          <td colSpan={10} className="px-6 py-3 border-b border-surface-700">
                            <div className="space-y-3">
                              {/* Pod metadata strip */}
                              <div className="flex flex-wrap items-center gap-3 text-2xs text-surface-500 pb-2 border-b border-surface-800">
                                {pod.podIP && <span>IP: <span className="font-mono text-surface-300">{pod.podIP}</span></span>}
                                {pod.qosClass && (
                                  <span className={cn('flex items-center gap-1 px-2 py-0.5 rounded-full border font-semibold',
                                    pod.qosClass === 'Guaranteed' ? 'bg-success/10 border-success/20 text-success' :
                                    pod.qosClass === 'Burstable'  ? 'bg-amber-500/10 border-amber-500/20 text-amber-400' :
                                    'bg-danger/10 border-danger/20 text-danger'
                                  )}>QoS: {pod.qosClass}</span>
                                )}
                                {pod.schedulingFailureReason && (
                                  <span className="flex items-center gap-1 px-2 py-0.5 rounded-full bg-warning/10 border border-warning/20 text-warning font-semibold max-w-xs truncate" title={pod.schedulingFailureReason}>
                                    ? Scheduling: {pod.schedulingFailureReason}
                                  </span>
                                )}
                                {pod.pdbName
                                  ? <span className="flex items-center gap-1 px-2 py-0.5 rounded-full bg-success/10 border border-success/20 text-success font-semibold">
                                      <Shield className="w-3 h-3" /> PDB: {pod.pdbName}
                                    </span>
                                  : <span className="flex items-center gap-1 px-2 py-0.5 rounded-full bg-surface-700 border border-surface-600 text-surface-400">
                                      <Shield className="w-3 h-3 text-surface-600" /> No PDB
                                    </span>
                                }
                                {(pod.topologySpreadConstraints ?? []).length > 0 && (
                                  <span className="flex items-center gap-1">
                                    Spread:
                                    {(pod.topologySpreadConstraints ?? []).map((t, i) => (
                                      <span key={i} className="bg-surface-800 rounded px-1.5 py-0.5 font-mono text-brand-300">
                                        {t.topologyKey} maxSkew={t.maxSkew}
                                      </span>
                                    ))}
                                  </span>
                                )}
                                {pod.labels && Object.keys(pod.labels).length > 0 && (
                                  <span className="flex items-center gap-1 flex-wrap">
                                    Labels:
                                    {Object.entries(pod.labels).slice(0, 4).map(([k, v]) => (
                                      <span key={k} className="bg-surface-800 rounded px-1.5 py-0.5 font-mono text-brand-300">{k}={v}</span>
                                    ))}
                                  </span>
                                )}
                              </div>
                              {/* Scheduling Config: tolerations + nodeSelector */}
                              {((pod.tolerations ?? []).filter((t: any) => t.key && !t.key.startsWith('node.kubernetes.io/')).length > 0 || Object.keys(pod.nodeSelector ?? {}).length > 0) && (
                                <div>
                                  <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                                    <span className="w-1.5 h-1.5 rounded-full bg-amber-400 inline-block" /> Scheduling Config
                                  </p>
                                  <div className="flex flex-wrap gap-1.5 text-2xs">
                                    {Object.entries(pod.nodeSelector ?? {}).map(([k, v]) => (
                                      <span key={k} className="bg-amber-500/10 border border-amber-500/20 text-amber-300 rounded px-1.5 py-0.5 font-mono">
                                        nodeSelector: {k}={String(v)}
                                      </span>
                                    ))}
                                    {(pod.tolerations ?? []).filter((t: any) => t.key && !t.key.startsWith('node.kubernetes.io/')).map((t: any, i: number) => (
                                      <span key={i} className={cn('rounded px-1.5 py-0.5 font-mono border',
                                        t.effect === 'NoSchedule'       ? 'bg-red-900/20 text-red-300 border-red-700/30' :
                                        t.effect === 'NoExecute'        ? 'bg-orange-900/20 text-orange-300 border-orange-700/30' :
                                        t.effect === 'PreferNoSchedule' ? 'bg-yellow-900/20 text-yellow-300 border-yellow-700/30' :
                                        'bg-surface-800 text-surface-400 border-surface-700'
                                      )}>
                                        tolerate: {t.key}{t.value ? `=${t.value}` : ''}{t.effect ? `:${t.effect}` : ''}
                                      </span>
                                    ))}
                                  </div>
                                </div>
                              )}
                              {/* Pod Conditions */}
                              {(pod.conditions ?? []).length > 0 && (
                                <div>
                                  <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                                    <span className="w-1.5 h-1.5 rounded-full bg-surface-500 inline-block" />
                                    Conditions
                                  </p>
                                  <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-3">
                                    {(pod.conditions ?? []).map((cond: any) => {
                                      const ok = cond.status === 'True'
                                      const unknown = cond.status === 'Unknown'
                                      const ago = cond.lastTransitionTime
                                        ? (() => { const m = Math.round((Date.now() - new Date(cond.lastTransitionTime).getTime()) / 60000); return m < 60 ? `${m}m` : m < 1440 ? `${Math.round(m/60)}h` : `${Math.round(m/1440)}d` })()
                                        : null
                                      return (
                                        <div key={cond.type} className={cn('rounded-lg px-3 py-2 border',
                                          ok ? 'bg-success/5 border-success/20' :
                                          unknown ? 'bg-surface-800 border-surface-700' :
                                          'bg-danger/5 border-danger/20'
                                        )}>
                                          <div className="flex items-center gap-1.5 mb-0.5">
                                            <span className={cn('w-1.5 h-1.5 rounded-full flex-shrink-0',
                                              ok ? 'bg-success' : unknown ? 'bg-surface-500' : 'bg-danger'
                                            )} />
                                            <span className="text-2xs font-semibold text-surface-300 truncate">{cond.type}</span>
                                          </div>
                                          {cond.reason && <p className="text-2xs text-surface-500 truncate" title={cond.message ?? ''}>{cond.reason}</p>}
                                          {ago && <p className="text-2xs text-surface-600 mt-0.5">{ago} ago</p>}
                                        </div>
                                      )
                                    })}
                                  </div>
                                </div>
                              )}

                              {/* Warning Events (lazy-loaded) */}
                              {(() => {
                                const evts = podEvents[podKey]
                                const isLoading = loadingEvents === podKey
                                const warns = (evts ?? []).filter((e: any) => e.type === 'Warning')
                                if (!evts && isLoading) return (
                                  <p className="text-2xs text-surface-600 italic mb-2">Loading events?</p>
                                )
                                if (!warns.length) return evts !== undefined ? (
                                  <p className="text-2xs text-surface-600 italic mb-2">No warning events</p>
                                ) : null
                                const visible = showAllEvents[podKey] ? warns : warns.slice(0, 6)
                                return (
                                  <div className="mb-2">
                                    <p className="text-2xs font-semibold text-warning uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                                      <span className="w-1.5 h-1.5 rounded-full bg-warning inline-block" />
                                      Warning Events ({warns.length})
                                    </p>
                                    <div className="space-y-1">
                                      {visible.map((e: any, i: number) => (
                                        <div key={i} className="bg-surface-800/80 rounded-lg px-3 py-1.5 flex items-start gap-3 text-2xs border border-surface-700/50">
                                          <span className="text-warning font-semibold flex-shrink-0 w-28 truncate" title={e.reason}>{e.reason}</span>
                                          <span className="text-surface-400 flex-1 min-w-0 truncate" title={e.message}>{e.message}</span>
                                          <span className="text-surface-600 flex-shrink-0 tabular-nums">?{e.count}</span>
                                        </div>
                                      ))}
                                    </div>
                                    {warns.length > 6 && !showAllEvents[podKey] && (
                                      <button onClick={() => setShowAllEvents(prev => ({ ...prev, [podKey]: true }))}
                                        className="text-2xs text-brand-400 hover:text-brand-300 hover:underline mt-0.5">
                                        Show all {warns.length} events
                                      </button>
                                    )}
                                  </div>
                                )
                              })()}

                              {/* Init containers */}
                              {(pod.initContainers ?? []).length > 0 && (
                                <div>
                                  <p className="text-2xs font-semibold text-purple-400 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                                    <span className="w-1.5 h-1.5 rounded-full bg-purple-400 inline-block" />
                                    Init Containers ({(pod.initContainers ?? []).length})
                                  </p>
                                  <div className="overflow-x-auto">
                                  <table className="w-full text-xs mb-2">
                                    <thead>
                                      <tr className="border-b border-surface-800">
                                        {['Name', 'Image', 'State', 'Restarts', 'Last Exit'].map(h => (
                                          <th key={h} className="px-3 py-1.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                                        ))}
                                      </tr>
                                    </thead>
                                    <tbody>
                                      {(pod.initContainers ?? []).map((c: K8sContainer) => (
                                        <tr key={c.name} className="border-b border-surface-800/30 hover:bg-surface-800/60 cursor-pointer" onClick={e => { e.stopPropagation(); setSelectedContainer({ container: c, pod: pod.name, namespace: pod.namespace }) }}>
                                          <td className="px-3 py-2 font-mono text-purple-300 font-semibold">{c.name}</td>
                                          <td className="px-3 py-2 font-mono text-surface-400 max-w-[180px] truncate" title={c.image}>{c.image.split('/').pop()}</td>
                                          <td className="px-3 py-2">
                                            <span className={cn('text-2xs px-1.5 py-0.5 rounded-full font-semibold',
                                              c.stateReason === 'Completed' || c.state === 'terminated' ? 'bg-surface-700 text-surface-400' :
                                              c.state === 'running' ? 'bg-success/10 text-success' :
                                              'bg-danger/10 text-danger',
                                            )}>{c.stateReason ?? c.state}</span>
                                          </td>
                                          <td className={cn('px-3 py-2 tabular-nums font-semibold', c.restarts > 0 ? 'text-warning' : 'text-surface-600')}>{c.restarts}</td>
                                          <td className="px-3 py-2 text-surface-500">{c.lastTerminatedReason ?? '?'}</td>
                                        </tr>
                                      ))}
                                    </tbody>
                                  </table>
                                  </div>
                                </div>
                              )}
                              {/* Regular containers */}
                              <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider flex items-center gap-1.5">
                                <span className="w-1.5 h-1.5 rounded-full bg-brand-400 inline-block" />
                                Containers ({(pod.containers ?? []).length})
                              </p>
                              <div className="overflow-x-auto">
                              <table className="w-full text-xs">
                                <thead>
                                  <tr className="border-b border-surface-800">
                                    {['Name', 'Image', 'State', 'Ready', 'Restarts', 'CPU Req/Lim', 'Mem Req/Lim', 'Ports', ''].map(h => (
                                      <th key={h} className="px-3 py-1.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                                    ))}
                                  </tr>
                                </thead>
                                <tbody>
                                  {(pod.containers ?? []).map((c: K8sContainer) => (
                                    <tr key={c.name} className="border-b border-surface-800/30 hover:bg-surface-800/60 cursor-pointer" onClick={e => { e.stopPropagation(); setSelectedContainer({ container: c, pod: pod.name, namespace: pod.namespace }) }}>
                                      <td className="px-3 py-2 font-mono text-white font-semibold">{c.name}</td>
                                      <td className="px-3 py-2 font-mono text-surface-400 max-w-[180px] truncate" title={c.image}>{c.image.split('/').pop()}</td>
                                      <td className="px-3 py-2">
                                        <div className="flex items-center gap-1">
                                          <span className={cn('text-2xs px-1.5 py-0.5 rounded-full font-semibold',
                                            c.state === 'running' ? 'bg-success/10 text-success' :
                                            c.stateReason === 'OOMKilled' || c.lastTerminatedReason === 'OOMKilled' ? 'bg-red-900/40 text-red-300 border border-red-700/40' :
                                            c.stateReason === 'CrashLoopBackOff' ? 'bg-danger/10 text-danger animate-pulse' :
                                            c.state === 'terminated' ? 'bg-danger/10 text-danger' : 'bg-warning/10 text-warning',
                                          )}>{c.stateReason ?? c.state}</span>
                                          {(c.stateReason === 'OOMKilled' || c.lastTerminatedReason === 'OOMKilled') && (
                                            <span className="text-2xs text-red-400" title="OOM exit">&#x26A0;</span>
                                          )}
                                        </div>
                                      </td>
                                      <td className="px-3 py-2 text-center">{c.ready ? <span className="text-success font-bold">&#x2713;</span> : <span className="text-danger font-bold">&#x2717;</span>}</td>
                                      <td className={cn('px-3 py-2 tabular-nums font-semibold', c.restarts > 5 ? 'text-danger' : c.restarts > 0 ? 'text-warning' : 'text-surface-600')}>{c.restarts}</td>
                                      <td className="px-3 py-2 font-mono text-surface-400">{c.cpuRequest ?? '-'} / {c.cpuLimit ?? '-'}</td>
                                      <td className="px-3 py-2 font-mono text-surface-400">{c.memRequest ?? '-'} / {c.memLimit ?? '-'}</td>
                                      <td className="px-3 py-2 font-mono text-surface-500">{c.ports.map(p => p.containerPort).join(', ') || '-'}</td>
                                      <td className="px-3 py-2 text-brand-400 text-2xs hover:underline">detail &#x2192;</td>
                                    </tr>
                                  ))}
                                </tbody>
                              </table>
                              </div>
                            </div>
                          </td>
                        </tr>
                      )}
                    </Fragment>
                  )
                })}
                {filteredPods.length === 0 && (
                  <tr><td colSpan={10} className="px-4 py-10 text-center text-surface-600 text-sm">No pods found</td></tr>
                )}
              </tbody>
            </table>
            </div>
          </div>
          </div>
        )}
        {/* ?????? CLUSTERS TAB ?????? */}
        {/* ?? CLUSTERS TAB ?? */}
        {tab === 'Clusters' && (
          <div className="space-y-4">
            {/* ?? Cluster Fleet ?? */}
            <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
              <div className="px-4 py-3 border-b border-surface-800 flex items-center justify-between">
                <div className="flex items-center gap-2">
                  <Globe className="w-4 h-4 text-brand-400" />
                  <span className="text-sm font-semibold text-white">Cluster Fleet</span>
                  <span className="text-2xs text-surface-500 ml-1">{fleetClusters.length} registered</span>
                </div>
                <button
                  onClick={() => { setConnectSuccess(false); setConnectError(null); setConnectForm({ name: '', url: '', promUrl: '', provider: 'on-prem', region: '' }); setShowConnectModal(true) }}
                  className="flex items-center gap-1.5 px-3 py-1.5 text-2xs font-semibold text-brand-400 bg-brand-500/10 hover:bg-brand-500/20 rounded-lg border border-brand-500/20 transition-all"
                >
                  <Plus className="w-3 h-3" /> Register Cluster
                </button>
              </div>
              <div className="overflow-x-auto">
                <table className="w-full text-xs">
                  <thead>
                    <tr className="border-b border-surface-800 bg-surface-950">
                      {['', 'Cluster', 'Provider', 'Region', 'Version', 'Nodes', 'Pods', 'CPU', 'Memory', 'Status', 'Probed', ''].map(h => (
                        <th key={h} className="px-3 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider whitespace-nowrap">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {fleetClusters.map((c: K8sCluster) => {
                      const connected  = c.id === (activeCluster?.id ?? liveClusterEntry.id)
                      const expanded   = selectedClusterId === c.id
                      const cpuPct     = c.cpuCapacity     > 0 ? Math.round((c.cpuUsed     / c.cpuCapacity)     * 100) : 0
                      const memPct     = c.memoryCapacity  > 0 ? Math.round((c.memoryUsed  / c.memoryCapacity)  * 100) : 0
                      const pvdLabel: Record<string, string> = { aws: 'AWS', azure: 'AZ', gcp: 'GCP', 'on-prem': 'On-Prem' }
                      const pvdColor: Record<string, string> = {
                        aws:      'text-amber-400 bg-amber-400/10 border-amber-400/20',
                        azure:    'text-blue-400 bg-blue-400/10 border-blue-400/20',
                        gcp:      'text-green-400 bg-green-400/10 border-green-400/20',
                        'on-prem':'text-brand-400 bg-brand-400/10 border-brand-400/20',
                      }
                      const probedAgo = c.lastProbed ? timeAgo(c.lastProbed) : null
                      return (
                        <Fragment key={c.id}>
                        <tr
                          onClick={() => setSelectedClusterId(expanded ? '' : c.id)}
                          className={cn(
                            'border-b border-surface-800/50 hover:bg-surface-800/40 cursor-pointer transition-colors',
                            expanded && 'bg-brand-500/5',
                          )}
                        >
                          <td className="px-3 py-3">
                            <div className={cn('w-2 h-2 rounded-full', connected ? 'bg-success' : 'bg-surface-600')} />
                          </td>
                          <td className="px-3 py-3">
                            <div className="flex items-center gap-2">
                              <span className="font-mono text-white font-medium whitespace-nowrap">{c.name}</span>
                              {connected && <LiveDot live />}
                              {!connected && <span className="text-2xs text-surface-600 italic">demo</span>}
                            </div>
                          </td>
                          <td className="px-3 py-3">
                            <span className={cn('text-2xs px-1.5 py-0.5 rounded border font-medium', pvdColor[c.provider] ?? 'text-surface-400 bg-surface-700 border-surface-600')}>
                              {pvdLabel[c.provider] ?? c.provider}
                            </span>
                          </td>
                          <td className="px-3 py-3 text-surface-400 font-mono text-xs whitespace-nowrap">{c.region}</td>
                          <td className="px-3 py-3 font-mono text-surface-300 whitespace-nowrap">{c.version}</td>
                          <td className="px-3 py-3 tabular-nums text-surface-300 text-right">{c.nodeCount}</td>
                          <td className="px-3 py-3 tabular-nums text-surface-300 text-right">{c.podCount}</td>
                          <td className="px-3 py-3 min-w-[90px]">
                            <div className="flex items-center gap-1.5">
                              <div className="w-12 h-1.5 rounded-full bg-surface-800">
                                <div className={cn('h-full rounded-full', cpuPct > 85 ? 'bg-danger' : cpuPct > 70 ? 'bg-warning' : 'bg-brand-500')} style={{ width: `${cpuPct}%` }} />
                              </div>
                              <span className="text-2xs tabular-nums text-surface-400">{cpuPct > 0 ? `${cpuPct}%` : '?'}</span>
                            </div>
                          </td>
                          <td className="px-3 py-3 min-w-[90px]">
                            <div className="flex items-center gap-1.5">
                              <div className="w-12 h-1.5 rounded-full bg-surface-800">
                                <div className={cn('h-full rounded-full', memPct > 85 ? 'bg-danger' : memPct > 70 ? 'bg-warning' : 'bg-purple-500')} style={{ width: `${memPct}%` }} />
                              </div>
                              <span className="text-2xs tabular-nums text-surface-400">{memPct > 0 ? `${memPct}%` : '?'}</span>
                            </div>
                          </td>
                          <td className="px-3 py-3">
                            <span className={cn('text-2xs px-2 py-0.5 rounded-full border font-semibold whitespace-nowrap',
                              c.status === 'healthy'  ? 'bg-success/10 text-success border-success/20' :
                              c.status === 'degraded' ? 'bg-warning/10 text-warning border-warning/20' :
                              c.status === 'critical' ? 'bg-danger/10 text-danger border-danger/20 animate-pulse' :
                              'bg-surface-700 text-surface-500 border-surface-600',
                            )}>{c.status}</span>
                          </td>
                          <td className="px-3 py-3 whitespace-nowrap">
                            {connected
                              ? <span className="text-2xs text-success flex items-center gap-1"><Wifi className="w-3 h-3" /> live</span>
                              : <span className="text-2xs text-surface-600">{probedAgo ?? '?'}</span>
                            }
                          </td>
                          <td className="px-3 py-3" onClick={e => e.stopPropagation()}>
                            {connected
                              ? null
                              : (
                                <div className="flex items-center gap-1">
                                  <button
                                    onClick={() => handleReprobeCluster(c.id)}
                                    disabled={probingCluster === c.id}
                                    title="Re-probe cluster"
                                    className="w-6 h-6 flex items-center justify-center rounded-lg hover:bg-brand-500/10 text-surface-500 hover:text-brand-400 transition-colors disabled:opacity-40"
                                  >
                                    {probingCluster === c.id ? <Loader2 className="w-3 h-3 animate-spin" /> : <RefreshCw className="w-3 h-3" />}
                                  </button>
                                  <button onClick={() => handleRemoveCluster(c.id)} title="Remove cluster" className="w-6 h-6 flex items-center justify-center rounded-lg hover:bg-danger/10 text-surface-500 hover:text-danger transition-colors"><Trash2 className="w-3 h-3" /></button>
                                </div>
                              )
                            }
                          </td>
                        </tr>
                        {/* Expanded details row */}
                        {expanded && (
                          <tr className="border-b border-surface-800/50 bg-surface-950/60">
                            <td colSpan={12} className="px-6 py-3">
                              <div className="grid grid-cols-3 gap-4 text-2xs">
                                <div>
                                  <p className="text-surface-500 font-semibold uppercase tracking-wider mb-1.5">Connection</p>
                                  <div className="space-y-1 font-mono">
                                    {c.k8sUrl  && <p className="text-surface-400 truncate" title={c.k8sUrl}><span className="text-surface-600">k8s </span>{c.k8sUrl}</p>}
                                    {c.promUrl && <p className="text-surface-400 truncate" title={c.promUrl}><span className="text-surface-600">prom </span>{c.promUrl}</p>}
                                    {!c.k8sUrl && <p className="text-surface-600 italic">Live cluster ? kubectl proxy</p>}
                                  </div>
                                </div>
                                <div>
                                  <p className="text-surface-500 font-semibold uppercase tracking-wider mb-1.5">Resources</p>
                                  <div className="space-y-1">
                                    <p className="text-surface-400">CPU: <span className="text-surface-200">{c.cpuUsed.toFixed(1)} / {c.cpuCapacity} cores</span></p>
                                    <p className="text-surface-400">Mem: <span className="text-surface-200">{c.memoryUsed.toFixed(1)} / {c.memoryCapacity} GiB</span></p>
                                    <p className="text-surface-400">Namespaces: <span className="text-surface-200">{c.namespaceCount}</span></p>
                                  </div>
                                </div>
                                <div>
                                  <p className="text-surface-500 font-semibold uppercase tracking-wider mb-1.5">Metadata</p>
                                  <div className="space-y-1">
                                    {(c as any).environment && <p className="text-surface-400">Env: <span className="text-surface-200">{(c as any).environment}</span></p>}
                                    {(c as any).description && <p className="text-surface-400 truncate">{(c as any).description}</p>}
                                    {c.lastProbed && <p className="text-surface-400">Last probed: <span className="text-surface-200">{timeAgo(c.lastProbed)}</span></p>}
                                  </div>
                                </div>
                              </div>
                            </td>
                          </tr>
                        )}
                        </Fragment>
                      )
                    })}
                  </tbody>
                </table>
              </div>
              {/* Aggregate footer */}
              <div className="px-4 py-2.5 bg-surface-950 border-t border-surface-800 flex items-center gap-6 text-2xs text-surface-500">
                <span>Total: <span className="text-surface-300 font-semibold">{fleetClusters.reduce((a, c) => a + c.nodeCount, 0)} nodes</span></span>
                <span><span className="text-surface-300 font-semibold">{fleetClusters.reduce((a, c) => a + c.podCount, 0).toLocaleString()}</span> pods</span>
                <span><span className={cn('font-semibold', fleetClusters.filter(c => c.status === 'degraded' || c.status === 'critical').length > 0 ? 'text-warning' : 'text-success')}>{fleetClusters.filter(c => c.status === 'degraded' || c.status === 'critical').length}</span> clusters degraded</span>
                <span className="ml-auto text-surface-600 italic">Non-live clusters show demo data. Connect via kubectl proxy.</span>
              </div>
            </div>

            {/* Active cluster header */}
            <div className="flex items-center gap-3 px-1">
              <Server className="w-4 h-4 text-brand-400" />
              <span className="text-sm font-semibold text-white">Active Cluster:</span>
              <span className="font-mono text-brand-300 text-sm">{clusterMeta.name}</span>
              <LiveDot live />
              <span className="text-2xs text-surface-500 ml-1">Live telemetry below</span>
            </div>

            {/* Main cluster card */}
            <div className="max-w-xl">
              <div className="rounded-2xl bg-surface-900 border border-surface-800 p-5 space-y-4">
                <div className="flex items-center justify-between">
                  <div>
                    <h3 className="text-sm font-bold text-white flex items-center gap-2">
                      {clusterMeta.name}
                      {(nodesLive || clusterMetaLive) && <LiveDot live />}
                    </h3>
                    <p className="text-2xs text-surface-500 mt-0.5">
                      {clusterMeta.provider} ? {clusterMeta.region} ? k8s {clusterMeta.version}
                    </p>
                  </div>
                  <StatusDot status={clusterStatus} />
                </div>

                {/* Stats grid */}
                <div className="grid grid-cols-4 gap-2 text-center">
                  {([
                    ['Nodes',   String(nodesData.nodes.length || '?')],
                    ['Pods',    String(totalPods || '?')],
                    ['Running', String(runningPods)],
                    ['NS',      String(clusterMeta.namespaceCount || '?')],
                  ] as [string, string][]).map(([l, v]) => (
                    <div key={l} className="bg-surface-800 rounded-xl py-2">
                      <div className="text-sm font-bold text-white">{v}</div>
                      <div className="text-2xs text-surface-500">{l}</div>
                    </div>
                  ))}
                </div>

                {/* Resource utilization */}
                <div className="space-y-2">
                  {([
                    ['CPU',    clusterCpuUsed,   clusterCpuCores,   'cores', 'bg-brand-500'],
                    ['Memory', clusterMemUsedGi, clusterMemTotalGi, 'GiB',   'bg-purple-500'],
                  ] as [string, number, number, string, string][]).map(([label, used, total, unit, color]) => {
                    const pct = total > 0 ? (used / total) * 100 : 0
                    return (
                      <div key={label}>
                        <div className="flex justify-between text-2xs mb-1">
                          <span className="text-surface-500">{label}</span>
                          <span className="text-surface-400">{used.toFixed(1)} / {total} {unit} ({Math.round(pct)}%)</span>
                        </div>
                        <div className="h-1.5 rounded-full bg-surface-800">
                          <div className={cn('h-full rounded-full transition-all', pct > 85 ? 'bg-danger' : pct > 70 ? 'bg-warning' : color)} style={{ width: `${pct}%` }} />
                        </div>
                      </div>
                    )
                  })}
                </div>
              </div>
            </div>

            {/* Per-node breakdown */}
            <div className="grid grid-cols-3 gap-3">
              {(nodesData.nodes as any[]).map(n => {
                const cpuPct = n.cpuCapacity > 0 ? Math.round((n.cpuUsed / n.cpuCapacity) * 100) : 0
                const memPct = n.memoryCapacity > 0 ? Math.round((n.memoryUsed / n.memoryCapacity) * 100) : 0
                return (
                  <div key={n.name} className="rounded-2xl bg-surface-900 border border-surface-800 p-4 space-y-2">
                    <div className="flex items-center justify-between">
                      <div className="flex items-center gap-2">
                        <div className={cn('w-2 h-2 rounded-full flex-shrink-0', n.status === 'Ready' ? 'bg-success' : 'bg-danger')} />
                        <span className="text-xs font-mono text-white truncate">{n.name.replace(`${activeCluster?.name ?? ''}-`, '')}</span>
                      </div>
                      <span className={cn('text-2xs px-1.5 py-0.5 rounded-full border font-medium',
                        n.role === 'control-plane' ? 'bg-purple-500/10 text-purple-400 border-purple-500/20' : 'bg-brand-500/10 text-brand-400 border-brand-500/20'
                      )}>{n.role === 'control-plane' ? 'cp' : 'worker'}</span>
                    </div>
                    <div className="space-y-1.5">
                      {[['CPU', cpuPct, 'bg-brand-500'], ['Mem', memPct, 'bg-purple-500']].map(([lbl, pct, col]) => (
                        <div key={String(lbl)}>
                          <div className="flex justify-between text-2xs mb-0.5">
                            <span className="text-surface-500">{lbl}</span>
                            <span className="text-surface-400">{pct}%</span>
                          </div>
                          <div className="h-1 rounded-full bg-surface-800">
                            <div className={cn('h-full rounded-full', Number(pct) > 85 ? 'bg-danger' : Number(pct) > 70 ? 'bg-warning' : String(col))} style={{ width: `${pct}%` }} />
                          </div>
                        </div>
                      ))}
                    </div>
                    <div className="text-2xs text-surface-600">{n.kubeletVersion ?? '?'}</div>
                  </div>
                )
              })}
            </div>

            {/* ?? API Server Metrics ?? */}
            <div className="rounded-2xl bg-surface-900 border border-surface-800 p-4">
              <div className="flex items-center gap-2 mb-3">
                <Server className="w-4 h-4 text-brand-400" />
                <span className="text-sm font-semibold text-white">API Server</span>
                <span className="text-2xs text-surface-500 ml-1">5-min window</span>
                {diagData.apiServer.requestRatePerSec === null && (
                  <span className="ml-auto text-2xs text-surface-600 italic">Requires Prometheus</span>
                )}
              </div>
              <div className="grid grid-cols-3 gap-3">
                {([
                  {
                    label: 'Request Rate',
                    val: diagData.apiServer.requestRatePerSec,
                    fmt: (v: number) => `${v.toFixed(2)}/s`,
                    color: (v: number) => v > 200 ? 'text-danger' : v > 100 ? 'text-warning' : 'text-success',
                    sub: 'req/s',
                  },
                  {
                    label: 'P99 Latency',
                    val: diagData.apiServer.p99LatencyMs,
                    fmt: (v: number) => `${v.toFixed(1)} ms`,
                    color: (v: number) => v > 500 ? 'text-danger' : v > 100 ? 'text-warning' : 'text-success',
                    sub: 'milliseconds',
                  },
                  {
                    label: 'Error Rate',
                    val: diagData.apiServer.errorRatePct,
                    fmt: (v: number) => `${v.toFixed(2)}%`,
                    color: (v: number) => v > 5 ? 'text-danger' : v > 1 ? 'text-warning' : 'text-success',
                    sub: '5xx responses',
                  },
                ] as any[]).map(kpi => (
                  <div key={kpi.label} className="bg-surface-800 rounded-xl px-4 py-3">
                    <div className="text-2xs text-surface-500 mb-1">{kpi.label}</div>
                    <div className={cn('text-xl font-bold tabular-nums', kpi.val !== null ? kpi.color(kpi.val) : 'text-surface-600')}>
                      {kpi.val !== null ? kpi.fmt(kpi.val) : '?'}
                    </div>
                    <div className="text-2xs text-surface-600 mt-0.5">{kpi.sub}</div>
                  </div>
                ))}
              </div>
            </div>

            {/* ?? Control Plane Health + Add-on Checklist ?? */}
            <div className="grid grid-cols-2 gap-4">

              {/* Component statuses (etcd, scheduler, controller-manager) */}
              <div className="rounded-2xl bg-surface-900 border border-surface-800 p-4">
                <div className="flex items-center gap-2 mb-3">
                  <Activity className="w-4 h-4 text-purple-400" />
                  <span className="text-sm font-semibold text-white">Control Plane Components</span>
                </div>
                <div className="space-y-2">
                  {diagData.components.length === 0 && (
                    <div className="flex items-center gap-2 rounded-xl bg-surface-800 px-3 py-2">
                      <span className="w-1.5 h-1.5 rounded-full bg-surface-600 flex-shrink-0" />
                      <span className="text-xs text-surface-500 italic">componentstatuses API not available (K8s ?1.19)</span>
                    </div>
                  )}
                  {diagData.components.map((c: { name: string; healthy: boolean; message: string }) => (
                    <div key={c.name} className="flex items-center justify-between rounded-xl bg-surface-800 px-3 py-2">
                      <span className="text-xs font-mono text-surface-300">{c.name}</span>
                      <div className="flex items-center gap-1.5">
                        {c.healthy
                          ? <span className="text-2xs px-2 py-0.5 rounded-full bg-success/10 text-success border border-success/20 font-semibold">Healthy</span>
                          : <span className="text-2xs px-2 py-0.5 rounded-full bg-danger/10 text-danger border border-danger/20 font-semibold animate-pulse">Unhealthy</span>
                        }
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              {/* Add-on checklist */}
              <div className="rounded-2xl bg-surface-900 border border-surface-800 p-4">
                <div className="flex items-center gap-2 mb-3">
                  <CheckCircle2 className="w-4 h-4 text-brand-400" />
                  <span className="text-sm font-semibold text-white">Add-on Health</span>
                  {diagData.addons.filter((a: any) => a.found && !a.ready).length > 0 && (
                    <span className="ml-auto text-2xs px-1.5 py-0.5 rounded-full bg-danger/10 text-danger border border-danger/20 font-semibold">
                      {diagData.addons.filter((a: any) => a.found && !a.ready).length} not ready
                    </span>
                  )}
                </div>
                <div className="grid grid-cols-2 gap-2">
                  {diagData.addons.map((a: { key: string; label: string; found: boolean; ready: boolean; podName: string | null }) => (
                    <div key={a.key} className={cn('flex items-center gap-2 rounded-xl px-3 py-2',
                      a.found && a.ready  ? 'bg-success/5 border border-success/15' :
                      a.found && !a.ready ? 'bg-warning/5 border border-warning/15' :
                      'bg-surface-800 border border-surface-700',
                    )}>
                      <div className={cn('w-1.5 h-1.5 rounded-full flex-shrink-0',
                        a.found && a.ready ? 'bg-success' : a.found ? 'bg-warning' : 'bg-surface-600',
                      )} />
                      <span className={cn('text-xs', a.found ? 'text-surface-200' : 'text-surface-500')}>{a.label}</span>
                      {!a.found && <span className="ml-auto text-2xs text-surface-600">not found</span>}
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {/* ?? Node Version Skew ?? */}
            <div className={cn('rounded-2xl bg-surface-900 border p-4', diagData.versionSkew ? 'border-warning' : 'border-surface-800')}>
              <div className="flex items-center gap-2 mb-3">
                <GitBranch className="w-4 h-4 text-amber-400" />
                <span className="text-sm font-semibold text-white">Node Version Skew</span>
                {diagData.versionSkew
                  ? <span className="ml-2 text-2xs px-2 py-0.5 rounded-full bg-warning/10 text-warning border border-warning/30 font-semibold animate-pulse">SKEW DETECTED</span>
                  : <span className="ml-2 text-2xs px-2 py-0.5 rounded-full bg-success/10 text-success border border-success/20 font-semibold">No Skew</span>
                }
              </div>
              <table className="w-full text-xs">
                <thead>
                  <tr className="border-b border-surface-800">
                    {['Node', 'Kubelet Version', 'Kernel', 'OS Image'].map(h => (
                      <th key={h} className="px-3 py-1.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {diagData.nodeVersions.length === 0 && (
                    <tr><td colSpan={4} className="px-3 py-4 text-center text-surface-600 italic text-xs">Loading?</td></tr>
                  )}
                  {diagData.nodeVersions.map((n: { node: string; kubeletVersion: string; kernelVersion: string; osImage: string }) => {
                    // Find the highest semver among all nodes to identify outdated ones
                    const parseKv = (v: string) => { const m = v.match(/(\d+)\.(\d+)/); return m ? parseInt(m[1])*1000+parseInt(m[2]) : 0 }
                    const maxKv = Math.max(...diagData.nodeVersions.map((x: any) => parseKv(x.kubeletVersion)))
                    const isLatest = parseKv(n.kubeletVersion) === maxKv
                    return (
                      <tr key={n.node} className="border-b border-surface-800/40 hover:bg-surface-800/30">
                        <td className="px-3 py-2 font-mono text-white text-xs">{n.node.replace(`${activeCluster?.name ?? ''}-`, '')}</td>
                        <td className={cn('px-3 py-2 font-mono text-xs font-semibold', isLatest ? 'text-success' : 'text-warning')}>
                          {n.kubeletVersion}
                        </td>
                        <td className="px-3 py-2 font-mono text-surface-500 text-xs">{n.kernelVersion}</td>
                        <td className="px-3 py-2 text-surface-400 text-xs">{n.osImage}</td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </div>

            {/* ?? Scheduler Queue Depth ?? */}
            <div className="rounded-2xl bg-surface-900 border border-surface-800 p-4">
              <div className="flex items-center gap-2 mb-3">
                <Layers className="w-4 h-4 text-brand-400" />
                <span className="text-sm font-semibold text-white">Scheduler Queue</span>
                <span className="text-2xs text-surface-500 ml-1">pending pods by queue</span>
                {(diagData.schedulerPending.unschedulable > 0 || diagData.schedulerPending.gated > 0) && (
                  <span className="ml-auto text-2xs px-2 py-0.5 rounded-full bg-warning/10 text-warning border border-warning/30 font-semibold animate-pulse">
                    {diagData.schedulerPending.unschedulable + diagData.schedulerPending.gated} blocked
                  </span>
                )}
              </div>
              {diagData.apiServer.requestRatePerSec === null && diagData.apiServer.p99LatencyMs === null && (
                <p className="text-2xs text-surface-600 italic mb-2">Requires Prometheus ? values below may show 0 if unavailable</p>
              )}
              <div className="grid grid-cols-4 gap-3">
                {([
                  { label: 'Active',        val: diagData.schedulerPending.active,        color: 'text-brand-400',   bg: 'bg-brand-500/10',   border: 'border-brand-500/20'   },
                  { label: 'Backoff',       val: diagData.schedulerPending.backoff,       color: 'text-amber-400',   bg: 'bg-amber-500/10',   border: 'border-amber-500/20'   },
                  { label: 'Gated',         val: diagData.schedulerPending.gated,         color: 'text-purple-400',  bg: 'bg-purple-500/10',  border: 'border-purple-500/20'  },
                  { label: 'Unschedulable', val: diagData.schedulerPending.unschedulable, color: diagData.schedulerPending.unschedulable > 0 ? 'text-danger' : 'text-surface-400', bg: diagData.schedulerPending.unschedulable > 0 ? 'bg-danger/10' : 'bg-surface-800', border: diagData.schedulerPending.unschedulable > 0 ? 'border-danger/30' : 'border-surface-700' },
                ] as any[]).map(q => (
                  <div key={q.label} className={cn('rounded-xl border px-3 py-3 text-center', q.bg, q.border)}>
                    <div className={cn('text-2xl font-bold tabular-nums', q.color)}>{q.val}</div>
                    <div className="text-2xs text-surface-500 mt-0.5">{q.label}</div>
                  </div>
                ))}
              </div>
            </div>

            {/* ?? Node Conditions (pressure / unavailable) ?? */}
            {(diagData.nodeConditions.length > 0 || diagData.nodeTaints.length > 0) && (
              <div className={cn('rounded-2xl bg-surface-900 border p-4', diagData.nodeConditions.length > 0 ? 'border-danger/40' : 'border-surface-800')}>
                <div className="flex items-center gap-2 mb-3">
                  <AlertTriangle className="w-4 h-4 text-danger" />
                  <span className="text-sm font-semibold text-white">Node Conditions</span>
                  {diagData.nodeConditions.length > 0 && (
                    <span className="ml-1 text-2xs px-2 py-0.5 rounded-full bg-danger/10 text-danger border border-danger/20 font-semibold">
                      {diagData.nodeConditions.length} active
                    </span>
                  )}
                </div>
                {diagData.nodeConditions.length > 0 && (
                  <div className="space-y-2 mb-3">
                    {diagData.nodeConditions.map((nc: any, i: number) => (
                      <div key={i} className="flex items-start gap-3 rounded-xl bg-danger/5 border border-danger/15 px-3 py-2">
                        <span className="text-2xs font-mono text-surface-400 w-24 flex-shrink-0 truncate">{nc.node.replace(`${activeCluster?.name ?? ''}-`, '')}</span>
                        <span className="text-2xs font-semibold text-danger w-28 flex-shrink-0">{nc.condition}</span>
                        <span className="text-2xs text-surface-400 truncate">{nc.reason}{nc.message ? ` ? ${nc.message}` : ''}</span>
                      </div>
                    ))}
                  </div>
                )}
                {diagData.nodeTaints.length > 0 && (
                  <>
                    <p className="text-2xs font-semibold text-surface-500 uppercase tracking-wider mb-2">Taints</p>
                    <div className="flex flex-wrap gap-2">
                      {diagData.nodeTaints.map((t: any, i: number) => (
                        <span key={i} className={cn('text-2xs px-2 py-0.5 rounded border font-mono',
                          t.effect === 'NoSchedule' ? 'bg-danger/10 border-danger/25 text-danger' :
                          t.effect === 'PreferNoSchedule' ? 'bg-warning/10 border-warning/25 text-warning' :
                          'bg-surface-800 border-surface-700 text-surface-400'
                        )} title={`${t.node}: ${t.key}=${t.value ?? ''}`}>
                          {t.node.replace(`${activeCluster?.name ?? ''}-`, '')}: {t.key}
                          <span className="text-surface-600 ml-1">:{t.effect}</span>
                        </span>
                      ))}
                    </div>
                  </>
                )}
              </div>
            )}

            {/* ?? Cluster Warning Events ?? */}
            {diagData.events.length > 0 && (
              <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
                <div className="flex items-center gap-2 px-4 py-3 border-b border-surface-800">
                  <AlertTriangle className="w-4 h-4 text-warning" />
                  <span className="text-sm font-semibold text-white">Warning Events</span>
                  <span className="text-2xs text-surface-500 ml-1">{diagData.events.length} recent</span>
                  <button onClick={() => refreshDiag()} className="ml-auto w-6 h-6 flex items-center justify-center rounded-lg hover:bg-surface-700 text-surface-500 hover:text-white transition-colors" title="Refresh events">
                    <RefreshCw className="w-3 h-3" />
                  </button>
                </div>
                <div className="divide-y divide-surface-800/40 max-h-72 overflow-y-auto">
                  {diagData.events.map((ev: any, i: number) => (
                    <div key={i} className="px-4 py-2.5 hover:bg-surface-800/30 grid grid-cols-[auto_1fr_auto] gap-3 items-start">
                      <div className="min-w-0">
                        <span className="text-2xs font-semibold text-warning bg-warning/10 border border-warning/20 px-1.5 py-0.5 rounded">{ev.reason}</span>
                      </div>
                      <div className="min-w-0">
                        <p className="text-xs text-surface-300 truncate">{ev.message}</p>
                        <p className="text-2xs text-surface-600 mt-0.5 font-mono">{ev.kind}/{ev.name}{ev.namespace ? ` ? ${ev.namespace}` : ''}</p>
                      </div>
                      <div className="text-right flex-shrink-0">
                        {ev.count > 1 && <span className="text-2xs text-surface-500">?{ev.count}</span>}
                        {ev.lastTime && <p className="text-2xs text-surface-600 mt-0.5">{timeAgo(ev.lastTime)}</p>}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

          </div>
        )}

        {/* ?? WORKLOADS TAB ?? */}
        {tab === 'Workloads' && (
          <div className="space-y-4">

            {/* Operation feedback toast */}
            {opToast && (
              <div className={cn('flex items-center gap-2 px-4 py-2.5 rounded-xl border text-sm font-semibold',
                opToast.ok ? 'bg-success/10 border-success/20 text-success' : 'bg-danger/10 border-danger/20 text-danger'
              )}>
                {opToast.ok ? <CheckCircle2 className="w-4 h-4 flex-shrink-0" /> : <AlertTriangle className="w-4 h-4 flex-shrink-0" />}
                {opToast.message}
              </div>
            )}

            {/* KPI strip */}
            <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
              {[
                { label: 'Deployments',  value: workloadsData.deployments.length,  sub: `${workloadsData.deployments.filter((d: K8sDeployment) => d.ready === d.desired && d.desired > 0).length} healthy`,  color: 'text-brand-400' },
                { label: 'StatefulSets', value: workloadsData.statefulsets.length, sub: `${workloadsData.statefulsets.filter((s: K8sStatefulSet) => s.ready === s.desired && s.desired > 0).length} healthy`, color: 'text-purple-400' },
                { label: 'DaemonSets',   value: workloadsData.daemonsets.length,   sub: `${workloadsData.daemonsets.filter((d: K8sDaemonSet) => d.ready === d.desired && d.desired > 0).length} healthy`,      color: 'text-amber-400' },
                { label: 'HPAs',         value: workloadsData.hpas.length,         sub: `${workloadsData.hpas.filter((h: K8sHPA) => h.currentReplicas >= h.minReplicas).length} active`,                      color: 'text-cyan-400' },
                { label: 'Jobs',         value: workloadsData.jobs.length,         sub: `${workloadsData.jobs.filter((j: K8sJob) => j.status === 'Running').length} running`,                                  color: 'text-green-400' },
                { label: 'CronJobs',     value: workloadsData.cronJobs.length,     sub: `${workloadsData.cronJobs.filter((c: K8sCronJob) => !c.suspended).length} active`,                                    color: 'text-surface-300' },
              ].map(k => (
                <div key={k.label} className="rounded-2xl bg-surface-900 border border-surface-800 px-4 py-3">
                  <div className={`text-2xl font-bold ${k.color}`}>{k.value}</div>
                  <div className="text-xs text-surface-500 mt-0.5">{k.label}</div>
                  <div className="text-2xs text-surface-600 mt-0.5">{k.sub}</div>
                </div>
              ))}
            </div>

            {/* Search + namespace filter bar */}
            <div className="flex items-center gap-3 px-1">
              <div className="relative flex-1 max-w-xs">
                <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-surface-500 pointer-events-none" />
                <input value={wSearch} onChange={e => setWSearch(e.target.value)}
                  placeholder="Search workloads?"
                  className="w-full pl-8 pr-3 py-1.5 rounded-xl bg-surface-800 border border-surface-700 text-xs text-white placeholder-surface-500 focus:outline-none focus:border-brand-500" />
                {wSearch && <button onClick={() => setWSearch('')} className="absolute right-2 top-1/2 -translate-y-1/2 text-surface-500 hover:text-white"><X className="w-3 h-3" /></button>}
              </div>
              <div className="flex items-center gap-1.5">
                <button onClick={() => setWNsFilter(null)}
                  className={cn('px-2.5 py-1 rounded-lg text-2xs font-semibold border transition-all', !wNsFilter ? 'bg-brand-500/20 text-brand-300 border-brand-500/30' : 'bg-surface-800 text-surface-500 border-surface-700 hover:border-surface-600')}>
                  All
                </button>
                {workloadNamespaces.map(ns => (
                  <button key={ns} onClick={() => setWNsFilter(wNsFilter === ns ? null : ns)}
                    className={cn('px-2.5 py-1 rounded-lg text-2xs font-semibold border transition-all', wNsFilter === ns ? 'bg-brand-500/20 text-brand-300 border-brand-500/30' : 'bg-surface-800 text-surface-500 border-surface-700 hover:border-surface-600')}>
                    {ns}
                  </button>
                ))}
              </div>
            </div>

            {/* Deployments */}
            <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
              <div className="px-4 py-3 border-b border-surface-800 flex items-center justify-between">
                <span className="text-sm font-semibold text-white">Deployments
                  <span className="text-surface-500 font-normal text-2xs ml-1">
                    ({filteredDeploys.length}{filteredDeploys.length !== workloadsData.deployments.length ? ` of ${workloadsData.deployments.length}` : ''})
                  </span>
                </span>
                <div className="flex items-center gap-1.5">
                  {([null,'Healthy','Degraded','Rolling'] as const).map(s => (
                    <button key={String(s)} onClick={() => setWStatusFilter(wStatusFilter === s ? null : s)}
                      className={cn('px-2 py-0.5 rounded-md text-2xs font-semibold border transition-all',
                        wStatusFilter === s
                          ? s === 'Healthy'  ? 'bg-success/15 text-success border-success/30'
                          : s === 'Degraded' ? 'bg-warning/15 text-warning border-warning/30'
                          : s === 'Rolling'  ? 'bg-amber-500/15 text-amber-400 border-amber-500/30'
                          :                   'bg-brand-500/20 text-brand-300 border-brand-500/30'
                          : 'bg-surface-800 text-surface-500 border-surface-700 hover:border-surface-600')}>
                      {s ?? 'All'}
                    </button>
                  ))}
                  <button
                    onClick={() => exportCSV(filteredDeploys.map(d => ({ name: d.name, namespace: d.namespace, ready: `${d.ready}/${d.desired}`, status: d.rollingOut ? 'Rolling' : d.ready === d.desired ? 'Healthy' : 'Degraded', image: d.image, cpu: fmtCpu(d.actualCpuCores), mem: fmtMem(d.actualMemBytes), age: d.createdAt })), 'deployments.csv')}
                    className="flex items-center gap-1 px-2 py-0.5 rounded-md text-2xs font-semibold border bg-surface-800 text-surface-500 border-surface-700 hover:border-surface-600 transition-all">
                    <Download className="w-3 h-3" /> CSV
                  </button>
                </div>
              </div>
              <div className="overflow-x-auto">
              <table className="w-full text-sm">
                <thead>
                  <tr className="border-b border-surface-800 bg-surface-950">
                    {([['name','Name'],['namespace','Namespace'],['ready','Ready'],['status','Status'],['age','Age']] as [string,string][]).map(([col, label]) => (
                      <th key={col} onClick={() => { if (wSortCol === col) setWSortDir(d => d === 'asc' ? 'desc' : 'asc'); else { setWSortCol(col as any); setWSortDir('asc') } }}
                        className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider cursor-pointer hover:text-surface-300 select-none">
                        {label}<span className="ml-1 opacity-50">{wSortCol === col ? (wSortDir === 'asc' ? '?' : '?') : '?'}</span>
                      </th>
                    ))}
                    <th className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">Image</th>
                  </tr>
                </thead>
                <tbody>
                  {filteredDeploys.map((d: K8sDeployment) => {
                    const healthy  = d.ready === d.desired && d.desired > 0
                    const degraded = d.ready < d.desired
                    const depKey   = `${d.namespace}/${d.name}`
                    const isExpanded = expandedDeploy === depKey
                    const linkedHPA  = workloadsData.hpas.find((h: K8sHPA) => h.namespace === d.namespace && h.targetName === d.name)
                    const hist       = deployHistory[depKey]
                    const wevts      = wloadEvents[depKey]
                    const warnCount  = wevts?.length ?? 0
                    const cpuStr     = fmtCpu(d.actualCpuCores)
                    const memStr     = fmtMem(d.actualMemBytes)
                    // Rightsizing: sum requested resources across all containers
                    const totalCpuReq = (d.containers ?? []).reduce((acc, c) => { const v = parseCpu(c.cpuRequest); return v != null ? acc + v : acc }, 0)
                    const totalMemReq = (d.containers ?? []).reduce((acc, c) => { const v = parseMem(c.memRequest); return v != null ? acc + v : acc }, 0)
                    const cpuEffPct = d.actualCpuCores != null && totalCpuReq > 0 ? Math.round((d.actualCpuCores / totalCpuReq) * 100) : null
                    const memEffPct = d.actualMemBytes != null && totalMemReq > 0 ? Math.round((d.actualMemBytes / totalMemReq) * 100) : null
                    const effLabel = (pct: number) => pct < 20 ? 'Over-prov' : pct > 80 ? 'Hot' : 'OK'
                    const effColor = (pct: number) => pct < 20 ? 'text-amber-400' : pct > 80 ? 'text-danger' : 'text-success'
                    const effBarColor = (pct: number) => pct < 20 ? 'bg-amber-400' : pct > 80 ? 'bg-danger' : 'bg-success'
                    return (
                      <Fragment key={depKey}>
                        <tr onClick={() => setExpandedDeploy(isExpanded ? null : depKey)} className="border-b border-surface-800/50 hover:bg-surface-800/40 cursor-pointer">
                          <td className="px-4 py-2.5 font-mono text-white text-xs">
                            <div className="flex items-center gap-1.5">
                              {isExpanded ? <ChevronDown className="w-3 h-3 text-brand-400 flex-shrink-0" /> : <ChevronRight className="w-3 h-3 text-surface-500 flex-shrink-0" />}
                              {d.name}
                              {(d.containerCount ?? 1) > 1 && <span className="text-2xs px-1 py-0.5 rounded bg-surface-700 text-surface-400 font-semibold">{d.containerCount}</span>}
                              {d.helmRelease && <span className="text-2xs px-1.5 py-0.5 rounded bg-purple-500/15 text-purple-300 border border-purple-500/20 font-semibold">Helm</span>}
                              {warnCount > 0 && <span className="text-2xs px-1.5 py-0.5 rounded bg-warning/10 text-warning border border-warning/20 font-semibold">{warnCount}?</span>}
                            </div>
                          </td>
                          <td className="px-4 py-2.5 text-surface-400 text-xs">{d.namespace}</td>
                          <td className="px-4 py-2.5 text-xs tabular-nums">
                            <div className="flex flex-col gap-0.5">
                              <span className={healthy ? 'text-success font-semibold' : degraded ? 'text-warning font-semibold' : 'text-surface-500'}>{d.ready}/{d.desired}</span>
                              {d.rollingOut && (
                                <div className="w-24 h-1 rounded-full bg-surface-700 overflow-hidden">
                                  <div className="h-full bg-amber-400 animate-pulse rounded-full" style={{ width: `${Math.round(((d.updated ?? 0) / Math.max(d.desired, 1)) * 100)}%` }} />
                                </div>
                              )}
                              {(cpuStr !== '?' || memStr !== '?') && <span className="text-2xs text-surface-600 font-mono">{cpuStr} cpu ? {memStr}</span>}
                            </div>
                          </td>
                          <td className="px-4 py-2.5">
                            <div className="flex items-center gap-1">
                              <span className={cn('text-2xs px-2 py-0.5 rounded-full border font-semibold', d.rollingOut ? 'bg-amber-500/10 text-amber-400 border-amber-500/20' : healthy ? 'bg-success/10 text-success border-success/20' : degraded ? 'bg-warning/10 text-warning border-warning/20' : 'bg-surface-700/50 text-surface-500 border-surface-700')}>
                                {d.rollingOut ? 'Rolling' : healthy ? 'Healthy' : degraded ? 'Degraded' : 'Unavailable'}
                              </span>
                              {linkedHPA && <span className="text-2xs px-1.5 py-0.5 rounded bg-cyan-500/15 text-cyan-300 border border-cyan-500/20 font-semibold">HPA</span>}
                            </div>
                          </td>
                          <td className="px-4 py-2.5 text-2xs max-w-[280px]">
                            <div className="flex items-center gap-1.5">
                              <span className="font-mono text-surface-500 truncate" title={d.image}>{d.image.split('/').pop()}</span>
                              {(() => {
                                const wl = costData.byWorkload.find(w => w.namespace === d.namespace && w.name === d.name)
                                if (!wl || wl.costPerMo === 0) return null
                                return <span className="flex-shrink-0 text-2xs px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-semibold" title={`~${wl.costPerMo}/mo (${wl.cpuCores} cores, ${wl.memGiB} GiB)`}>${wl.costPerMo.toFixed(2)}/mo</span>
                              })()}
                            </div>
                          </td>
                          <td className="px-4 py-2.5 text-xs text-surface-500">
                            {(() => { const ago = Math.round((Date.now() - new Date(d.createdAt).getTime()) / 60000); return ago < 60 ? `${ago}m` : ago < 1440 ? `${Math.round(ago/60)}h` : `${Math.round(ago/1440)}d` })()}
                          </td>
                        </tr>
                        {isExpanded && (
                          <tr className="bg-surface-950">
                            <td colSpan={6} className="px-6 py-4 border-b border-surface-700">
                              {/* Actions */}
                              <div className="flex items-center gap-2 pb-3 border-b border-surface-800 mb-4">
                                <button onClick={e => { e.stopPropagation(); setScaleTarget(d) }}
                                  className="flex items-center gap-1.5 px-3 py-1.5 text-2xs font-semibold text-brand-400 bg-brand-500/10 hover:bg-brand-500/20 rounded-lg border border-brand-500/20 transition-all">
                                  <Layers className="w-3 h-3" /> Scale
                                </button>
                                <button onClick={e => { e.stopPropagation(); handleRestartDeploy(d) }} disabled={restartingDeploy === d.name}
                                  className="flex items-center gap-1.5 px-3 py-1.5 text-2xs font-semibold text-amber-400 bg-amber-500/10 hover:bg-amber-500/20 rounded-lg border border-amber-500/20 transition-all disabled:opacity-40">
                                  <RotateCcw className={cn('w-3 h-3', restartingDeploy === d.name && 'animate-spin')} />
                                  {restartingDeploy === d.name ? 'Restarting?' : 'Restart'}
                                </button>
                                <button onClick={e => { e.stopPropagation(); setYamlTarget({ kind: 'Deployment', namespace: d.namespace, name: d.name }) }}
                                  className="flex items-center gap-1.5 px-3 py-1.5 text-2xs font-semibold text-surface-400 bg-surface-800 hover:bg-surface-700 rounded-lg border border-surface-700 transition-all">
                                  <FileCode2 className="w-3 h-3" /> YAML
                                </button>
                                <button onClick={e => { e.stopPropagation(); setDescribeTarget({ kind: 'Deployment', namespace: d.namespace, name: d.name }) }}
                                  className="flex items-center gap-1.5 px-3 py-1.5 text-2xs font-semibold text-amber-400 bg-amber-500/10 hover:bg-amber-500/20 rounded-lg border border-amber-500/20 transition-all">
                                  <FileSearch className="w-3 h-3" /> Describe
                                </button>
                                <button onClick={e => { e.stopPropagation(); handleDeleteDeploy(d) }} disabled={deletingDeploy === depKey}
                                  className="ml-auto flex items-center gap-1.5 px-3 py-1.5 text-2xs font-semibold text-danger bg-danger/10 hover:bg-danger/20 rounded-lg border border-danger/20 transition-all disabled:opacity-40">
                                  <Trash2 className="w-3 h-3" /> Delete
                                </button>
                              </div>
                              <div className="grid grid-cols-2 gap-6">
                                {/* Left: meta + conditions + HPA */}
                                <div className="space-y-3">
                                  <div className="flex flex-wrap items-center gap-3 text-2xs">
                                    <span className="text-surface-500">Strategy</span>
                                    <span className="bg-surface-800 px-2 py-0.5 rounded font-mono text-surface-300">{d.strategy ?? 'RollingUpdate'}</span>
                                    {d.helmRelease && (
                                      <span className="text-surface-500">Helm: <span className="text-purple-300 font-mono">{d.helmRelease}</span>
                                        {d.helmChart && <span className="ml-1 text-surface-600">({d.helmChart})</span>}
                                      </span>
                                    )}
                                  </div>
                                  {/* Resource usage + efficiency */}
                                  {(cpuStr !== '?' || memStr !== '?') && (
                                    <div className="bg-surface-800/60 rounded-lg px-3 py-2.5 space-y-2">
                                      <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider">Live Usage &amp; Efficiency</p>
                                      {/* CPU row */}
                                      {cpuStr !== '?' && (
                                        <div className="space-y-0.5">
                                          <div className="flex items-center justify-between text-2xs">
                                            <span className="text-surface-500">CPU</span>
                                            <div className="flex items-center gap-2">
                                              <span className="font-mono text-cyan-300">{cpuStr}</span>
                                              {totalCpuReq > 0 && <span className="text-surface-600">/ {fmtCpu(totalCpuReq)} req</span>}
                                              {cpuEffPct != null && <span className={cn('font-semibold', effColor(cpuEffPct))}>{cpuEffPct}% ? {effLabel(cpuEffPct)}</span>}
                                            </div>
                                          </div>
                                          {cpuEffPct != null && (
                                            <div className="w-full h-1 rounded-full bg-surface-700 overflow-hidden">
                                              <div className={cn('h-full rounded-full transition-all', effBarColor(cpuEffPct))} style={{ width: `${Math.min(100, cpuEffPct)}%` }} />
                                            </div>
                                          )}
                                        </div>
                                      )}
                                      {/* Mem row */}
                                      {memStr !== '?' && (
                                        <div className="space-y-0.5">
                                          <div className="flex items-center justify-between text-2xs">
                                            <span className="text-surface-500">Mem</span>
                                            <div className="flex items-center gap-2">
                                              <span className="font-mono text-cyan-300">{memStr}</span>
                                              {totalMemReq > 0 && <span className="text-surface-600">/ {fmtMem(totalMemReq)} req</span>}
                                              {memEffPct != null && <span className={cn('font-semibold', effColor(memEffPct))}>{memEffPct}% ? {effLabel(memEffPct)}</span>}
                                            </div>
                                          </div>
                                          {memEffPct != null && (
                                            <div className="w-full h-1 rounded-full bg-surface-700 overflow-hidden">
                                              <div className={cn('h-full rounded-full transition-all', effBarColor(memEffPct))} style={{ width: `${Math.min(100, memEffPct)}%` }} />
                                            </div>
                                          )}
                                        </div>
                                      )}
                                    </div>
                                  )}
                                  {(d.conditions ?? []).length > 0 && (
                                    <div>
                                      <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-1.5">Conditions</p>
                                      <div className="space-y-1">
                                        {(d.conditions ?? []).map((c, i) => (
                                          <div key={i} className="flex items-center gap-2 text-2xs">
                                            <span className={cn('w-1.5 h-1.5 rounded-full flex-shrink-0', c.status === 'True' ? 'bg-success' : 'bg-warning')} />
                                            <span className="text-surface-300 font-semibold">{c.type}</span>
                                            {c.reason && <span className="text-surface-500">{c.reason}</span>}
                                          </div>
                                        ))}
                                      </div>
                                    </div>
                                  )}
                                  {Object.keys(d.selector ?? {}).length > 0 && (
                                    <div>
                                      <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-1.5">Selector</p>
                                      <div className="flex flex-wrap gap-1">
                                        {Object.entries(d.selector ?? {}).map(([k, v]) => (
                                          <span key={k} className="bg-surface-800 rounded px-1.5 py-0.5 font-mono text-2xs text-brand-300">{k}={v}</span>
                                        ))}
                                      </div>
                                    </div>
                                  )}
                                  {linkedHPA && (
                                    <div>
                                      <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-1.5">Autoscaler (HPA)</p>
                                      <div className="bg-surface-800 rounded-lg px-3 py-2 space-y-1.5">
                                        <div className="flex items-center gap-4 text-2xs">
                                          <span className="text-surface-500">Range</span>
                                          <span className="font-mono text-cyan-300">{linkedHPA.minReplicas}?{linkedHPA.maxReplicas}</span>
                                          <span className="text-surface-500">Current</span>
                                          <span className="font-mono text-white">{linkedHPA.currentReplicas} / desired {linkedHPA.desiredReplicas}</span>
                                        </div>
                                        {linkedHPA.metrics.map((m: any, mi: number) => (
                                          <div key={mi} className="flex items-center gap-2 text-2xs">
                                            <span className="text-surface-500 capitalize w-12">{m.resourceName ?? m.type}</span>
                                            {m.currentAverageUtilization != null && (
                                              <>
                                                <div className="w-20 h-1.5 rounded-full bg-surface-700 overflow-hidden">
                                                  <div className={cn('h-full rounded-full', (m.currentAverageUtilization ?? 0) > 80 ? 'bg-danger' : (m.currentAverageUtilization ?? 0) > 60 ? 'bg-warning' : 'bg-success')}
                                                    style={{ width: `${Math.min(100, m.currentAverageUtilization ?? 0)}%` }} />
                                                </div>
                                                <span className="text-white">{m.currentAverageUtilization}%</span>
                                                <span className="text-surface-500">/ {m.targetAverageUtilization}%</span>
                                              </>
                                            )}
                                            {m.currentAverageUtilization == null && m.currentAverageValue && (
                                              <span className="text-white font-mono">{m.currentAverageValue} / {m.targetAverageValue}</span>
                                            )}
                                          </div>
                                        ))}
                                      </div>
                                    </div>
                                  )}
                                  {/* Warning events */}
                                  {(loadingWEvents === depKey || wloadEvents[depKey] !== undefined) && (
                                    <div>
                                      <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-1.5">Warning Events</p>
                                      {loadingWEvents === depKey
                                        ? <div className="text-2xs text-surface-500 animate-pulse">Loading?</div>
                                        : (wevts ?? []).length === 0
                                        ? <p className="text-2xs text-surface-600 italic">No warning events</p>
                                        : <div className="space-y-1">
                                            {(wevts ?? []).map((ev: any, ei: number) => (
                                              <div key={ei} className="bg-warning/5 border border-warning/15 rounded px-2 py-1.5 text-2xs space-y-0.5">
                                                <div className="flex items-center justify-between">
                                                  <span className="font-semibold text-warning">{ev.reason}</span>
                                                  <span className="text-surface-600">?{ev.count}</span>
                                                </div>
                                                <div className="text-surface-400 leading-relaxed line-clamp-2">{ev.message}</div>
                                              </div>
                                            ))}
                                          </div>
                                      }
                                    </div>
                                  )}
                                </div>
                                {/* Dependency map for this deployment */}
                                {(() => {
                                  const depEntry = depMapData.workloads.find(w => w.namespace === d.namespace && w.name === d.name)
                                  if (!depEntry || (depEntry.deps.secrets.length + depEntry.deps.configmaps.length + depEntry.deps.pvcs.length) === 0) return null
                                  return (
                                    <div>
                                      <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-1.5">Dependency Map</p>
                                      <div className="bg-surface-800 rounded-lg px-3 py-2 space-y-1.5">
                                        {depEntry.deps.configmaps.length > 0 && (
                                          <div className="flex flex-wrap gap-1 items-center">
                                            <span className="text-2xs text-surface-500 w-16 flex-shrink-0">ConfigMaps</span>
                                            {depEntry.deps.configmaps.map(cm => <span key={cm} className="text-2xs font-mono bg-brand-500/10 text-brand-400 px-1.5 py-0.5 rounded border border-brand-500/20">{cm}</span>)}
                                          </div>
                                        )}
                                        {depEntry.deps.secrets.length > 0 && (
                                          <div className="flex flex-wrap gap-1 items-center">
                                            <span className="text-2xs text-surface-500 w-16 flex-shrink-0">Secrets</span>
                                            {depEntry.deps.secrets.map(s => <span key={s} className="text-2xs font-mono bg-warning/10 text-warning px-1.5 py-0.5 rounded border border-warning/20">{s}</span>)}
                                          </div>
                                        )}
                                        {depEntry.deps.pvcs.length > 0 && (
                                          <div className="flex flex-wrap gap-1 items-center">
                                            <span className="text-2xs text-surface-500 w-16 flex-shrink-0">PVCs</span>
                                            {depEntry.deps.pvcs.map(p => <span key={p} className="text-2xs font-mono bg-purple-500/10 text-purple-400 px-1.5 py-0.5 rounded border border-purple-500/20">{p}</span>)}
                                          </div>
                                        )}
                                      </div>
                                    </div>
                                  )
                                })()}
                                {/* Right: containers + rollout history */}
                                <div className="space-y-3">
                                  {(d.containers ?? []).length > 0 && (
                                    <div>
                                      <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-1.5">
                                        Pod Template Containers {(d.containers ?? []).length > 1 && <span className="text-brand-400">({(d.containers ?? []).length})</span>}
                                      </p>
                                      <div className="space-y-2">
                                        {(d.containers ?? []).map((c, i) => (
                                          <div key={i} className="bg-surface-800 rounded-lg px-3 py-2 space-y-1">
                                            <div className="flex items-center justify-between">
                                              <span className="text-2xs font-mono font-semibold text-white">{c.name}</span>
                                              <span className="text-2xs font-mono text-surface-500 truncate max-w-[200px]" title={c.image}>{c.image.split('/').pop()}</span>
                                            </div>
                                            <div className="flex gap-3 text-2xs text-surface-500">
                                              <span>CPU: <span className="font-mono text-surface-300">{c.cpuRequest ?? '-'}/{c.cpuLimit ?? '-'}</span></span>
                                              <span>Mem: <span className="font-mono text-surface-300">{c.memRequest ?? '-'}/{c.memLimit ?? '-'}</span></span>
                                            </div>
                                          </div>
                                        ))}
                                      </div>
                                    </div>
                                  )}
                                  {/* Rollout history */}
                                  <div>
                                    <p className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-1.5">Rollout History</p>
                                    {loadingHistory === depKey
                                      ? <div className="text-2xs text-surface-500 animate-pulse">Loading?</div>
                                      : hist && hist.length > 0
                                      ? <div className="rounded-lg border border-surface-700 overflow-hidden">
                                          <table className="w-full text-2xs">
                                            <thead><tr className="bg-surface-800 border-b border-surface-700">
                                              <th className="px-3 py-1.5 text-left font-semibold text-surface-400">Rev</th>
                                              <th className="px-3 py-1.5 text-left font-semibold text-surface-400">Image</th>
                                              <th className="px-3 py-1.5 text-left font-semibold text-surface-400">Age</th>
                                              <th className="px-3 py-1.5 text-left font-semibold text-surface-400"></th>
                                            </tr></thead>
                                            <tbody>
                                              {hist.map((rev: any) => {
                                                const ago = Math.round((Date.now() - new Date(rev.createdAt).getTime()) / 60000)
                                                const ageStr = ago < 60 ? `${ago}m` : ago < 1440 ? `${Math.round(ago/60)}h` : `${Math.round(ago/1440)}d`
                                                return (
                                                  <tr key={rev.revision} className={cn('border-b border-surface-800/60', rev.current && 'bg-brand-500/5')}>
                                                    <td className="px-3 py-1.5 font-mono text-surface-300">r{rev.revision}{rev.current && <span className="ml-1 text-brand-400">(current)</span>}</td>
                                                    <td className="px-3 py-1.5 font-mono text-surface-400 max-w-[160px] truncate" title={rev.image}>{rev.imageTag}</td>
                                                    <td className="px-3 py-1.5 text-surface-500">{ageStr}</td>
                                                    <td className="px-3 py-1.5">
                                                      {!rev.current && (
                                                        <button onClick={e => { e.stopPropagation(); handleRollback(d, rev.rsName) }}
                                                          disabled={rollingBack === depKey}
                                                          className="flex items-center gap-1 px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 hover:bg-amber-500/20 border border-amber-500/20 font-semibold transition-all disabled:opacity-40">
                                                          <RotateCcw className="w-2.5 h-2.5" /> Rollback
                                                        </button>
                                                      )}
                                                    </td>
                                                  </tr>
                                                )
                                              })}
                                            </tbody>
                                          </table>
                                        </div>
                                      : <div className="text-2xs text-surface-600">No history available</div>
                                    }
                                  </div>
                                </div>
                              </div>
                            </td>
                          </tr>
                        )}
