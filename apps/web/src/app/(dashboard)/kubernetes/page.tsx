                    className="w-full bg-surface-800 border border-surface-700 rounded-lg pl-8 pr-3 py-1.5 text-2xs text-white placeholder-surface-500 focus:outline-none focus:border-brand-500" />
                </div>
              </div>
              <div className="overflow-x-auto">
              <table className="w-full text-xs">
                <thead>
                  <tr className="border-b border-surface-800 bg-surface-950">
                    {['Name', 'Status', 'PSA', 'Pods', 'Workloads', 'Governance', 'Age', ''].map(h => (
                      <th key={h} className="px-3 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {quotasData.namespaces
                    .filter((ns: K8sNamespace) => !policySearch || ns.name.toLowerCase().includes(policySearch.toLowerCase()))
                    .map((ns: K8sNamespace) => {
                      const nsKey = ns.name
                      const isExpNs = expandedNs === nsKey
                      const sum = nsSummary[nsKey] ?? { podTotal: 0, podRunning: 0, depCount: 0, stsCount: 0, dsCount: 0, svcCount: 0 }
                      const nsLabels = Object.entries(ns.labels ?? {}).filter(([k]) =>
                        !k.startsWith('kubernetes.io/') && !k.startsWith('pod-security.kubernetes.io/'))
                      const psaLevel = ns.labels?.['pod-security.kubernetes.io/enforce']
                      const psaColor = psaLevel === 'restricted'
                        ? 'bg-success/10 text-success border-success/20'
                        : psaLevel === 'baseline' ? 'bg-warning/10 text-warning border-warning/20'
                        : psaLevel === 'privileged' ? 'bg-danger/10 text-danger border-danger/20' : ''
                      const podHealthy = sum.podTotal > 0 && sum.podRunning === sum.podTotal
                      const hasQuota = quotasData.quotas.some((q: ResourceQuota) => q.namespace === nsKey)
                      const hasLR    = quotasData.limitranges.some((l: LimitRange) => l.namespace === nsKey)
                      const hasNP    = netpolData.policies.some((np: K8sNetworkPolicy) => np.namespace === nsKey)
                      const createdAgo = Math.round((Date.now() - new Date(ns.createdAt).getTime()) / 86_400_000)
                      const nsPods = isExpNs
                        ? (podsData.pods as any[]).filter(p => p.namespace === nsKey)
                            .sort((a: any, b: any) => a.status === b.status ? a.name.localeCompare(b.name) : a.status === 'Running' ? 1 : -1)
                        : []
                      const nsSvcs = isExpNs ? (networkData.services as K8sService[]).filter(s => s.namespace === nsKey) : []
                      const nsWorkloads = isExpNs ? [
                        ...(workloadsData.deployments  as K8sDeployment[]).filter(d  => d.namespace  === nsKey).map(d  => ({ kind: 'Deployment',  name: d.name,  ready: `${d.ready}/${d.desired}`  })),
                        ...(workloadsData.statefulsets as K8sStatefulSet[]).filter(s  => s.namespace  === nsKey).map(s  => ({ kind: 'StatefulSet', name: s.name,  ready: `${s.ready}/${s.desired}`  })),
                        ...(workloadsData.daemonsets   as K8sDaemonSet[]).filter(ds => ds.namespace === nsKey).map(ds => ({ kind: 'DaemonSet',   name: ds.name, ready: `${ds.ready}/${ds.desired}` })),
                      ] : []
                      return (
                        <Fragment key={nsKey}>
                          <tr className={cn('border-b border-surface-800/50 hover:bg-surface-800/40 transition-colors cursor-pointer', isExpNs && 'bg-surface-800/20')}
                            onClick={() => setExpandedNs(isExpNs ? null : nsKey)}>
                            <td className="px-3 py-2.5">
                              <div className="flex items-center gap-1.5">
                                {isExpNs
                                  ? <ChevronDown className="w-3 h-3 text-surface-400 flex-shrink-0" />
                                  : <ChevronRight className="w-3 h-3 text-surface-500 flex-shrink-0" />}
                                <span className="font-mono text-white">{ns.name}</span>
                              </div>
                            </td>
                            <td className="px-3 py-2.5">
                              <span className={cn('text-2xs px-1.5 py-0.5 rounded-full font-semibold border',
                                ns.status === 'Active' ? 'bg-success/10 text-success border-success/20' : 'bg-warning/10 text-warning border-warning/20'
