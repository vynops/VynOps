                      )}>All</button>
                    {Array.from(new Set<string>(crdsData.crds.map((c: any) => c.group as string))).sort().slice(0, 8).map(g => (
                      <button key={g} onClick={() => setCrdGroupFilter(crdGroupFilter === g ? null : g as string)}
                        className={cn('text-2xs px-2 py-0.5 rounded border font-medium transition-all max-w-[160px] truncate',
                          crdGroupFilter === g ? 'bg-purple-500/20 text-purple-400 border-purple-500/30' : 'bg-surface-800 text-surface-500 border-surface-700 hover:border-surface-600'
                        )}>{g}</button>
                    ))}
                  </div>
                </div>
                <div className="overflow-y-auto max-h-[280px]">
                  <table className="w-full text-xs">
                    <thead className="sticky top-0 z-10">
                      <tr className="border-b border-surface-800 bg-surface-950">
                        {['Kind', 'Group', 'Scope', 'Versions', 'Status'].map(h => (
                          <th key={h} className="px-3 py-2 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {crdsData.crds
                        .filter(c => !crdGroupFilter || c.group === crdGroupFilter)
                        .map(crd => (
                          <tr key={crd.name} className="border-b border-surface-800/40 hover:bg-surface-800/30">
                            <td className="px-3 py-2 font-mono text-white">{crd.kind}</td>
                            <td className="px-3 py-2 font-mono text-surface-400 text-2xs truncate max-w-[200px]">{crd.group}</td>
                            <td className="px-3 py-2">
                              <span className={cn('text-2xs px-1.5 py-0.5 rounded border font-medium',
                                crd.scope === 'Cluster' ? 'bg-purple-500/10 text-purple-400 border-purple-500/20' : 'bg-brand-500/10 text-brand-400 border-brand-500/20'
                              )}>{crd.scope}</span>
                            </td>
                            <td className="px-3 py-2">
                              <div className="flex flex-wrap gap-1">
                                {crd.versions.map(v => (
                                  <span key={v.name} className={cn('text-2xs px-1 py-0.5 rounded font-mono',
                                    v.storage ? 'bg-brand-500/10 text-brand-400' : 'bg-surface-700 text-surface-500',
                                    v.deprecated && 'line-through opacity-50'
                                  )} title={v.storage ? 'storage version' : undefined}>{v.name}</span>
                                ))}
                              </div>
                            </td>
                            <td className="px-3 py-2">
                              {crd.established
                                ? <span className="text-2xs text-success font-semibold">Established</span>
                                : <span className="text-2xs text-warning font-semibold animate-pulse">Installing?</span>}
                            </td>
                          </tr>
                        ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
            {/* Admission Webhooks */}
            {(webhooksData.validating.length + webhooksData.mutating.length) > 0 && (
              <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
                <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2">
                  <Lock className="w-4 h-4 text-amber-400" />
                  <span className="text-sm font-semibold text-white">Admission Webhooks</span>
                  <span className="text-2xs bg-amber-400/10 text-amber-400 border border-amber-400/20 px-1.5 py-0.5 rounded-full font-semibold ml-1">{webhooksData.validating.length} validating</span>
                  <span className="text-2xs bg-purple-400/10 text-purple-400 border border-purple-400/20 px-1.5 py-0.5 rounded-full font-semibold">{webhooksData.mutating.length} mutating</span>
                </div>
                <div className="overflow-y-auto max-h-[260px] divide-y divide-surface-800/40">
                  {[...webhooksData.validating, ...webhooksData.mutating].map((cfg: any) => {
                    const isWHExpanded = expandedWebhook === cfg.name
                    return (
                      <div key={cfg.name}>
                        <button
                          onClick={() => setExpandedWebhook(isWHExpanded ? null : cfg.name)}
                          className="w-full px-4 py-2.5 flex items-center gap-3 hover:bg-surface-800/30 text-left transition-colors"
                        >
                          <ChevronRight className={cn('w-3 h-3 text-surface-500 transition-transform', isWHExpanded && 'rotate-90')} />
                          <span className="text-xs font-mono text-white flex-1 truncate">{cfg.name}</span>
                          <span className={cn('text-2xs px-1.5 py-0.5 rounded border font-medium',
                            cfg.kind === 'Validating' ? 'bg-amber-500/10 text-amber-400 border-amber-500/20' : 'bg-purple-500/10 text-purple-400 border-purple-500/20'
                          )}>{cfg.kind}</span>
                          <span className="text-2xs text-surface-500">{cfg.webhookCount} webhook{cfg.webhookCount !== 1 ? 's' : ''}</span>
                        </button>
                        {isWHExpanded && (
                          <div className="px-8 pb-3 space-y-2">
                            {cfg.webhooks.map((wh: any) => (
                              <div key={wh.name} className="bg-surface-800/50 rounded-xl px-3 py-2 text-2xs space-y-1">
                                <div className="font-mono text-surface-300 font-semibold">{wh.name}</div>
                                <div className="flex flex-wrap gap-2 text-surface-500">
                                  <span>service: <span className="text-brand-300">{wh.service}</span></span>
                                  <span className={cn('font-semibold', wh.failurePolicy === 'Fail' ? 'text-danger' : 'text-success')}>
                                    failurePolicy: {wh.failurePolicy}
                                  </span>
                                  <span>sideEffects: {wh.sideEffects}</span>
                                </div>
                                {(wh.operations.length > 0 || wh.resources.length > 0) && (
                                  <div className="flex flex-wrap gap-1">
                                    {wh.operations.map((op: string) => (
                                      <span key={op} className="bg-surface-700 text-surface-300 px-1.5 py-0.5 rounded font-mono">{op}</span>
                                    ))}
                                    {wh.resources.slice(0, 6).map((res: string) => (
                                      <span key={res} className="bg-brand-500/10 text-brand-400 px-1.5 py-0.5 rounded font-mono">{res}</span>
                                    ))}
                                  </div>
                                )}
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    )
                  })}
                </div>
              </div>
            )}
          </div>
        )}

        {/* ?? ConfigMap Browser ?? */}
        {tab === 'Policy' && configmapsData.configmaps.length > 0 && (
          <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
            <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-3">
              <FolderOpen className="w-4 h-4 text-brand-400" />
              <span className="text-sm font-semibold text-white">ConfigMap Browser</span>
              <span className="text-2xs text-surface-500 ml-1">{configmapsData.configmaps.length} total</span>
              <div className="ml-auto flex items-center gap-2">
                {Array.from(new Set<string>(configmapsData.configmaps.map((cm: any) => cm.namespace as string))).sort().map(ns => (
                  <button key={ns} onClick={() => setCmNsFilter(cmNsFilter === ns ? null : ns as string)}
                    className={cn('text-2xs px-2 py-0.5 rounded border', cmNsFilter === ns ? 'bg-brand-500/20 text-brand-300 border-brand-500/30' : 'bg-surface-800 text-surface-500 border-surface-700')}>
                    {ns}
                  </button>
                ))}
                <div className="relative">
                  <Search className="absolute left-2 top-1/2 -translate-y-1/2 w-3 h-3 text-surface-500 pointer-events-none" />
                  <input value={cmSearch} onChange={e => setCmSearch(e.target.value)} placeholder="Search?"
                    className="pl-6 pr-2 py-1 rounded-lg bg-surface-800 border border-surface-700 text-xs text-white placeholder-surface-500 focus:outline-none focus:border-brand-500 w-36" />
                </div>
              </div>
            </div>
            <div className="divide-y divide-surface-800/40 max-h-[480px] overflow-y-auto">
              {configmapsData.configmaps
                .filter(cm => (!cmNsFilter || cm.namespace === cmNsFilter) && (!cmSearch || cm.name.toLowerCase().includes(cmSearch.toLowerCase()) || cm.keys.some(k => k.toLowerCase().includes(cmSearch.toLowerCase()))))
                .slice(0, 60)
                .map(cm => {
                  const key = `${cm.namespace}/${cm.name}`
                  const isOpen = cmExpanded === key
                  return (
                    <div key={key}>
                      <div className="px-4 py-2.5 flex items-center gap-3 hover:bg-surface-800/40 cursor-pointer" onClick={() => setCmExpanded(isOpen ? null : key)}>
                        {isOpen ? <ChevronDown className="w-3 h-3 text-brand-400 flex-shrink-0" /> : <ChevronRight className="w-3 h-3 text-surface-500 flex-shrink-0" />}
                        <span className="font-mono text-xs text-white">{cm.name}</span>
                        <span className="text-2xs text-surface-500">{cm.namespace}</span>
                        <span className="text-2xs text-surface-600 ml-auto">{cm.keyCount} key{cm.keyCount !== 1 ? 's' : ''} ? {Math.round(cm.sizeBytes / 1024 * 10) / 10} KB</span>
                        {cm.immutable && <span className="text-2xs px-1.5 py-0.5 rounded bg-surface-700 text-surface-400 border border-surface-600">immutable</span>}
                      </div>
                      {isOpen && (
                        <div className="px-6 pb-3 space-y-1.5">
                          {cm.keys.slice(0, 30).map(k => (
                            <div key={k} className="bg-surface-800/60 rounded-lg px-3 py-2">
                              <div className="text-2xs font-mono font-semibold text-brand-400 mb-0.5">{k}</div>
                              <pre className="text-2xs text-surface-300 whitespace-pre-wrap break-all max-h-24 overflow-y-auto font-mono leading-relaxed">{cm.data[k] ?? ''}</pre>
                            </div>
                          ))}
                          {cm.keyCount > 30 && <p className="text-2xs text-surface-500 italic">+{cm.keyCount - 30} more keys</p>}
                        </div>
                      )}
                    </div>
                  )
                })}
            </div>
          </div>
        )}

        {/* ?? API Deprecation Scanner ?? */}
        {tab === 'Policy' && (
          <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
            <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-3">
              <AlertTriangle className="w-4 h-4 text-warning" />
              <span className="text-sm font-semibold text-white">API Deprecation Scanner</span>
              {deprecationsData.serverVersion && <span className="text-2xs text-surface-500 font-mono">server {deprecationsData.serverVersion}</span>}
              {deprecationsData.findings.length > 0
                ? <span className="text-2xs px-2 py-0.5 rounded-full bg-danger/10 text-danger border border-danger/30 font-semibold animate-pulse">{deprecationsData.findings.length} deprecated resource{deprecationsData.findings.length !== 1 ? 's' : ''} found</span>
                : <span className="text-2xs px-2 py-0.5 rounded-full bg-success/10 text-success border border-success/20 font-semibold">Clean</span>}
            </div>
            {deprecationsData.findings.length === 0 ? (
              <div className="px-4 py-8 text-center text-xs text-surface-500">
                No resources using deprecated or removed API versions detected.
              </div>
            ) : (
              <div className="overflow-x-auto">
                <table className="w-full text-xs">
                  <thead>
                    <tr className="bg-surface-950 border-b border-surface-800">
                      {['Severity', 'Kind', 'Name', 'Namespace', 'Using', 'Removed In', 'Replace With'].map(h => (
                        <th key={h} className="px-3 py-2 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {deprecationsData.findings.map((f, i) => (
                      <tr key={i} className="border-b border-surface-800/50 hover:bg-surface-800/40">
                        <td className="px-3 py-2">
                          <span className={cn('text-2xs px-2 py-0.5 rounded-full font-semibold border', f.severity === 'removed' ? 'bg-danger/10 text-danger border-danger/30' : 'bg-warning/10 text-warning border-warning/30')}>
                            {f.severity}
                          </span>
                        </td>
                        <td className="px-3 py-2 font-mono text-surface-300">{f.kind}</td>
                        <td className="px-3 py-2 font-mono text-white">{f.name}</td>
                        <td className="px-3 py-2 text-surface-400">{f.namespace || '?'}</td>
                        <td className="px-3 py-2 font-mono text-danger text-2xs">{f.apiVersion}</td>
                        <td className="px-3 py-2 text-surface-300">v{f.removedIn}</td>
                        <td className="px-3 py-2 font-mono text-success text-2xs">{f.replacedBy}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        )}

        {/* -- RBAC TAB -- */}
        {tab === 'RBAC' && (
          <div className="space-y-4">

            {/* ?? RBAC Risk Scorecard ???????????????????????????????????? */}
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {([
                { label: 'Cluster-Admin',  value: rbacInsights.clusterAdminBindings.length, total: rbacInsights.totalBindings, sub: rbacInsights.clusterAdminBindings.length === 0 ? 'none ? good'    : `${rbacInsights.clusterAdminBindings.length} binding${rbacInsights.clusterAdminBindings.length > 1 ? 's' : ''}`, danger: true },
                { label: 'Wildcard Roles',  value: rbacInsights.wildcardRoles.length,         total: rbacInsights.totalRoles,    sub: rbacInsights.wildcardRoles.length   === 0 ? 'none detected'  : `verb or resource *`,        danger: rbacInsights.wildcardRoles.length > 0 },
                { label: 'Secret Access',   value: rbacInsights.secretRoles.length,            total: rbacInsights.totalRoles,    sub: rbacInsights.secretRoles.length     === 0 ? 'none detected'  : `roles read secrets`,        danger: rbacInsights.secretRoles.length > 0 },
                { label: 'Priv Escalation', value: rbacInsights.escalationRoles.length,        total: rbacInsights.totalRoles,    sub: rbacInsights.escalationRoles.length === 0 ? 'none detected'  : `impersonate/escalate/bind`,  danger: rbacInsights.escalationRoles.length > 0 },
                { label: 'Unused SAs',      value: rbacInsights.unusedSAs.length,              total: rbacInsights.totalSAs,      sub: rbacInsights.unusedSAs.length       === 0 ? 'all referenced' : `no bindings found`,          danger: false },
                { label: 'Orphaned Roles',  value: rbacInsights.orphanedRoles.length,          total: rbacInsights.totalRoles,    sub: rbacInsights.orphanedRoles.length   === 0 ? 'all bound'      : `no bindings found`,          danger: false },
              ] as { label: string; value: number; total: number; sub: string; danger: boolean }[]).map(s => {
                const isBad   = s.danger && s.value > 0
                const valCls  = isBad ? 'text-danger' : s.value === 0 ? 'text-success' : 'text-warning'
                const barCls  = isBad ? 'bg-danger'   : s.value === 0 ? 'bg-success'   : 'bg-warning'
                const barPct  = s.total > 0 ? Math.round((s.value / s.total) * 100) : 0
                return (
                  <div key={s.label} className={cn('rounded-xl border px-4 py-3', isBad && s.value > 0 ? 'border-danger/30 bg-danger/5' : 'bg-surface-900 border-surface-800')}>
                    <div className="text-2xs text-surface-500 font-semibold uppercase tracking-wider mb-1.5">{s.label}</div>
                    <div className="flex items-baseline gap-1 mb-1.5">
                      <span className={cn('text-2xl font-bold tabular-nums', valCls)}>{s.value}</span>
                      <span className="text-sm text-surface-600">/{s.total}</span>
                    </div>
                    <div className="w-full h-1 rounded-full bg-surface-700 overflow-hidden mb-1.5">
                      <div className={cn('h-full rounded-full', barCls)} style={{ width: `${Math.min(barPct, 100)}%` }} />
                    </div>
                    <div className="text-2xs text-surface-500">{s.sub}</div>
                  </div>
                )
              })}
            </div>

            {/* ?? RBAC Findings ?????????????????????????????????????????? */}
            {(rbacInsights.clusterAdminBindings.length + rbacInsights.wildcardRoles.length + rbacInsights.secretRoles.length + rbacInsights.escalationRoles.length) > 0 && (
              <div className="rounded-2xl bg-surface-900 border border-danger/25 overflow-hidden">
                <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2">
                  <Lock className="w-4 h-4 text-danger" />
                  <span className="text-sm font-semibold text-white">RBAC Risk Findings</span>
                  <span className="ml-0.5 text-2xs bg-danger/10 text-danger border border-danger/20 px-1.5 py-0.5 rounded-full font-semibold">
                    {rbacInsights.clusterAdminBindings.length + rbacInsights.wildcardRoles.length + rbacInsights.secretRoles.length + rbacInsights.escalationRoles.length}
                  </span>
                </div>
                <div className="divide-y divide-surface-800/40">
                  {rbacInsights.clusterAdminBindings.length > 0 && (
                    <div className="px-4 py-3">
                      <div className="flex items-center gap-2 mb-2">
                        <span className="w-2 h-2 rounded-full bg-danger flex-shrink-0" />
                        <span className="text-xs font-semibold text-white">{rbacInsights.clusterAdminBindings.length} cluster-admin binding{rbacInsights.clusterAdminBindings.length > 1 ? 's' : ''}</span>
                        <span className="text-2xs text-surface-500">&mdash; full cluster read/write access</span>
                      </div>
                      <div className="flex flex-wrap gap-1.5 ml-4">
                        {rbacInsights.clusterAdminBindings.flatMap(rb => rb.subjects.map((s, i) => (
                          <span key={`${rb.name}/${i}`} className="font-mono text-2xs bg-danger/10 border border-danger/20 text-danger px-1.5 py-0.5 rounded">
                            {s.kind === 'ServiceAccount' ? '?' : s.kind === 'User' ? '??' : '??'} {s.name}{s.namespace ? `@${s.namespace}` : ''}
                          </span>
                        )))}
                      </div>
                    </div>
                  )}
                  {rbacInsights.wildcardRoles.length > 0 && (
                    <div className="px-4 py-3">
                      <div className="flex items-center gap-2 mb-2">
                        <span className="w-2 h-2 rounded-full bg-warning flex-shrink-0" />
                        <span className="text-xs font-semibold text-white">{rbacInsights.wildcardRoles.length} role{rbacInsights.wildcardRoles.length > 1 ? 's' : ''} with wildcard verb or resource (*)</span>
                        <span className="text-2xs text-surface-500">&mdash; overly broad permissions</span>
                      </div>
                      <div className="flex flex-wrap gap-1 ml-4">
                        {rbacInsights.wildcardRoles.map(r => (
                          <span key={r.name} className="font-mono text-2xs bg-warning/10 border border-warning/20 text-warning px-1.5 py-0.5 rounded">{r.name}</span>
                        ))}
                      </div>
                    </div>
                  )}
                  {rbacInsights.secretRoles.length > 0 && (
                    <div className="px-4 py-3">
                      <div className="flex items-center gap-2 mb-2">
                        <span className="w-2 h-2 rounded-full bg-amber-400 flex-shrink-0" />
                        <span className="text-xs font-semibold text-white">{rbacInsights.secretRoles.length} role{rbacInsights.secretRoles.length > 1 ? 's' : ''} with secrets read access</span>
                        <span className="text-2xs text-surface-500">&mdash; can read sensitive credentials</span>
                      </div>
                      <div className="flex flex-wrap gap-1 ml-4">
                        {rbacInsights.secretRoles.map(r => (
                          <span key={r.name} className="font-mono text-2xs bg-amber-400/10 border border-amber-400/20 text-amber-400 px-1.5 py-0.5 rounded">{r.name}</span>
                        ))}
                      </div>
                    </div>
                  )}
                  {rbacInsights.escalationRoles.length > 0 && (
                    <div className="px-4 py-3">
                      <div className="flex items-center gap-2 mb-2">
                        <span className="w-2 h-2 rounded-full bg-purple-400 flex-shrink-0" />
                        <span className="text-xs font-semibold text-white">{rbacInsights.escalationRoles.length} role{rbacInsights.escalationRoles.length > 1 ? 's' : ''} with privilege escalation verbs</span>
                        <span className="text-2xs text-surface-500">&mdash; impersonate / escalate / bind</span>
                      </div>
                      <div className="flex flex-wrap gap-1 ml-4">
                        {rbacInsights.escalationRoles.map(r => (
                          <span key={r.name} className="font-mono text-2xs bg-purple-400/10 border border-purple-400/20 text-purple-400 px-1.5 py-0.5 rounded">{r.name}</span>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            )}

            {/* ?? Who Can Do X ??????????????????????????????????????????? */}
            <div className="rounded-2xl bg-surface-900 border border-surface-800 overflow-hidden">
              <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2">
                <Search className="w-4 h-4 text-brand-400" />
                <span className="text-sm font-semibold text-white">Who Can Do X?</span>
                <span className="text-2xs text-surface-500 font-normal ml-1">traverse bindings ? roles ? rules</span>
              </div>
              <div className="px-4 py-3 flex flex-wrap items-end gap-3">
                <div className="flex flex-col gap-1">
                  <label className="text-2xs text-surface-500 font-semibold uppercase tracking-wider">Verb</label>
                  <input value={whoCanVerb} onChange={e => setWhoCanVerb(e.target.value)}
                    placeholder="get, list, delete, *?"
                    className="bg-surface-800 border border-surface-700 rounded-lg px-3 py-1.5 text-xs text-white placeholder-surface-600 focus:outline-none focus:border-brand-500 w-44" />
                </div>
                <div className="flex flex-col gap-1">
                  <label className="text-2xs text-surface-500 font-semibold uppercase tracking-wider">Resource</label>
                  <input value={whoCanResource} onChange={e => setWhoCanResource(e.target.value)}
                    placeholder="pods, secrets, deployments?"
                    className="bg-surface-800 border border-surface-700 rounded-lg px-3 py-1.5 text-xs text-white placeholder-surface-600 focus:outline-none focus:border-brand-500 w-52" />
                </div>
                <div className="flex flex-col gap-1">
                  <label className="text-2xs text-surface-500 font-semibold uppercase tracking-wider">Namespace <span className="text-surface-600 normal-case">(optional)</span></label>
                  <input value={whoCanNs} onChange={e => setWhoCanNs(e.target.value)}
                    placeholder="all namespaces"
                    className="bg-surface-800 border border-surface-700 rounded-lg px-3 py-1.5 text-xs text-white placeholder-surface-600 focus:outline-none focus:border-brand-500 w-44" />
                </div>
                {(whoCanVerb || whoCanResource || whoCanNs) && (
                  <button onClick={() => { setWhoCanVerb(''); setWhoCanResource(''); setWhoCanNs('') }}
                    className="text-2xs text-surface-500 hover:text-white px-2 py-1.5 rounded-lg hover:bg-surface-700 transition-all mb-0.5">
                    Clear
                  </button>
                )}
              </div>
              {(whoCanVerb.trim() || whoCanResource.trim()) && (
                <div className="border-t border-surface-800 px-4 py-3">
                  {whoCanResults.length === 0 ? (
                    <div className="text-xs text-surface-500 italic">No subjects found with that permission.</div>
                  ) : (
                    <div className="flex flex-wrap gap-2">
                      {whoCanResults.map((res, i) => (
                        <div key={i} className="flex flex-col gap-0.5 bg-surface-800 border border-surface-700 rounded-lg px-3 py-2">
                          <div className="flex items-center gap-1.5">
                            <span className="text-xs">{res.kind === 'ServiceAccount' ? '?' : res.kind === 'User' ? '??' : '??'}</span>
                            <span className="font-mono text-xs font-semibold text-white">{res.subject}</span>
                            {res.bindingNs && <span className="text-2xs text-surface-500">@{res.bindingNs}</span>}
                          </div>
                          <div className="text-2xs text-surface-600 font-mono truncate max-w-[260px]" title={res.via}>{res.via}</div>
                        </div>
                      ))}
                    </div>
                  )}
                  <div className="mt-2 text-2xs text-surface-600">{whoCanResults.length} subject{whoCanResults.length !== 1 ? 's' : ''} matched</div>
                </div>
              )}
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
              {securityData.components.length === 0 ? (
                <div className="col-span-3 rounded-xl border border-surface-800 bg-surface-900 px-4 py-6 text-center text-surface-500 text-sm">
                  Component status unavailable (requires direct API access)
                </div>
              ) : securityData.components.map((c: K8sComponentStatus) => (
                <div key={c.name} className={`rounded-xl border px-4 py-3 flex items-center gap-3 ${c.healthy ? 'border-success/20 bg-success/5' : 'border-danger/30 bg-danger/5'}`}>
                  <Shield className={`w-6 h-6 flex-shrink-0 ${c.healthy ? 'text-success' : 'text-danger'}`} />
                  <div className="min-w-0">
                    <div className={`text-sm font-semibold ${c.healthy ? 'text-success' : 'text-danger'}`}>{c.name}</div>
                    <div className="text-2xs text-surface-500 truncate">{c.healthy ? 'Healthy' : (c.error || 'Unhealthy')}</div>
                  </div>
                </div>
              ))}
            </div>
            <div className="rounded-xl border border-surface-800 bg-surface-900 overflow-hidden">
              <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2">
                <Shield className="w-4 h-4 text-brand-400" />
                <span className="text-sm font-semibold text-white">Secrets by Namespace</span>
                <span className="text-2xs text-surface-500 font-normal ml-1">
                  ({securityData.secrets.reduce((a: number, s: K8sSecretCount) => a + s.count, 0)} total &mdash; names only, values never exposed)
                </span>
              </div>
              <div className="overflow-x-auto">
              <table className="w-full text-sm">
                <thead>
                  <tr className="border-b border-surface-800 bg-surface-950">
                    {['Namespace', 'Count', 'Types'].map(h => (
                      <th key={h} className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {securityData.secrets.map((s: K8sSecretCount) => {
                    const isSystem = ['kube-system', 'kube-public', 'kube-node-lease'].includes(s.namespace)
                    const items = s.items ?? []
                    const isExpanded = expandedSecretNs === s.namespace
                    const byType = items.reduce((acc, item) => {
                      const short = SECRET_TYPE_SHORT[item.type] ?? item.type.split('/').pop() ?? item.type
                      acc[short] = (acc[short] ?? 0) + 1
                      return acc
                    }, {} as Record<string, number>)
                    return (
                      <Fragment key={s.namespace}>
                        <tr
                          className={cn('border-b border-surface-800/50 hover:bg-surface-800/40', items.length > 0 && 'cursor-pointer')}
                          onClick={() => items.length > 0 && setExpandedSecretNs(isExpanded ? null : s.namespace)}
                        >
                          <td className="px-4 py-2.5 font-mono text-white text-xs">
                            <div className="flex items-center gap-1.5">
                              {items.length > 0
                                ? (isExpanded
                                    ? <ChevronDown className="w-3 h-3 text-surface-500 flex-shrink-0" />
                                    : <ChevronRight className="w-3 h-3 text-surface-500 flex-shrink-0" />)
                                : <span className="w-3" />}
                              {s.namespace}
                              {isSystem && <span className="ml-1 text-2xs px-1.5 py-0.5 rounded border bg-surface-700/50 text-surface-500 border-surface-700">sys</span>}
                            </div>
                          </td>
                          <td className="px-4 py-2.5">
                            <div className="flex items-center gap-2">
                              <div className="h-1.5 rounded-full bg-surface-800 w-24">
                                <div className="h-full rounded-full bg-brand-500" style={{ width: `${Math.min((s.count / (securityData.secrets[0]?.count || 1)) * 100, 100)}%` }} />
                              </div>
                              <span className="text-surface-300 text-xs tabular-nums font-semibold">{s.count}</span>
                            </div>
                          </td>
                          <td className="px-4 py-2.5">
                            <div className="flex flex-wrap gap-1">
                              {Object.entries(byType).map(([typeName, cnt]) => (
                                <span key={typeName} className={cn(
                                  'text-2xs px-1.5 py-0.5 rounded-full border tabular-nums',
                                  typeName === 'Opaque'   ? 'bg-amber-500/10 text-amber-300 border-amber-500/20' :
                                  typeName === 'TLS'      ? 'bg-teal-500/10 text-teal-300 border-teal-500/20' :
                                  typeName === 'Registry' ? 'bg-brand-500/10 text-brand-300 border-brand-500/20' :
                                  'bg-surface-700/50 text-surface-400 border-surface-600'
                                )}>{cnt} {typeName}</span>
                              ))}
                            </div>
                          </td>
                        </tr>
                        {isExpanded && items.length > 0 && (
                          <tr className="border-b border-surface-800">
                            <td colSpan={3} className="bg-surface-950 px-4 py-3">
                              <div className="grid grid-cols-3 gap-1.5 max-h-56 overflow-y-auto pr-1">
                                {[...items].sort((a, b) => a.name.localeCompare(b.name)).map(item => {
                                  const short = SECRET_TYPE_SHORT[item.type] ?? item.type.split('/').pop() ?? item.type
                                  const ageDays = Math.round((Date.now() - new Date(item.createdAt).getTime()) / 86_400_000)
                                  const ageStr = ageDays === 0 ? 'today' : ageDays < 30 ? `${ageDays}d` : `${Math.round(ageDays / 30)}mo`
                                  return (
                                    <div key={item.name} className="flex items-center gap-2 bg-surface-900 border border-surface-800 rounded-lg px-2.5 py-1.5 min-w-0">
                                      <span className="font-mono text-2xs text-white truncate flex-1 min-w-0" title={item.name}>{item.name}</span>
                                      <span className={cn('text-2xs flex-shrink-0',
                                        short === 'Opaque'   ? 'text-amber-400' :
                                        short === 'TLS'      ? 'text-teal-400' :
                                        short === 'Registry' ? 'text-brand-400' :
                                        'text-surface-500'
                                      )}>{short}</span>
                                      <span className="text-2xs text-surface-600 flex-shrink-0">{ageStr}</span>
                                    </div>
                                  )
                                })}
                              </div>
                            </td>
                          </tr>
                        )}
                      </Fragment>
                    )
                  })}
                </tbody>
              </table>
              </div>
            </div>
            <div className="rounded-xl border border-surface-800 bg-surface-900 overflow-hidden">
              <div className="px-4 py-3 border-b border-surface-800">
                <span className="text-sm font-semibold text-white flex items-center gap-2">
                  <Shield className="w-4 h-4 text-purple-400" /> Service Accounts
                  <span className="text-2xs text-surface-500 font-normal">({securityData.serviceAccounts.length})</span>
                </span>
              </div>
              <div className="overflow-x-auto overflow-y-auto max-h-[360px]">
                <table className="w-full text-sm">
                  <thead className="sticky top-0 z-10">
                    <tr className="border-b border-surface-800 bg-surface-950">
                      {['Name', 'Namespace', 'Bound Roles', 'Secrets', 'Created', ''].map(h => (
                        <th key={h} className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {securityData.serviceAccounts.map((sa: K8sServiceAccount) => {
                      const ago = Math.round((Date.now() - new Date(sa.createdAt).getTime()) / 60000)
                      const ageStr = ago < 60 ? `${ago}m ago` : ago < 1440 ? `${Math.round(ago/60)}h ago` : `${Math.round(ago/1440)}d ago`
                      const isDefault = sa.name === 'default'
                      const saKey = `${sa.namespace}/${sa.name}`
                      const boundCount = rbacInsights.saBoundCount[saKey] ?? 0
                      const bindings   = rbacInsights.saBindings[saKey] ?? []
                      const isExpanded = expandedSA === saKey
                      return (
                        <Fragment key={saKey}>
                          <tr
                            className={cn('border-b border-surface-800/50 hover:bg-surface-800/40 cursor-pointer', isExpanded && 'bg-surface-800/20')}
                            onClick={() => setExpandedSA(isExpanded ? null : saKey)}
                          >
                            <td className="px-4 py-2.5 font-mono text-xs text-white">
                              <div className="flex items-center gap-1.5">
                                {isExpanded
                                  ? <ChevronDown className="w-3 h-3 text-surface-400 flex-shrink-0" />
                                  : <ChevronRight className="w-3 h-3 text-surface-500 flex-shrink-0" />}
                                {sa.name}
                                {isDefault && <span className="text-2xs px-1.5 py-0.5 rounded border bg-surface-700/50 text-surface-500 border-surface-700">default</span>}
                              </div>
                            </td>
                            <td className="px-4 py-2.5 text-surface-400 text-xs">{sa.namespace}</td>
                            <td className="px-4 py-2.5">
                              {boundCount > 0
                                ? <span className="text-xs font-semibold text-brand-400 tabular-nums">{boundCount}</span>
                                : <span className="text-surface-600 text-2xs">?</span>}
                            </td>
                            <td className="px-4 py-2.5 text-surface-400 text-xs tabular-nums">{sa.secrets}</td>
                            <td className="px-4 py-2.5 text-surface-600 text-xs">{ageStr}</td>
                            <td className="px-4 py-2.5" onClick={e => e.stopPropagation()}>
                              <div className="flex items-center gap-1">
                                <button onClick={() => setDescribeTarget({ kind: 'ServiceAccount', namespace: sa.namespace, name: sa.name })}
                                  className="p-1.5 rounded-lg text-surface-600 hover:text-amber-400 hover:bg-amber-400/10 transition-all" title="Describe">
                                  <FileSearch className="w-3.5 h-3.5" />
                                </button>
                                <button onClick={() => setYamlTarget({ kind: 'ServiceAccount', namespace: sa.namespace, name: sa.name })}
                                  className="p-1.5 rounded-lg text-surface-600 hover:text-brand-400 hover:bg-brand-400/10 transition-all" title="YAML">
                                  <FileCode2 className="w-3.5 h-3.5" />
                                </button>
                              </div>
                            </td>
                          </tr>
                          {isExpanded && (
                            <tr className="border-b border-surface-800">
                              <td colSpan={6} className="bg-surface-950 px-6 py-3">
                                {bindings.length === 0 ? (
                                  <span className="text-2xs text-surface-600 italic">No bindings found ? this SA has no RBAC permissions</span>
                                ) : (
                                  <div className="flex flex-col gap-1.5">
                                    {bindings.map((b, i) => (
                                      <div key={i} className="flex items-center gap-2 text-2xs">
                                        <span className="font-mono text-surface-400">{b.bindingName}</span>
                                        <span className="text-surface-600">?</span>
                                        <span className="font-mono font-semibold text-white">{b.roleName}</span>
                                        <span className={cn('px-1.5 py-0.5 rounded-full border font-semibold',
                                          b.roleKind === 'ClusterRole'
                                            ? 'bg-purple-500/10 text-purple-400 border-purple-500/20'
                                            : 'bg-brand-500/10 text-brand-400 border-brand-500/20'
                                        )}>{b.roleKind}</span>
                                        {b.bindingNs
                                          ? <span className="text-surface-600">in {b.bindingNs}</span>
                                          : <span className="text-surface-600 italic">cluster-wide</span>}
                                      </div>
                                    ))}
                                  </div>
                                )}
                              </td>
                            </tr>
                          )}
                        </Fragment>
                      )
                    })}
                    {securityData.serviceAccounts.length === 0 && (
                      <tr><td colSpan={6} className="px-4 py-8 text-center text-surface-600 text-sm">No service accounts found</td></tr>
                    )}
                  </tbody>
                </table>
              </div>
            </div>

            {/* Roles */}
            {(securityData.roles.length > 0 || securityData.clusterRoles.length > 0) && (
              <div className="rounded-xl border border-surface-800 bg-surface-900 overflow-hidden">
                <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2">
                  <Lock className="w-4 h-4 text-amber-400" />
                  <span className="text-sm font-semibold text-white">Roles</span>
                  <span className="text-2xs text-surface-500 ml-1">({securityData.roles.length} namespace ? {securityData.clusterRoles.length} cluster)</span>
                  <div className="ml-auto relative w-48">
                    <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-surface-500 pointer-events-none" />
                    <input value={rbacSearch} onChange={e => setRbacSearch(e.target.value)} placeholder="Search roles?"
                      className="w-full bg-surface-800 border border-surface-700 rounded-lg pl-8 pr-3 py-1.5 text-2xs text-white placeholder-surface-500 focus:outline-none focus:border-brand-500" />
                  </div>
                </div>
                <div className="overflow-x-auto overflow-y-auto max-h-[480px]">
                  <table className="w-full text-sm">
                    <thead className="sticky top-0 z-10">
                      <tr className="border-b border-surface-800 bg-surface-950">
                        {['Name', 'Namespace', 'Scope', 'Risk', 'Rules', ''].map(h => (
                          <th key={h} className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {[...securityData.roles.map((r: K8sRole) => ({ ...r, scope: 'Namespace' })),
                        ...securityData.clusterRoles.map((r: K8sRole) => ({ ...r, scope: 'Cluster' }))
                      ].filter((r: K8sRole & { scope: string }) =>
                        !rbacSearch || r.name.toLowerCase().includes(rbacSearch.toLowerCase()) || (r.namespace ?? '').toLowerCase().includes(rbacSearch.toLowerCase())
                      ).map((r: K8sRole & { scope: string }) => {
                        const roleKey = `${r.namespace ?? '_'}/${r.name}`
                        const isExpanded = expandedRole === roleKey
                        const isWildcard = r.rules.some((rule: K8sRoleRule) => rule.verbs.includes('*') || rule.resources.includes('*'))
                        const isSecret   = r.rules.some((rule: K8sRoleRule) =>
                          (rule.resources.includes('secrets') || rule.resources.includes('*')) &&
                          rule.verbs.some((v: string) => ['get', 'list', 'watch', '*'].includes(v))
                        )
                        const riskLabel = isWildcard ? 'wildcard' : isSecret ? 'secret' : null
                        const riskCls   = isWildcard ? 'bg-warning/10 text-warning border-warning/20' : 'bg-amber-400/10 text-amber-400 border-amber-400/20'
                        return (
                          <Fragment key={roleKey}>
                            <tr className={cn('border-b border-surface-800/50 hover:bg-surface-800/40 cursor-pointer', isExpanded && 'bg-surface-800/20')}
                              onClick={() => setExpandedRole(isExpanded ? null : roleKey)}>
                              <td className="px-4 py-2.5 font-mono text-white text-xs">
                                <div className="flex items-center gap-1.5">
                                  {isExpanded ? <ChevronDown className="w-3 h-3 text-surface-400 flex-shrink-0" /> : <ChevronRight className="w-3 h-3 text-surface-500 flex-shrink-0" />}
                                  {r.name}
                                </div>
                              </td>
                              <td className="px-4 py-2.5 text-surface-400 text-xs">{r.namespace ?? <span className="text-surface-600">?</span>}</td>
                              <td className="px-4 py-2.5">
                                <span className={cn('text-2xs px-1.5 py-0.5 rounded-full font-semibold border',
                                  r.scope === 'Cluster' ? 'bg-purple-500/10 text-purple-400 border-purple-500/20' : 'bg-brand-500/10 text-brand-400 border-brand-500/20'
                                )}>{r.scope}</span>
                              </td>
                              <td className="px-4 py-2.5">
                                {riskLabel
                                  ? <span className={cn('text-2xs px-1.5 py-0.5 rounded font-semibold border', riskCls)}>{riskLabel}</span>
                                  : <span className="text-surface-600 text-2xs">?</span>}
                              </td>
                              <td className="px-4 py-2.5 text-surface-400 text-xs tabular-nums">{(r.rules ?? []).length}</td>
                              <td className="px-4 py-2.5" onClick={e => e.stopPropagation()}>
                                <div className="flex items-center gap-1">
                                  <button onClick={() => setDescribeTarget({ kind: r.isCluster ? 'ClusterRole' : 'Role', namespace: r.namespace ?? '', name: r.name })}
                                    className="p-1.5 rounded-lg text-surface-600 hover:text-amber-400 hover:bg-amber-400/10 transition-all" title="Describe">
                                    <FileSearch className="w-3.5 h-3.5" />
                                  </button>
                                  <button onClick={() => setYamlTarget({ kind: r.isCluster ? 'ClusterRole' : 'Role', namespace: r.namespace ?? '', name: r.name })}
                                    className="p-1.5 rounded-lg text-surface-600 hover:text-brand-400 hover:bg-brand-400/10 transition-all" title="YAML">
                                    <FileCode2 className="w-3.5 h-3.5" />
                                  </button>
                                </div>
                              </td>
                            </tr>
                            {isExpanded && (
                              <tr className="bg-surface-950/60 border-b border-surface-800/50">
                                <td colSpan={6} className="px-6 py-3">
                                  <div className="space-y-1.5">
                                    {(r.rules ?? []).map((rule: K8sRoleRule, ri: number) => (
                                      <div key={ri} className="grid grid-cols-3 gap-4 bg-surface-900 rounded-lg px-3 py-2 text-2xs">
                                        <div>
                                          <span className="text-surface-600 mr-1.5">apiGroups</span>
                                          <span className="font-mono text-surface-400">{(rule.apiGroups ?? []).join(', ') || <span className="text-surface-600 italic">core</span>}</span>
                                        </div>
                                        <div>
                                          <span className="text-surface-600 mr-1.5">resources</span>
                                          <span className="font-mono text-brand-300">{(rule.resources ?? []).join(', ') || '?'}</span>
                                        </div>
                                        <div>
                                          <span className="text-surface-600 mr-1.5">verbs</span>
                                          <span className={cn('font-mono', (rule.verbs ?? []).includes('*') ? 'text-danger' : 'text-surface-300')}>
                                            {(rule.verbs ?? []).join(', ') || '?'}
                                          </span>
                                        </div>
                                      </div>
                                    ))}
                                    {(r.rules ?? []).length === 0 && <div className="text-2xs text-surface-600 italic">No rules defined</div>}
                                  </div>
                                </td>
                              </tr>
                            )}
                          </Fragment>
                        )
                      })}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            {/* RoleBindings */}
            {(securityData.roleBindings.length > 0 || securityData.clusterRoleBindings.length > 0) && (
              <div className="rounded-xl border border-surface-800 bg-surface-900 overflow-hidden">
                <div className="px-4 py-3 border-b border-surface-800 flex items-center gap-2">
                  <GitBranch className="w-4 h-4 text-brand-400" />
                  <span className="text-sm font-semibold text-white">Role Bindings</span>
                  <span className="text-2xs text-surface-500 ml-1">({securityData.roleBindings.length} namespace ? {securityData.clusterRoleBindings.length} cluster)</span>
                  <div className="ml-auto relative w-48">
                    <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-surface-500 pointer-events-none" />
                    <input value={rbacSearch} onChange={e => setRbacSearch(e.target.value)} placeholder="Search bindings?"
                      className="w-full bg-surface-800 border border-surface-700 rounded-lg pl-8 pr-3 py-1.5 text-2xs text-white placeholder-surface-500 focus:outline-none focus:border-brand-500" />
                  </div>
                </div>
                <div className="overflow-x-auto overflow-y-auto max-h-[360px]">
                  <table className="w-full text-sm">
                    <thead className="sticky top-0 z-10">
                      <tr className="border-b border-surface-800 bg-surface-950">
                        {['Binding', 'Namespace', 'Role Ref', 'Subjects', ''].map(h => (
                          <th key={h} className="px-4 py-2.5 text-left text-2xs font-semibold text-surface-500 uppercase tracking-wider">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {[...securityData.roleBindings, ...securityData.clusterRoleBindings]
                        .filter((rb: K8sRoleBinding) => !rbacSearch ||
                          rb.name.toLowerCase().includes(rbacSearch.toLowerCase()) ||
                          rb.roleRef.name.toLowerCase().includes(rbacSearch.toLowerCase()) ||
                          rb.subjects.some((s: any) => s.name.toLowerCase().includes(rbacSearch.toLowerCase()))
                        )
                        .map((rb: K8sRoleBinding) => {
                          const isAdmin = rb.roleRef.name === 'cluster-admin'
                          return (
                            <tr key={`${rb.namespace ?? '_'}/${rb.name}`} className={cn('border-b border-surface-800/50 hover:bg-surface-800/40', isAdmin && 'bg-danger/5')}>
                              <td className="px-4 py-2.5 font-mono text-white text-xs">{rb.name}</td>
                              <td className="px-4 py-2.5 text-surface-400 text-xs">{rb.namespace ?? <span className="text-surface-600 italic">cluster-wide</span>}</td>
                              <td className="px-4 py-2.5">
                                <span className={cn('font-mono text-2xs px-1.5 py-0.5 rounded', isAdmin ? 'bg-danger/10 text-danger' : 'bg-amber-500/10 text-amber-300')}>
                                  {rb.roleRef?.kind}/{rb.roleRef?.name}
                                </span>
                              </td>
                              <td className="px-4 py-2.5">
                                <div className="flex flex-wrap gap-1">
                                  {(rb.subjects ?? []).slice(0, 4).map((s: any, i: number) => (
                                    <span key={i} className="text-2xs px-1.5 py-0.5 rounded bg-surface-800 text-surface-300 font-mono">
                                      {s.kind === 'ServiceAccount' ? '?' : s.kind === 'User' ? '??' : '??'} {s.name}
                                    </span>
                                  ))}
                                  {(rb.subjects ?? []).length > 4 && <span className="text-2xs text-surface-600">+{(rb.subjects ?? []).length - 4}</span>}
                                </div>
                              </td>
                              <td className="px-4 py-2.5" onClick={e => e.stopPropagation()}>
                                <div className="flex items-center gap-1">
                                  <button onClick={() => setDescribeTarget({ kind: rb.isCluster ? 'ClusterRoleBinding' : 'RoleBinding', namespace: rb.namespace ?? '', name: rb.name })}
                                    className="p-1.5 rounded-lg text-surface-600 hover:text-amber-400 hover:bg-amber-400/10 transition-all" title="Describe">
                                    <FileSearch className="w-3.5 h-3.5" />
                                  </button>
                                  <button onClick={() => setYamlTarget({ kind: rb.isCluster ? 'ClusterRoleBinding' : 'RoleBinding', namespace: rb.namespace ?? '', name: rb.name })}
                                    className="p-1.5 rounded-lg text-surface-600 hover:text-brand-400 hover:bg-brand-400/10 transition-all" title="YAML">
                                    <FileCode2 className="w-3.5 h-3.5" />
                                  </button>
                                </div>
                              </td>
                            </tr>
                          )
                        })}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
    {/* Container Detail Drawer */}
    {selectedContainer && (
      <>
        <div className="fixed inset-0 bg-black/40 z-40" onClick={() => setSelectedContainer(null)} />
        <ContainerDrawer
          container={selectedContainer.container}
          pod={selectedContainer.pod}
          namespace={selectedContainer.namespace}
          onClose={() => setSelectedContainer(null)}
          onLog={() => { setLogTarget({ pod: selectedContainer.pod, namespace: selectedContainer.namespace, container: selectedContainer.container.name }); setSelectedContainer(null) }}
          onExec={() => { setExecTarget({ pod: selectedContainer.pod, namespace: selectedContainer.namespace, container: selectedContainer.container.name }); setSelectedContainer(null) }}
        />
      </>
    )}
    {/* Exec Terminal */}
    {execTarget && (
      <>
        <div className="fixed inset-0 bg-black/40 z-40" onClick={() => setExecTarget(null)} />
        <ExecTerminal pod={execTarget.pod} namespace={execTarget.namespace} container={execTarget.container} onClose={() => setExecTarget(null)} />
      </>
    )}
    {/* Log Viewer */}
    {logTarget && (
      <>
        <div className="fixed inset-0 bg-black/40 z-40" onClick={() => setLogTarget(null)} />
        <LogViewer pod={logTarget.pod} namespace={logTarget.namespace} container={logTarget.container} onClose={() => setLogTarget(null)} />
      </>
    )}
    {/* Describe Viewer */}
    {describeTarget && (
      <>
        <div className="fixed inset-0 bg-black/40 z-40" onClick={() => setDescribeTarget(null)} />
        <DescribeViewer kind={describeTarget.kind} namespace={describeTarget.namespace} name={describeTarget.name} onClose={() => setDescribeTarget(null)} />
      </>
    )}
    {/* YAML Viewer */}
    {yamlTarget && (
      <>
        <div className="fixed inset-0 bg-black/40 z-40" onClick={() => setYamlTarget(null)} />
        <YamlViewer kind={yamlTarget.kind} namespace={yamlTarget.namespace} name={yamlTarget.name} onClose={() => setYamlTarget(null)} />
      </>
    )}
    {/* Scale Modal */}
    {scaleTarget && (
      <ScaleModal deployment={scaleTarget} onClose={() => setScaleTarget(null)} onDone={() => setTimeout(refreshWorkloads, 1500)} />
    )}
    {/* Scale StatefulSet Modal */}
    {scaleStsTarget && (
      <ScaleSTSModal sts={scaleStsTarget} onClose={() => setScaleStsTarget(null)} onDone={() => { setScaleStsTarget(null); setTimeout(refreshWorkloads, 2000) }} />
    )}
    {/* CrashLoop Quick Fix Modal */}
    {crashFix && (
      <CrashFixModal
        pod={crashFix.pod}
        namespace={crashFix.namespace}
        onClose={() => setCrashFix(null)}
        onLog={() => setLogTarget({ pod: crashFix.pod, namespace: crashFix.namespace })}
      />
    )}
    {/* Delete Pod Confirm */}
    {deletePod && (
      <div className="fixed inset-0 z-50 flex items-center justify-center">
        <div className="absolute inset-0 bg-black/60" onClick={() => setDeletePod(null)} />
        <div className="relative bg-surface-900 border border-surface-700 rounded-2xl p-6 w-80 shadow-2xl space-y-4">
          <h3 className="text-sm font-bold text-white flex items-center gap-2"><Trash2 className="w-4 h-4 text-danger" />Delete Pod</h3>
          <p className="text-xs text-surface-400">
            Delete <span className="font-mono text-white">{deletePod.name}</span> from namespace <span className="font-mono text-white">{deletePod.namespace}</span>?
            <br /><span className="text-danger">This will terminate the pod immediately.</span>
          </p>
          <div className="flex gap-2 pt-1">
            <button onClick={() => setDeletePod(null)} className="flex-1 px-3 py-2 rounded-xl text-xs text-surface-400 bg-surface-800 hover:bg-surface-700">Cancel</button>
            <button onClick={handleDeletePod} disabled={deletingPod} className="flex-1 px-3 py-2 rounded-xl text-xs font-semibold text-white bg-danger hover:bg-red-700 disabled:opacity-40">
              {deletingPod ? 'Deleting?' : 'Delete'}
            </button>
          </div>
        </div>
      </div>
    )}
    {/* Register / Connect Cluster Modal */}
    {showConnectModal && (
      <div className="fixed inset-0 z-50 flex items-center justify-center">
        <div className="absolute inset-0 bg-black/60" onClick={() => setShowConnectModal(false)} />
        <div className="relative bg-surface-900 border border-surface-700 rounded-2xl p-6 w-[480px] shadow-2xl space-y-4">
          <div className="flex items-center justify-between">
            <h3 className="text-sm font-bold text-white flex items-center gap-2">
              <Globe className="w-4 h-4 text-brand-400" /> Register Cluster
            </h3>
            <button onClick={() => setShowConnectModal(false)} className="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-surface-700 text-surface-400 hover:text-white">
              <X className="w-4 h-4" />
            </button>
          </div>
          {connectSuccess ? (
            <div className="flex flex-col items-center gap-3 py-6">
              <CheckCircle2 className="w-10 h-10 text-success" />
              <p className="text-sm font-semibold text-white">Cluster Registered</p>
              <p className="text-xs text-surface-500 text-center max-w-xs">
                VynOps will connect to the kubectl proxy and begin collecting metrics within 30 seconds.
              </p>
              <button onClick={() => setShowConnectModal(false)} className="mt-2 px-5 py-2 text-xs font-semibold text-white bg-brand-500 hover:bg-brand-600 rounded-xl">
                Done
              </button>
            </div>
          ) : (
            <>
              <p className="text-xs text-surface-500">
                Run a kubectl proxy on the target cluster, then register the URL here. VynOps will poll it for metrics.
              </p>
              <div className="bg-surface-800 rounded-xl px-3 py-2 font-mono text-xs text-success select-all">
                kubectl proxy --port=8001 --address=0.0.0.0 --accept-hosts=&apos;.*&apos; &amp;
              </div>
              <div className="space-y-3">
                <div>
                  <label className="text-2xs text-surface-500 mb-1 block">Cluster Name <span className="text-danger">*</span></label>
                  <input
                    value={connectForm.name}
                    onChange={e => setConnectForm(f => ({ ...f, name: e.target.value }))}
                    placeholder="eks-prod-us-east"
                    className="w-full bg-surface-800 border border-surface-700 rounded-xl px-3 py-2 text-xs text-white placeholder-surface-600 outline-none focus:border-brand-500 transition-colors"
                  />
                </div>
                <div>
                  <label className="text-2xs text-surface-500 mb-1 block">kubectl Proxy URL <span className="text-danger">*</span></label>
                  <input
                    value={connectForm.url}
                    onChange={e => setConnectForm(f => ({ ...f, url: e.target.value }))}
                    placeholder="http://10.0.0.1:8001"
                    className={cn('w-full bg-surface-800 border rounded-xl px-3 py-2 text-xs font-mono text-white placeholder-surface-600 outline-none focus:border-brand-500 transition-colors',
                      connectForm.url && !/^https?:\/\/.+/.test(connectForm.url) ? 'border-danger/60' : 'border-surface-700'
                    )}
                  />
                  {connectForm.url && !/^https?:\/\/.+/.test(connectForm.url) && (
                    <p className="text-2xs text-danger mt-1">Must start with http:// or https://</p>
                  )}
                </div>
                <div>
                  <label className="text-2xs text-surface-500 mb-1 block">Prometheus URL <span className="text-surface-600">(optional)</span></label>
                  <input
                    value={connectForm.promUrl}
                    onChange={e => setConnectForm(f => ({ ...f, promUrl: e.target.value }))}
                    placeholder="http://10.0.0.1:9090"
                    className="w-full bg-surface-800 border border-surface-700 rounded-xl px-3 py-2 text-xs font-mono text-white placeholder-surface-600 outline-none focus:border-brand-500 transition-colors"
                  />
                </div>
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="text-2xs text-surface-500 mb-1 block">Cloud Provider</label>
                    <select
                      value={connectForm.provider}
                      onChange={e => setConnectForm(f => ({ ...f, provider: e.target.value }))}
                      className="w-full bg-surface-800 border border-surface-700 rounded-xl px-3 py-2 text-xs text-white outline-none focus:border-brand-500 transition-colors"
                    >
                      <option value="aws">AWS (EKS)</option>
                      <option value="azure">Azure (AKS)</option>
                      <option value="gcp">GCP (GKE)</option>
                      <option value="on-prem">On-Prem / k3s</option>
                    </select>
                  </div>
                  <div>
                    <label className="text-2xs text-surface-500 mb-1 block">Region</label>
                    <input
                      value={connectForm.region}
                      onChange={e => setConnectForm(f => ({ ...f, region: e.target.value }))}
                      placeholder="us-east-1"
                      className="w-full bg-surface-800 border border-surface-700 rounded-xl px-3 py-2 text-xs text-white placeholder-surface-600 outline-none focus:border-brand-500 transition-colors"
                    />
                  </div>
                </div>
              </div>
              {connectError && (
                <p className="text-xs text-danger bg-danger/10 border border-danger/20 rounded-xl px-3 py-2">{connectError}</p>
              )}
              <div className="flex gap-2 pt-1">
                <button onClick={() => setShowConnectModal(false)} className="flex-1 px-3 py-2 rounded-xl text-xs text-surface-400 bg-surface-800 hover:bg-surface-700">
                  Cancel
                </button>
                <button
                  disabled={!connectForm.name || !connectForm.url || !/^https?:\/\/.+/.test(connectForm.url) || connectLoading}
                  onClick={handleRegisterCluster}
                  className="flex-1 px-3 py-2 rounded-xl text-xs font-semibold text-white bg-brand-500 hover:bg-brand-600 disabled:opacity-40 transition-colors flex items-center justify-center gap-1.5"
                >
                  {connectLoading ? <><Loader2 className="w-3.5 h-3.5 animate-spin" /> Probing?</> : 'Register & Connect'}
                </button>
              </div>
            </>
          )}
        </div>
      </div>
    )}
    </>
  )
}

export default function KubernetesPage() {
  return (
    <Suspense fallback={null}>
      <KubernetesInner />
    </Suspense>
  )
}
