                <div className="flex items-center justify-between text-2xs">
                  <span className="text-surface-500">CPU Actual</span>
                  <span className="font-mono font-semibold text-surface-200">{metrics.cpuUsageCores.toFixed(3)} cores{metrics.cpuUsagePct !== undefined && <span className="text-warning ml-1">({metrics.cpuUsagePct}%)</span>}</span>
                </div>
                {metrics.sparkCpu.length > 1 && <Sparkline data={metrics.sparkCpu} color="#22c55e" width={180} height={28} />}
              </div>
              <div className="bg-surface-800 rounded-xl p-3 space-y-1.5">
                <div className="flex items-center justify-between text-2xs">
                  <span className="text-surface-500">Mem Actual</span>
                  <span className="font-mono font-semibold text-surface-200">{metrics.memUsageMiB.toFixed(0)} MiB{metrics.memUsagePct !== undefined && <span className="text-warning ml-1">({metrics.memUsagePct}%)</span>}</span>
                </div>
                {metrics.sparkMem.length > 1 && <Sparkline data={metrics.sparkMem} color="#a78bfa" width={180} height={28} />}
              </div>
            </div>
          </div>
        )}

