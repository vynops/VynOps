              <div key={String(l)} className="bg-surface-800 rounded-lg px-3 py-2 flex justify-between">
                <span className="text-2xs text-surface-500">{l}</span>
                <span className="text-2xs font-mono text-surface-300">{v ?? <span className="text-surface-600">unset</span>}</span>
              </div>
            ))}
          </div>
        </div>

        {/* Probes */}
        {(container.livenessProbe || container.readinessProbe || container.startupProbe) && (
          <div>
            <h4 className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-2 flex items-center gap-1.5"><Eye className="w-3 h-3" />Health Probes</h4>
            <div className="space-y-1.5">
              {[['Liveness', container.livenessProbe], ['Readiness', container.readinessProbe], ['Startup', container.startupProbe]].filter(([, v]) => v).map(([l, v]) => (
                <div key={String(l)} className="bg-surface-800 rounded-lg px-3 py-2 flex justify-between">
                  <span className="text-2xs text-surface-500">{l}</span>
                  <span className="text-2xs font-mono text-surface-300">{v}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Ports */}
        {container.ports.length > 0 && (
          <div>
            <h4 className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-2 flex items-center gap-1.5"><Plug className="w-3 h-3" />Ports</h4>
            <div className="flex flex-wrap gap-2">
              {container.ports.map((p, i) => (
                <span key={i} className="bg-surface-800 text-2xs font-mono px-2 py-1 rounded-lg text-brand-300">
                  {p.name ? `${p.name}: ` : ''}{p.containerPort}/{p.protocol}
                </span>
              ))}
            </div>
          </div>
        )}

        {/* Volume Mounts */}
        {container.volumeMounts.length > 0 && (
          <div>
            <h4 className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-2 flex items-center gap-1.5"><FolderOpen className="w-3 h-3" />Volume Mounts</h4>
            <div className="space-y-1">
