        {metrics && (
          <div>
            <h4 className="text-2xs font-semibold text-surface-400 uppercase tracking-wider mb-3 flex items-center gap-1.5"><Activity className="w-3 h-3 text-success" />Live Usage (30min)</h4>
            <div className="grid grid-cols-2 gap-3">
