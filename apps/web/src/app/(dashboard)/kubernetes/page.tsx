                                {sum.stsCount > 0  && <span className="text-surface-300" title={`${sum.stsCount} StatefulSets`}>{sum.stsCount}<span className="text-surface-600">S</span></span>}
                                {sum.dsCount > 0   && <span className="text-surface-300" title={`${sum.dsCount} DaemonSets`}>{sum.dsCount}<span className="text-surface-600">DS</span></span>}
                                {sum.svcCount > 0  && <span className="text-surface-500" title={`${sum.svcCount} Services`}>{sum.svcCount}<span className="text-surface-600">Svc</span></span>}
                                {sum.depCount === 0 && sum.stsCount === 0 && sum.dsCount === 0 && <span className="text-surface-600">?</span>}
                              </div>
                            </td>
                            <td className="px-3 py-2.5">
                              <div className="flex gap-1">
                                {hasQuota && <span title="ResourceQuota" className="text-2xs font-semibold bg-success/10 text-success border border-success/20 px-1 py-0.5 rounded">QUO</span>}
                                {hasLR    && <span title="LimitRange" className="text-2xs font-semibold bg-brand-400/10 text-brand-400 border border-brand-400/20 px-1 py-0.5 rounded">LR</span>}
                                {hasNP    && <span title="NetworkPolicy" className="text-2xs font-semibold bg-purple-400/10 text-purple-400 border border-purple-400/20 px-1 py-0.5 rounded">NP</span>}
                                {!hasQuota && !hasLR && !hasNP && <span className="text-surface-600 text-2xs">?</span>}
                              </div>
                            </td>
                            <td className="px-3 py-2.5 text-surface-500 text-2xs tabular-nums">
                              {createdAgo === 0 ? 'today' : `${createdAgo}d`}
                            </td>
                            <td className="px-3 py-1.5" onClick={e => e.stopPropagation()}>
                              <div className="flex items-center gap-1">
                                <button onClick={() => setDescribeTarget({ kind: 'Namespace', namespace: '', name: ns.name })}
                                  className="p-1.5 rounded-lg text-surface-600 hover:text-amber-400 hover:bg-amber-400/10 transition-all" title="Describe">
                                  <FileSearch className="w-3.5 h-3.5" />
                                </button>
                                <button onClick={() => setYamlTarget({ kind: 'Namespace', namespace: '', name: ns.name })}
                                  className="p-1.5 rounded-lg text-surface-600 hover:text-brand-400 hover:bg-brand-400/10 transition-all" title="YAML">
                                  <FileCode2 className="w-3.5 h-3.5" />
                                </button>
                              </div>
                            </td>
                          </tr>
