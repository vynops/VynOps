function CrashFixModal({ pod, namespace, onClose, onLog }: {
  pod: string; namespace: string; onClose: () => void; onLog: () => void
}) {
  const [restarting, setRestarting] = useState(false)
  const [done, setDone] = useState(false)
  const [error, setError] = useState<string | null>(null)

  // Derive deployment name: strip last two hash segments (RS hash + pod hash)
  const deployName = pod.replace(/-[a-z0-9]{5}$/, '').replace(/-[a-z0-9]{9,10}$/, '')

  const doRestart = async () => {
    setRestarting(true); setError(null)
    const r = await fetch(
      `/api/k8s/deployments/${encodeURIComponent(namespace)}/${encodeURIComponent(deployName)}/restart`,
      { method: 'POST', headers: getClusterHeaders() }
    )
    const j = await r.json().catch(() => ({}))
    if (r.ok && j.ok !== false) { setDone(true) } else { setError(j.error ?? `HTTP ${r.status}`) }
    setRestarting(false)
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center">
      <div className="absolute inset-0 bg-black/60" onClick={onClose} />
      <div className="relative bg-surface-900 border border-danger/30 rounded-2xl p-6 w-96 shadow-2xl space-y-4">
        <div className="flex items-center gap-2">
          <div className="w-8 h-8 rounded-xl bg-danger/20 flex items-center justify-center flex-shrink-0">
            <Zap className="w-4 h-4 text-danger" />
          </div>
          <div>
            <h3 className="text-sm font-bold text-white">CrashLoopBackOff ? Quick Fix</h3>
            <p className="text-2xs text-surface-500 mt-0.5">Pod: <span className="font-mono text-surface-300">{pod}</span></p>
          </div>
          <button onClick={onClose} className="ml-auto text-surface-600 hover:text-white"><X className="w-4 h-4" /></button>
        </div>

        {!done ? (
          <>
            <div className="space-y-2 text-xs text-surface-400">
              <p>Detected deployment: <span className="font-mono text-brand-300">{deployName}</span></p>
              <p className="text-surface-500">A rolling restart will recycle all pods in the deployment. Check logs first if the root cause is unknown.</p>
            </div>
            <div className="flex gap-2">
              <button onClick={() => { onLog(); onClose() }}
                className="flex-1 flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs text-brand-400 bg-brand-500/10 hover:bg-brand-500/20 border border-brand-500/20 transition-all">
                <ScrollText className="w-3.5 h-3.5" /> View Logs
              </button>
              <button onClick={doRestart} disabled={restarting}
                className="flex-1 flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-white bg-danger/80 hover:bg-danger disabled:opacity-40 transition-all">
                {restarting ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <RotateCcw className="w-3.5 h-3.5" />}
                {restarting ? 'Restarting?' : 'Restart Deployment'}
              </button>
            </div>
            {error && <p className="text-xs text-danger bg-danger/10 px-3 py-2 rounded-xl">{error.includes('404') ? `Deployment "${deployName}" not found ? try restarting the pod directly.` : error}</p>}
          </>
        ) : (
          <div className="text-center space-y-3 py-2">
            <CheckCircle2 className="w-10 h-10 text-success mx-auto" />
            <p className="text-sm font-semibold text-white">Rolling restart triggered</p>
            <p className="text-xs text-surface-400">Pods will recycle shortly. Watch the pod list for status changes.</p>
            <button onClick={onClose} className="px-4 py-2 bg-surface-800 hover:bg-surface-700 rounded-xl text-xs text-white transition-all">Done</button>
          </div>
        )}
      </div>
    </div>
  )
}

