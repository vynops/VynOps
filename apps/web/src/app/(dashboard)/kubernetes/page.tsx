                <div key={i} className="bg-surface-800 rounded-lg px-3 py-2 flex items-center justify-between gap-2">
                  <span className="text-2xs font-mono text-surface-300 truncate">{m.mountPath}</span>
                  <div className="flex items-center gap-1.5 flex-shrink-0">
                    <span className="text-2xs text-surface-500">{m.name}</span>
                    {m.readOnly && <span className="text-2xs text-warning bg-warning/10 px-1 rounded">RO</span>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Env Vars */}
        {container.env.length > 0 && (
          <div>
            <div className="flex items-center justify-between mb-2">
              <h4 className="text-2xs font-semibold text-surface-400 uppercase tracking-wider flex items-center gap-1.5"><EyeOff className="w-3 h-3" />Env Vars ({container.env.length})</h4>
              <button onClick={() => setShowEnv(v => !v)} className="text-2xs text-brand-400 hover:text-brand-300">{showEnv ? 'Hide' : 'Show'}</button>
            </div>
            {showEnv && (
              <div className="space-y-1 max-h-[300px] overflow-y-auto">
                {container.env.map((e, i) => (
                  <div key={i} className="bg-surface-800 rounded-lg px-3 py-1.5 flex items-start justify-between gap-2">
                    <span className="text-2xs font-mono text-brand-300 flex-shrink-0">{e.name}</span>
