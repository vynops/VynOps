fix_*.mjs
fix-*.mjs
fix_*.js
fix-*.js
tmp_*.tsx
tmp_*.ts
audit.js
scan.js
check-anchors.js

# Deploy scripts — contain server IPs and key paths (keep locally only)
deploy_*.sh
deploy.ps1
github-ready.ps1
healthcheck.sh
scorecheck.sh
validate.ps1

